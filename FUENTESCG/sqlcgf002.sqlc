--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : SQLCGF002
-- Objeto    : SEGLIB.SG_TIEMPO_ANOS
-- Tipo      : Funcion de tabla SQL (Table Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 4
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Calcula la diferencia en anos cumplidos entre dos fechas.
--   Es la version Table Function de SG_TIEMPO_ANOS equivalente
--   al programa SG7006.
-- --------------------------------------------------------------
-- Parametros de entrada:
--   FechaDes  DATE  Fecha de inicio (desde).
--   FechaHas  DATE  Fecha de fin (hasta).
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   ANOS  INTEGER  Anos cumplidos (>= 0).
--         NULL     si alguno de los parametros es NULL.
--         0        si FechaHas < FechaDes.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   (ninguna - funcion de logica pura)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Calculo puro de anos entre fechas. No usa SegFec.
--   RETURNS NULL ON NULL INPUT.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Para anos+meses+dias usar SEGLIB.SG_TIEMPO_EXACTO.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, formato 80 cols
-- ==============================================================

CREATE OR REPLACE FUNCTION SEGLIB.SG_TIEMPO_ANOS (
  FechaDes DATE,
  FechaHas DATE
)
RETURNS TABLE (
  ANOS INTEGER
)
LANGUAGE SQL
DETERMINISTIC
NO EXTERNAL ACTION
RETURNS NULL ON NULL INPUT   -- Si cualquier parametro es NULL, retorna tabla vacia
BEGIN
  DECLARE vAnos INTEGER DEFAULT 0;

  -- Proteccion: si la fecha final es anterior a la inicial
  -- se devuelve 0 en lugar de un valor negativo silencioso.
  IF FechaHas < FechaDes THEN
    PIPE (0);
    RETURN;
  END IF;

  -- Diferencia base en anos de calendario
  SET vAnos = YEAR(FechaHas) - YEAR(FechaDes);

  -- Ajuste: si todavia no ha pasado el aniversario en el ano actual
  IF (MONTH(FechaHas) < MONTH(FechaDes))
     OR (MONTH(FechaHas) = MONTH(FechaDes) AND
         DAY(FechaHas) < DAY(FechaDes)) THEN
    SET vAnos = vAnos - 1;
  END IF;

  PIPE (vAnos);
  RETURN;
END;


GRANT EXECUTE ON FUNCTION SEGLIB.SG_TIEMPO_ANOS TO PUBLIC;
