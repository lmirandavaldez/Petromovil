-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : CG_PERIODO_POSTERIOR
-- Objeto    : SEGLIB.CG_PERIODO_POSTERIOR
-- Tipo      : Funcion SQL (Table Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Retorna el periodo contable inmediatamente posterior al
--   periodo indicado por los parametros p_perano y p_pernum.
-- --------------------------------------------------------------
-- Parametros de entrada:
--   p_perano  INTEGER  Anio del periodo de referencia
--   p_pernum  INTEGER  Numero del periodo de referencia
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   PERANO    INTEGER      Anio del periodo
--   PERNUM    INTEGER      Numero del periodo
--   PERDES    VARCHAR(15)  Descripcion del periodo
--   PERSIT    CHAR(1)      Situacion del periodo
--   PERFIP    DATE         Fecha inicial del periodo
--   PERFFP    DATE         Fecha final del periodo
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   COGPER   Periodos contables
--   SEGFEC   Tabla maestra de fechas (LEFT JOIN para validacion)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Se construye la fecha inicial (PERFIP) y final (PERFFP)
--   concatenando los campos de anio, mes y dia de COGPER.
--   Se realiza LEFT JOIN a SEGFEC para validar que la fecha
--   exista. Si no existe en SEGFEC se retorna '2039-12-31'
--   como valor por defecto.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Almacenar fechas directamente como DATE en COGPER para
--      evitar la construccion dinamica con TIMESTAMP_FORMAT.
--   2. Agregar indice en COGPER (PERANO, PERNUM) para mejorar
--      el rendimiento del filtrado y ordenamiento.
--   3. Validar que p_perano y p_pernum sean valores positivos
--      antes de ejecutar la consulta.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2025-07-10  L. Miranda  Documentacion y mejoras de formato
--                           LEFT JOIN a SEGFEC para fechas
--                           Coalesce en lugar de Ifnull
-- ==============================================================

--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);

CREATE OR REPLACE FUNCTION SEGLIB.CG_PERIODO_POSTERIOR (
  p_perano INTEGER,
  p_pernum INTEGER
)
RETURNS TABLE (
  PERANO  INTEGER,
  PERNUM  INTEGER,
  PERDES  VARCHAR(15),
  PERSIT  CHAR(1),
  PERFIP  DATE,
  PERFFP  DATE
)
LANGUAGE SQL
READS SQL DATA
RETURN
SELECT
  p.PERANO,
  p.PERNUM,
  p.PERDES,
  p.PERSIT,

  -- Fecha inicial del periodo contable
  COALESCE(
    fi.FECISO,
    DATE('2039-12-31')
  ) AS PERFIP,

  -- Fecha final del periodo contable
  COALESCE(
    ff.FECISO,
    DATE('2039-12-31')
  ) AS PERFFP

FROM (
    SELECT *
      FROM COGPER
     WHERE (INTEGER(PERANO) > p_perano)
        OR (INTEGER(PERANO) = p_perano
       AND  INTEGER(PERNUM) > p_pernum)
     ORDER BY INTEGER(PERANO) ASC,
              INTEGER(PERNUM) ASC
     FETCH FIRST 1 ROW ONLY
) AS p

-- Resolucion fecha inicial via SEGFEC
LEFT JOIN SEGFEC fi
  ON  fi.FECISO = DATE(
        TIMESTAMP_FORMAT(
          VARCHAR(p.PerAin) CONCAT '-'  CONCAT
          VARCHAR_FORMAT(p.PerMin, '00') CONCAT '-' CONCAT
          VARCHAR_FORMAT(p.PerDin, '00'),
          'YYYY-MM-DD'
        )
      )

-- Resolucion fecha final via SEGFEC
LEFT JOIN SEGFEC ff
  ON  ff.FECISO = LAST_DAY(
        DATE(
          TIMESTAMP_FORMAT(
            VARCHAR(p.PerAfi) CONCAT '-'  CONCAT
            VARCHAR_FORMAT(p.PerMfi, '00') CONCAT '-' CONCAT
            VARCHAR_FORMAT(p.PerDfi, '00'),
            'YYYY-MM-DD'
          )
        )
      );


GRANT EXECUTE ON FUNCTION SEGLIB.CG_PERIODO_POSTERIOR TO PUBLIC;
