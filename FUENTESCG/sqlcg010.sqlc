-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : SQLCG010
-- Objeto    : VWCOG_Diario_General_3
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Detalle del diario general completo: una fila por linea
--   de asiento contable.
--   Extiende VWCOG_Diario_General_2 (sqlcg009) con:
--     - TdiCve y DgeDoc explícitos sin formatear.
--     - DgeSec: secuencia de la linea del asiento.
--     - Fecha_Aplicacion: AplAno+AplMes+AplDia de CogHdgh
--       resuelta via SegFec T11.
--     - AplUsr y UsrNom: usuario que aplico el asiento
--       (de CogHdgh y SegUsr).
--   CogHdgh es Left Outer Join (asientos pueden no tener
--   encabezado registrado).
--   Separa el valor en Debito o Credito segun DgeOri
--   (1=Debito, 2=Credito).
--   No aplica agrupacion; devuelve el detalle puro.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   PerAno            Ano contable del periodo       (CogHdgd)
--   PerNum            Numero del periodo (1..12)     (CogHdgd)
--   PerDes            Descripcion del periodo        (CogPer)
--   TdiDes            Tipo de documento contable     (CogTdi)
--   TdiCve            Clave del tipo de documento    (CogHdgd)
--   DgeDoc            Numero del documento           (CogHdgd)
--   Fecha_Documento   Fecha ISO del documento        (SegFec)
--   Fecha_Aplicacion  Fecha ISO de aplicacion        (SegFec)
--   DgeDes            Descripcion del encabezado     (CogHdgh)
--   DgeSec            Secuencia de la linea          (CogHdgd)
--   CtaCve            Clave de la cuenta contable    (CogHdgd)
--   AuxCve            Clave del auxiliar             (CogHdgd)
--   Descripcion       Nombre de cuenta o auxiliar    (calc)
--   CcoCve            Clave del centro de costo      (CogHdgd)
--   CcoDes            Descripcion del CCO            (CogCco)
--   DgeDe1            Descripcion libre del asiento  (CogHdgd)
--   Debito            Valor si DgeOri=1, sino 0      (calc)
--   Credito           Valor si DgeOri=2, sino 0      (calc)
--   CfaCve            Clave de forma de pago CxP     (CogHdgd)
--   CfaDes            Descripcion de forma de pago   (CxpCfa)
--   DgeTid            Tipo de identificacion fiscal  (CogHdgd)
--   DgeIde            Numero de identificacion fiscal(CogHdgd)
--   NcfNro            Numero de comprobante fiscal   (CogHdgd)
--   AplUsr            Usuario que aplico el asiento  (CogHdgh)
--   UsrNom            Nombre del usuario             (SegUsr)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CogHdgd   T1   Lineas del diario general (tabla base)
--   CogTdi    T2   Tipos de documento contable
--   CogPer    T3   Periodos contables
--   CogCta    T4   Catalogo de cuentas
--   CogAuxd   T5   Catalogo de auxiliares
--   CogCco    T6   Catalogo de centros de costo
--   CxpCfa    T7   Clasificacion de formas de pago (CxP)
--   CogHdgh   T8   Encabezado del diario general
--   SegUsr    T9   Usuarios del sistema
--   SegFec    T10  Fecha del documento (DgeAno/Mes/Dia)
--   SegFec    T11  Fecha de aplicacion (AplAno/Mes/Dia)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Fecha_Documento: Left Outer Join a SegFec T10 por
--   DgeAno+DgeMes+DgeDia -> FecIso.
--   Fecha_Aplicacion: Left Outer Join a SegFec T11 por
--   AplAno+AplMes+AplDia de CogHdgh -> FecIso.
--   Ambos son Left Outer Join para tolerar fechas
--   ausentes del calendario sin perder filas.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Agregar columna Numero_Documento formateado
--      (TdiCve-NNNNNNN) para consistencia con sqlcg008/009.
--   2. Evaluar indice por PerAno+PerNum+TdiCve+DgeDoc
--      para mejorar rendimiento en consultas frecuentes.
--   3. Documentar explicitamente que DgeDes puede ser NULL
--      cuando el asiento no tiene encabezado en CogHdgh.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           IfNull -> Coalesce, sin acentos
-- ==============================================================

Create Or Replace View VWCOG_Diario_General_3 As

Select
    -- --------------------------------------------------------
    -- Identificacion del periodo
    -- --------------------------------------------------------
    T1.PerAno                              As PerAno,
    -- Ano contable del periodo

    T1.PerNum                              As PerNum,
    -- Numero del periodo (1..12)

    T3.PerDes                              As PerDes,
    -- Descripcion del periodo

    -- --------------------------------------------------------
    -- Tipo y numero de documento
    -- --------------------------------------------------------
    T2.TdiDes                              As TdiDes,
    -- Descripcion del tipo de documento contable

    T1.TdiCve                              As TdiCve,
    -- Clave del tipo de documento

    T1.DgeDoc                              As DgeDoc,
    -- Numero del documento (sin formatear)

    -- --------------------------------------------------------
    -- Fechas del documento
    -- --------------------------------------------------------
    T10.FecIso                             As Fecha_Documento,
    -- Fecha del documento (ISO) desde SegFec
    -- Resuelve DgeAno+DgeMes+DgeDia de la linea

    T11.FecIso                             As Fecha_Aplicacion,
    -- Fecha de aplicacion (ISO) desde SegFec
    -- Resuelve AplAno+AplMes+AplDia del encabezado CogHdgh
    -- NULL si el encabezado no tiene fecha de aplicacion

    -- --------------------------------------------------------
    -- Descripcion del encabezado del documento
    -- --------------------------------------------------------
    T8.DgeDes                              As DgeDes,
    -- Descripcion general del asiento (de CogHdgh)
    -- NULL si el documento no tiene encabezado

    -- --------------------------------------------------------
    -- Linea del asiento
    -- --------------------------------------------------------
    T1.DgeSec                              As DgeSec,
    -- Numero de secuencia dentro del documento

    T1.CtaCve                              As CtaCve,
    -- Clave de la cuenta contable

    T1.AuxCve                              As AuxCve,
    -- Clave del auxiliar; 0 = sin auxiliar

    -- Descripcion: nombre de cuenta o de auxiliar segun caso
    (Case When T1.AuxCve = 0
     Then T4.CtaDes
     Else T5.AuxNom
     End)                                  As Descripcion,

    T1.CcoCve                              As CcoCve,
    -- Clave del centro de costo

    T6.CcoDes                              As CcoDes,
    -- Descripcion del centro de costo

    T1.DgeDe1                              As DgeDe1,
    -- Descripcion libre de la linea del asiento

    -- --------------------------------------------------------
    -- Valor separado por orientacion (DgeOri)
    -- 1 = Debito   2 = Credito
    -- --------------------------------------------------------
    (Case When T1.DgeOri = 1
     Then T1.DgeVal
     Else 0
     End)                                  As Debito,

    (Case When T1.DgeOri = 2
     Then T1.DgeVal
     Else 0
     End)                                  As Credito,

    -- --------------------------------------------------------
    -- Clasificacion de forma de pago (CxP)
    -- --------------------------------------------------------
    T1.CfaCve                              As CfaCve,
    -- Clave de la clasificacion de forma de pago

    T7.CfaDes                              As CfaDes,
    -- Descripcion de la clasificacion de forma de pago

    -- --------------------------------------------------------
    -- Campos adicionales de identificacion fiscal
    -- --------------------------------------------------------
    T1.DgeTid                              As DgeTid,
    -- Tipo de identificacion fiscal

    T1.DgeIde                              As DgeIde,
    -- Numero de identificacion fiscal

    T1.NcfNro                              As NcfNro,
    -- Numero de comprobante fiscal (NCF)

    -- --------------------------------------------------------
    -- Usuario que aplico el asiento (del encabezado CogHdgh)
    -- --------------------------------------------------------
    T8.AplUsr                              As AplUsr,
    -- Clave del usuario que aplico el documento

    T9.UsrNom                              As UsrNom
    -- Nombre del usuario que aplico el documento

-- ============================================================
-- FROM y JOINs
-- ============================================================
From CogHdgd As T1

-- Tipo de documento contable
Join CogTdi As T2
    On T1.TdiCve = T2.TdiCve

-- Periodo contable: descripcion del periodo
Join CogPer As T3
    On  T1.PerAno = T3.PerAno
    And T1.PerNum = T3.PerNum

-- Catalogo de cuentas: descripcion de la cuenta
Join CogCta As T4
    On T1.CtaCve = T4.CtaCve

-- Auxiliares: LEFT porque no toda linea tiene auxiliar
Left Outer Join CogAuxd As T5
    On  T1.AuxLis = T5.AuxLis
    And T1.AuxCve = T5.AuxCve

-- Centro de costo: LEFT porque no toda linea tiene CCO
Left Outer Join CogCco As T6
    On T1.CcoCve = T6.CcoCve

-- Forma de pago CxP: LEFT porque no toda linea tiene CfaCve
Left Outer Join CxpCfa As T7
    On T1.CfaCve = T7.CfaCve

-- Encabezado: LEFT porque asientos pueden no tener encabezado
Left Outer Join CogHdgh As T8
    On  T1.TdiCve = T8.TdiCve
    And T1.PerAno = T8.PerAno
    And T1.PerNum = T8.PerNum
    And T1.DgeDoc = T8.DgeDoc

-- Usuario que aplico: LEFT porque T8 puede ser NULL
Left Outer Join SegUsr As T9
    On T8.AplUsr = T9.UsrCve

-- Fecha del documento: LEFT para tolerar fechas no registradas
Left Outer Join SegFec As T10
    On  T1.DgeAno = T10.FecAno
    And T1.DgeMes = T10.FecMes
    And T1.DgeDia = T10.FecDia

-- Fecha de aplicacion: LEFT porque T8 puede ser NULL y la
-- fecha de aplicacion puede no estar en SegFec
Left Outer Join SegFec As T11
    On  T8.AplAno = T11.FecAno
    And T8.AplMes = T11.FecMes
    And T8.AplDia = T11.FecDia

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PerAno, T1.PerNum, T1.TdiCve, T1.DgeDoc,
--          T1.DgeSec
