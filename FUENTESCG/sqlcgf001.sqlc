--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : COG - Contabilidad General
-- Programa  : sqlcgf001
-- Objeto    : SEGLIB.CG_PERIODO_ANTERIOR
-- Tipo      : Funcion SQL (Table Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Retorna los datos del periodo contable inmediatamente
--   anterior al periodo indicado por los parametros p_perano
--   y p_pernum. Devuelve una fila si existe un periodo
--   anterior, o ninguna fila si es el primero registrado.
-- --------------------------------------------------------------
-- Parametros de entrada:
--   p_perano  INTEGER  Ano  del periodo de referencia (ej: 2026)
--   p_pernum  INTEGER  Numero del periodo de referencia (ej: 6)
-- --------------------------------------------------------------
-- Campos retornados:
--   PERANO   INTEGER      Ano del periodo anterior
--   PERNUM   INTEGER      Numero del periodo anterior
--   PERDES   VARCHAR(15)  Descripcion del periodo
--   PERSIT   CHAR(1)      Situacion del periodo
--   PERFIP   DATE         Fecha inicial del periodo
--   PERFFP   DATE         Fecha final del periodo
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CogPer (COGPER)       Periodos contables
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   PERFIP: construida con TIMESTAMP_FORMAT sobre
--     PerAin/PerMin/PerDin (ano/mes/dia inicio).
--   PERFFP: construida con LAST_DAY sobre TIMESTAMP_FORMAT de
--     PerAfi/PerMfi/PerDfi (ano/mes/dia fin). LAST_DAY
--     garantiza el ultimo dia del mes aunque PerDfi no sea
--     correcto.
--   No usa SegFec. Las fechas se calculan directamente desde
--   los campos de CogPer con TIMESTAMP_FORMAT + LAST_DAY.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Eliminar caracteres especiales en comentarios para
--      compatibilidad con encodings EBCDIC/ASCII del IBM i.
--   2. Agregar parametro de validacion para rechazar periodos
--      negativos o fuera de rango.
--   3. Evaluar si LAST_DAY es necesario o si PerDfi siempre
--      almacena el dia correcto para reducir complejidad.
-- --------------------------------------------------------------
-- Uso:
--   SELECT * FROM TABLE(SEGLIB.CG_PERIODO_ANTERIOR(2026, 6));
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion, eliminacion de
--                           caracteres especiales en comentarios
-- ==============================================================

CREATE OR REPLACE FUNCTION SEGLIB.CG_PERIODO_ANTERIOR (
    p_perano INTEGER,
    p_pernum INTEGER
)
RETURNS TABLE (
    PERANO  INTEGER,
    PERNUM  INTEGER,
    PERDES  VARCHAR(15),
    PERSIT  CHAR(1),
    PERFIP  DATE,
    PERFFP  DATE
)
LANGUAGE SQL
READS SQL DATA
RETURN
    SELECT
        INTEGER(ant.PERANO)                         AS PERANO,
        INTEGER(ant.PERNUM)                         AS PERNUM,
        ant.PERDES,
        ant.PERSIT,

        /* Fecha inicial del periodo contable */
        DATE(
            TIMESTAMP_FORMAT(
                VARCHAR(ant.PerAin) CONCAT '-' CONCAT
                VARCHAR_FORMAT(ant.PerMin, '00') CONCAT '-' CONCAT
                VARCHAR_FORMAT(ant.PerDin, '00'),
                'YYYY-MM-DD'
            )
        ) AS PERFIP,

        /* Fecha final del periodo contable.
           LAST_DAY garantiza el ultimo dia del mes incluso si
           PerDfi no almacena el valor correcto. */
        LAST_DAY(
            DATE(
                TIMESTAMP_FORMAT(
                    VARCHAR(ant.PerAfi) CONCAT '-' CONCAT
                    VARCHAR_FORMAT(ant.PerMfi, '00') CONCAT '-' CONCAT
                    VARCHAR_FORMAT(ant.PerDfi, '00'),
                    'YYYY-MM-DD'
                )
            )
        ) AS PERFFP

    FROM (
        SELECT
            PERANO, PERNUM, PERDES, PERSIT,
            PerAin, PerMin, PerDin,
            PerAfi, PerMfi, PerDfi
        FROM COGPER
        WHERE
            INTEGER(PERANO) < p_perano
            OR (INTEGER(PERANO) = p_perano
                AND INTEGER(PERNUM) < p_pernum)
        ORDER BY
            INTEGER(PERANO) DESC,
            INTEGER(PERNUM) DESC
        FETCH FIRST 1 ROW ONLY
    ) AS ant;


GRANT EXECUTE ON FUNCTION SEGLIB.CG_PERIODO_ANTERIOR TO PUBLIC;
