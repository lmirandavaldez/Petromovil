-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : SQLCG007
-- Objeto    : VWCOG_Saldos_Cuentas_CentroCosto
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Saldos del balance por cuenta contable y centro de
--   costo, por ano y numero de periodo.
--   Por cada combinacion devuelve el balance inicial,
--   debitos, creditos y balance final.
--   Excluye registros con cuenta en blanco
--   (CtaCve = '    ').
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   PerAno              Ano contable del periodo      (CogBcc)
--   PerNum              Numero del periodo (1..12)    (CogBcc)
--   CtaCve              Clave de la cuenta contable   (CogBcc)
--   CcoCve              Clave del centro de costo     (CogBcc)
--   Balance_Inicial_Bcc Saldo inicial del periodo     (CogBcc)
--   Debitos_Bcc         Total de debitos del periodo  (CogBcc)
--   Creditos_Bcc        Total de creditos del periodo (CogBcc)
--   Balance_Final_Bcc   Saldo final del periodo       (CogBcc)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CogBcc    T1  Balance por cuenta y centro de costo
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   No aplica. Esta vista no maneja fechas calendario.
--   PerAno y PerNum identifican el periodo contable.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Agregar JOIN a CogCco para incluir CcoDes (nombre
--      del centro de costo) directamente en la vista.
--   2. Agregar JOIN a CogCta para incluir CtaDes (nombre
--      de la cuenta) directamente en la vista.
--   3. Evaluar si el filtro CtaCve <> '    ' debe usar
--      Trim() para cubrir variantes con distintos espacios.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           IfNull -> Coalesce, sin acentos
-- ==============================================================

Create Or Replace View VWCOG_Saldos_Cuentas_CentroCosto As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T1.PerAno                              As PerAno,
    -- Ano contable del periodo

    T1.PerNum                              As PerNum,
    -- Numero del periodo (1..12)

    T1.CtaCve                              As CtaCve,
    -- Clave de la cuenta contable

    T1.CcoCve                              As CcoCve,
    -- Clave del centro de costo

    -- --------------------------------------------------------
    -- Metricas del periodo por centro de costo
    -- --------------------------------------------------------
    Coalesce(Sum(T1.BccBip), 0)             As Balance_Inicial_Bcc,
    -- Saldo inicial del periodo

    Coalesce(Sum(T1.BccDeb), 0)             As Debitos_Bcc,
    -- Total de debitos del periodo

    Coalesce(Sum(T1.BccCre), 0)             As Creditos_Bcc,
    -- Total de creditos del periodo

    Coalesce(Sum(T1.BccBal), 0)             As Balance_Final_Bcc
    -- Saldo final del periodo

-- ============================================================
-- FROM
-- ============================================================
From CogBcc As T1

-- ============================================================
-- Filtro: excluye cuentas en blanco
-- ============================================================
Where T1.CtaCve <> '    '

-- ============================================================
-- GROUP BY: todas las dimensiones no agregadas del SELECT
-- ============================================================
Group By
    T1.PerAno,
    T1.PerNum,
    T1.CtaCve,
    T1.CcoCve

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PerAno, T1.PerNum, T1.CtaCve, T1.CcoCve
