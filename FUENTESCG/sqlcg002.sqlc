-- ============================================================
-- Vista     : VWCOG_MAYOR_GENERALCCO_MESES
-- Modulo    : Contabilidad General
-- Objeto    : Pivot del mayor general por centro de costo,
--             cuenta contable, auxiliar y periodo (ano),
--             desplegando por cada mes el movimiento neto
--             (Debito - Credito) y el saldo acumulado (Balance).
--             Tipo_Cuenta distingue cuentas de mayor puras
--             (CtaTip=1 sin auxiliar) de las demas.
--             Descripcion muestra el nombre de la cuenta o
--             del auxiliar segun corresponda.
--             Solo incluye periodos cerrados (PerSit = 'C').
-- Tablas    : CogBcc    balance por cuenta y centro de costo
--             CogPer    periodos contables
--             CogCta    catalogo de cuentas
--             CogAuxd   catalogo de auxiliares
--             CogCco    catalogo de centros de costo
-- Esquema   : (default)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2  (mejorada)
-- Cambios   :
--   v2 - Se agrega cabecera de documentacion completa.
--        Se agrega alias explicito As en FROM y JOINs.
--        Se reformatea SELECT con una columna por linea
--          y comentario descriptivo en cada campo.
--        Se reformatea el pivot mensual alineando el alias
--          As en la misma linea de la expresion.
--        Se reformatea GROUP BY con una expresion por linea.
--        Se agrega ORDER BY sugerido (comentado).
--        Se respeta el orden original de los campos,
--          la logica original y el limite de 80 posiciones.
-- ============================================================

Create Or Replace View VWCOG_MAYOR_GENERALCCO_MESES As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T1.PerAno                              As PerAno,
    -- Ano contable del periodo

    T1.CcoCve                              As CcoCve,
    -- Clave del centro de costo

    T5.CcoDes                              As CcoDes,
    -- Descripcion del centro de costo

    T1.CtaCve                              As CtaCve,
    -- Clave de la cuenta contable

    T1.AuxLis                              As AuxLis,
    -- Lista (tipo) del auxiliar; 0 = sin auxiliar

    T1.AuxCve                              As AuxCve,
    -- Clave del auxiliar; 0 = sin auxiliar

    -- Tipo_Cuenta:
    --   1 = cuenta de mayor pura (CtaTip=1, sin auxiliar)
    --   2 = cuenta con auxiliar o de otro tipo
    (Case When T3.CtaTip = 1
          And  T1.AuxLis = 0
          And  T1.AuxCve = 0
     Then 1
     Else 2
     End)                                  As Tipo_Cuenta,

    -- Descripcion: nombre de cuenta o de auxiliar segun caso
    (Case When T1.AuxCve = 0
     Then T3.CtaDes
     Else T4.AuxNom
     End)                                  As Descripcion,

    -- --------------------------------------------------------
    -- Pivot mensual: Movimiento neto y Balance por mes
    -- Movimiento = Debito - Credito del periodo
    -- Balance    = Saldo acumulado del periodo
    -- --------------------------------------------------------
    IfNull(Sum(Case When T1.PerNum = 01
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Ene,
    IfNull(Sum(Case When T1.PerNum = 01
               Then T1.BccBal
               End), 0)                    As Balance_Ene,

    IfNull(Sum(Case When T1.PerNum = 02
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Feb,
    IfNull(Sum(Case When T1.PerNum = 02
               Then T1.BccBal
               End), 0)                    As Balance_Feb,

    IfNull(Sum(Case When T1.PerNum = 03
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Mar,
    IfNull(Sum(Case When T1.PerNum = 03
               Then T1.BccBal
               End), 0)                    As Balance_Mar,

    IfNull(Sum(Case When T1.PerNum = 04
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Abr,
    IfNull(Sum(Case When T1.PerNum = 04
               Then T1.BccBal
               End), 0)                    As Balance_Abr,

    IfNull(Sum(Case When T1.PerNum = 05
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_May,
    IfNull(Sum(Case When T1.PerNum = 05
               Then T1.BccBal
               End), 0)                    As Balance_May,

    IfNull(Sum(Case When T1.PerNum = 06
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Jun,
    IfNull(Sum(Case When T1.PerNum = 06
               Then T1.BccBal
               End), 0)                    As Balance_Jun,

    IfNull(Sum(Case When T1.PerNum = 07
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Jul,
    IfNull(Sum(Case When T1.PerNum = 07
               Then T1.BccBal
               End), 0)                    As Balance_Jul,

    IfNull(Sum(Case When T1.PerNum = 08
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Ago,
    IfNull(Sum(Case When T1.PerNum = 08
               Then T1.BccBal
               End), 0)                    As Balance_Ago,

    IfNull(Sum(Case When T1.PerNum = 09
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Sep,
    IfNull(Sum(Case When T1.PerNum = 09
               Then T1.BccBal
               End), 0)                    As Balance_Sep,

    IfNull(Sum(Case When T1.PerNum = 10
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Oct,
    IfNull(Sum(Case When T1.PerNum = 10
               Then T1.BccBal
               End), 0)                    As Balance_Oct,

    IfNull(Sum(Case When T1.PerNum = 11
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Nov,
    IfNull(Sum(Case When T1.PerNum = 11
               Then T1.BccBal
               End), 0)                    As Balance_Nov,

    IfNull(Sum(Case When T1.PerNum = 12
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Dic,
    IfNull(Sum(Case When T1.PerNum = 12
               Then T1.BccBal
               End), 0)                    As Balance_Dic

-- ============================================================
-- FROM y JOINs
-- ============================================================
From CogBcc As T1

-- Periodo contable: filtra solo periodos cerrados (PerSit='C')
Join CogPer As T2
    On  T1.PerAno = T2.PerAno
    And T1.PerNum = T2.PerNum

-- Catalogo de cuentas: LEFT porque BccCve puede no tener cuenta
Left Outer Join CogCta As T3
    On T1.CtaCve = T3.CtaCve

-- Auxiliares: LEFT porque no toda cuenta tiene auxiliar
Left Outer Join CogAuxd As T4
    On  T1.AuxLis = T4.AuxLis
    And T1.AuxCve = T4.AuxCve

-- Centro de costo: descripcion del CCO
Join CogCco As T5
    On T1.CcoCve = T5.CcoCve

-- ============================================================
-- Filtro: solo periodos cerrados
-- ============================================================
Where T2.PerSit = 'C'

-- ============================================================
-- GROUP BY: todas las dimensiones no agregadas del SELECT
-- ============================================================
Group By
    T1.PerAno,
    T1.CcoCve,
    T5.CcoDes,
    T1.CtaCve,
    T1.AuxLis,
    T1.AuxCve,
    (Case When T3.CtaTip = 1
          And  T1.AuxLis = 0
          And  T1.AuxCve = 0
     Then 1
     Else 2
     End),
    (Case When T1.AuxCve = 0
     Then T3.CtaDes
     Else T4.AuxNom
     End)

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PerAno, T1.CcoCve, T1.CtaCve, T1.AuxLis, T1.AuxCve
