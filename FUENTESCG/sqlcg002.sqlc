-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : SQLCG002
-- Objeto    : VWCOG_MAYOR_GENERALCCO_MESES
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Pivot mensual del mayor general por centro de costo,
--   cuenta contable, auxiliar y ano contable.
--   Por cada combinacion despliega el movimiento neto
--   (Debito - Credito) y el saldo acumulado (Balance)
--   de cada uno de los 12 meses del ano.
--   Tipo_Cuenta distingue cuentas de mayor puras
--   (CtaTip=1 sin auxiliar) de las demas.
--   Descripcion muestra el nombre de la cuenta o del
--   auxiliar segun corresponda.
--   Solo incluye periodos cerrados (PerSit = 'C').
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   PerAno          Ano contable del periodo        (CogBcc)
--   CcoCve          Clave del centro de costo       (CogBcc)
--   CcoDes          Descripcion del centro de costo (CogCco)
--   CtaCve          Clave de la cuenta contable     (CogBcc)
--   AuxLis          Lista (tipo) del auxiliar       (CogBcc)
--   AuxCve          Clave del auxiliar              (CogBcc)
--   Tipo_Cuenta     1=mayor pura, 2=con auxiliar    (calc)
--   Descripcion     Nombre de cuenta o auxiliar     (calc)
--   Movimiento_Ene  Movimiento neto enero           (calc)
--   Balance_Ene     Saldo acumulado enero           (calc)
--   Movimiento_Feb  Movimiento neto febrero         (calc)
--   Balance_Feb     Saldo acumulado febrero         (calc)
--   Movimiento_Mar  Movimiento neto marzo           (calc)
--   Balance_Mar     Saldo acumulado marzo           (calc)
--   Movimiento_Abr  Movimiento neto abril           (calc)
--   Balance_Abr     Saldo acumulado abril           (calc)
--   Movimiento_May  Movimiento neto mayo            (calc)
--   Balance_May     Saldo acumulado mayo            (calc)
--   Movimiento_Jun  Movimiento neto junio           (calc)
--   Balance_Jun     Saldo acumulado junio           (calc)
--   Movimiento_Jul  Movimiento neto julio           (calc)
--   Balance_Jul     Saldo acumulado julio           (calc)
--   Movimiento_Ago  Movimiento neto agosto          (calc)
--   Balance_Ago     Saldo acumulado agosto          (calc)
--   Movimiento_Sep  Movimiento neto septiembre      (calc)
--   Balance_Sep     Saldo acumulado septiembre      (calc)
--   Movimiento_Oct  Movimiento neto octubre         (calc)
--   Balance_Oct     Saldo acumulado octubre         (calc)
--   Movimiento_Nov  Movimiento neto noviembre       (calc)
--   Balance_Nov     Saldo acumulado noviembre       (calc)
--   Movimiento_Dic  Movimiento neto diciembre       (calc)
--   Balance_Dic     Saldo acumulado diciembre       (calc)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CogBcc    T1  Balance por cuenta y centro de costo
--   CogPer    T2  Periodos contables
--   CogCta    T3  Catalogo de cuentas
--   CogAuxd   T4  Catalogo de auxiliares
--   CogCco    T5  Catalogo de centros de costo
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Filtra por T2.PerSit = 'C' (periodos cerrados).
--   PerAno y PerNum identifican el periodo contable.
--   El pivot agrupa por PerAno y distribuye los valores
--   en columnas segun PerNum (01..12).
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Agregar columna TotalAnual calculada como suma de
--      los 12 movimientos mensuales para facilitar reportes.
--   2. Incluir periodos abiertos (PerSit = 'A') como opcion
--      mediante parametro o vista adicional.
--   3. Normalizar nombre del objeto a mayusculas consistentes.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           IfNull -> Coalesce, sin acentos
-- ==============================================================

Create Or Replace View VWCOG_MAYOR_GENERALCCO_MESES As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T1.PerAno                              As PerAno,
    -- Ano contable del periodo

    T1.CcoCve                              As CcoCve,
    -- Clave del centro de costo

    T5.CcoDes                              As CcoDes,
    -- Descripcion del centro de costo

    T1.CtaCve                              As CtaCve,
    -- Clave de la cuenta contable

    T1.AuxLis                              As AuxLis,
    -- Lista (tipo) del auxiliar; 0 = sin auxiliar

    T1.AuxCve                              As AuxCve,
    -- Clave del auxiliar; 0 = sin auxiliar

    -- Tipo_Cuenta:
    --   1 = cuenta de mayor pura (CtaTip=1, sin auxiliar)
    --   2 = cuenta con auxiliar o de otro tipo
    (Case When T3.CtaTip = 1
          And  T1.AuxLis = 0
          And  T1.AuxCve = 0
     Then 1
     Else 2
     End)                                  As Tipo_Cuenta,

    -- Descripcion: nombre de cuenta o de auxiliar segun caso
    (Case When T1.AuxCve = 0
     Then T3.CtaDes
     Else T4.AuxNom
     End)                                  As Descripcion,

    -- --------------------------------------------------------
    -- Pivot mensual: Movimiento neto y Balance por mes
    -- Movimiento = Debito - Credito del periodo
    -- Balance    = Saldo acumulado del periodo
    -- --------------------------------------------------------
    Coalesce(Sum(Case When T1.PerNum = 01
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Ene,
    Coalesce(Sum(Case When T1.PerNum = 01
               Then T1.BccBal
               End), 0)                    As Balance_Ene,

    Coalesce(Sum(Case When T1.PerNum = 02
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Feb,
    Coalesce(Sum(Case When T1.PerNum = 02
               Then T1.BccBal
               End), 0)                    As Balance_Feb,

    Coalesce(Sum(Case When T1.PerNum = 03
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Mar,
    Coalesce(Sum(Case When T1.PerNum = 03
               Then T1.BccBal
               End), 0)                    As Balance_Mar,

    Coalesce(Sum(Case When T1.PerNum = 04
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Abr,
    Coalesce(Sum(Case When T1.PerNum = 04
               Then T1.BccBal
               End), 0)                    As Balance_Abr,

    Coalesce(Sum(Case When T1.PerNum = 05
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_May,
    Coalesce(Sum(Case When T1.PerNum = 05
               Then T1.BccBal
               End), 0)                    As Balance_May,

    Coalesce(Sum(Case When T1.PerNum = 06
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Jun,
    Coalesce(Sum(Case When T1.PerNum = 06
               Then T1.BccBal
               End), 0)                    As Balance_Jun,

    Coalesce(Sum(Case When T1.PerNum = 07
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Jul,
    Coalesce(Sum(Case When T1.PerNum = 07
               Then T1.BccBal
               End), 0)                    As Balance_Jul,

    Coalesce(Sum(Case When T1.PerNum = 08
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Ago,
    Coalesce(Sum(Case When T1.PerNum = 08
               Then T1.BccBal
               End), 0)                    As Balance_Ago,

    Coalesce(Sum(Case When T1.PerNum = 09
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Sep,
    Coalesce(Sum(Case When T1.PerNum = 09
               Then T1.BccBal
               End), 0)                    As Balance_Sep,

    Coalesce(Sum(Case When T1.PerNum = 10
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Oct,
    Coalesce(Sum(Case When T1.PerNum = 10
               Then T1.BccBal
               End), 0)                    As Balance_Oct,

    Coalesce(Sum(Case When T1.PerNum = 11
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Nov,
    Coalesce(Sum(Case When T1.PerNum = 11
               Then T1.BccBal
               End), 0)                    As Balance_Nov,

    Coalesce(Sum(Case When T1.PerNum = 12
               Then (T1.BccDeb - T1.BccCre)
               End), 0)                    As Movimiento_Dic,
    Coalesce(Sum(Case When T1.PerNum = 12
               Then T1.BccBal
               End), 0)                    As Balance_Dic

-- ============================================================
-- FROM y JOINs
-- ============================================================
From CogBcc As T1

-- Periodo contable: filtra solo periodos cerrados (PerSit='C')
Join CogPer As T2
    On  T1.PerAno = T2.PerAno
    And T1.PerNum = T2.PerNum

-- Catalogo de cuentas: LEFT porque BccCve puede no tener cuenta
Left Outer Join CogCta As T3
    On T1.CtaCve = T3.CtaCve

-- Auxiliares: LEFT porque no toda cuenta tiene auxiliar
Left Outer Join CogAuxd As T4
    On  T1.AuxLis = T4.AuxLis
    And T1.AuxCve = T4.AuxCve

-- Centro de costo: descripcion del CCO
Join CogCco As T5
    On T1.CcoCve = T5.CcoCve

-- ============================================================
-- Filtro: solo periodos cerrados
-- ============================================================
Where T2.PerSit = 'C'

-- ============================================================
-- GROUP BY: todas las dimensiones no agregadas del SELECT
-- ============================================================
Group By
    T1.PerAno,
    T1.CcoCve,
    T5.CcoDes,
    T1.CtaCve,
    T1.AuxLis,
    T1.AuxCve,
    (Case When T3.CtaTip = 1
          And  T1.AuxLis = 0
          And  T1.AuxCve = 0
     Then 1
     Else 2
     End),
    (Case When T1.AuxCve = 0
     Then T3.CtaDes
     Else T4.AuxNom
     End)

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PerAno, T1.CcoCve, T1.CtaCve, T1.AuxLis, T1.AuxCve
