-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : SQLCG009
-- Objeto    : VWCOG_Diario_General_2
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Detalle del diario general extendido: una fila por
--   linea de asiento contable.
--   Extiende VWCOG_Diario_General (sqlcg008) con:
--     - Descripcion del encabezado del documento
--       (DgeDes de CogHdgh).
--     - Fecha del documento desde el calendario SegFec.
--     - Valor_Transaccion con signo: positivo para debitos
--       (DgeOri=1), negativo para creditos.
--     - Referencia_1 y Referencia_2 del asiento.
--   Construye el numero de documento formateado como
--   TdiCve-NNNNNNN (7 digitos con ceros a la izquierda).
--   No aplica agrupacion; devuelve el detalle puro.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   PerAno            Ano contable del periodo       (CogHdgd)
--   PerNum            Numero del periodo (1..12)     (CogHdgd)
--   PerDes            Descripcion del periodo        (CogPer)
--   TdiDes            Tipo de documento contable     (CogTdi)
--   Numero_Documento  TdiCve-NNNNNNN formateado      (calc)
--   Fecha_Documento   Fecha ISO del documento        (SegFec)
--   DgeDes            Descripcion del encabezado     (CogHdgh)
--   CtaCve            Clave de la cuenta contable    (CogHdgd)
--   AuxCve            Clave del auxiliar             (CogHdgd)
--   Descripcion       Nombre de cuenta o auxiliar    (calc)
--   CcoCve            Clave del centro de costo      (CogHdgd)
--   CcoDes            Descripcion del CCO            (CogCco)
--   DgeDe1            Descripcion libre del asiento  (CogHdgd)
--   Valor_Transaccion Valor con signo (+deb / -cre)  (calc)
--   CfaCve            Clave de forma de pago CxP     (CogHdgd)
--   CfaDes            Descripcion de forma de pago   (CxpCfa)
--   DgeTid            Tipo de identificacion fiscal  (CogHdgd)
--   DgeIde            Numero de identificacion fiscal(CogHdgd)
--   NcfNro            Numero de comprobante fiscal   (CogHdgd)
--   Referencia_1      Referencia 1 del asiento       (CogHdgd)
--   Referencia_2      Referencia 2 del asiento       (CogHdgd)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CogHdgd   T1  Lineas del diario general (tabla base)
--   CogTdi    T2  Tipos de documento contable
--   CogPer    T3  Periodos contables
--   CogCta    T4  Catalogo de cuentas
--   CogAuxd   T5  Catalogo de auxiliares
--   CogCco    T6  Catalogo de centros de costo
--   CxpCfa    T7  Clasificacion de formas de pago (CxP)
--   CogHdgh   T8  Encabezado del diario general
--   SegFec    T9  Calendario / tabla de fechas
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Fecha_Documento: Join a SegFec T9 por
--   DgeAno+DgeMes+DgeDia -> FecIso.
--   No hay filtro de periodo; devuelve todas las lineas
--   con fecha valida en el calendario.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Cambiar Join CogHdgh T8 a Left Outer Join para
--      no perder lineas de asientos sin encabezado.
--   2. Agregar campo Fecha_Aplicacion desde T8 usando
--      SegFec (disponible en sqlcg010).
--   3. Agregar campo AplUsr / UsrNom para trazabilidad
--      del usuario que aplico el documento.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           IfNull -> Coalesce, sin acentos
-- ==============================================================

Create Or Replace View VWCOG_Diario_General_2 As

Select
    -- --------------------------------------------------------
    -- Identificacion del periodo
    -- --------------------------------------------------------
    T1.PerAno                              As PerAno,
    -- Ano contable del periodo

    T1.PerNum                              As PerNum,
    -- Numero del periodo (1..12)

    T3.PerDes                              As PerDes,
    -- Descripcion del periodo

    -- --------------------------------------------------------
    -- Tipo de documento
    -- --------------------------------------------------------
    T2.TdiDes                              As TdiDes,
    -- Descripcion del tipo de documento contable

    -- --------------------------------------------------------
    -- Numero de documento: TdiCve-NNNNNNN
    -- Formatea DgeDoc con ceros a la izquierda hasta 7 digitos
    -- --------------------------------------------------------
    T1.TdiCve || '-' ||
    Concat(Substring('0000000', 0, 7 - Length(Trim(T1.DgeDoc))),
           Trim(T1.DgeDoc))                As Numero_Documento,

    -- --------------------------------------------------------
    -- Fecha del documento desde el calendario SegFec
    -- --------------------------------------------------------
    T9.FecIso                              As Fecha_Documento,

    -- --------------------------------------------------------
    -- Descripcion del encabezado del documento (CogHdgh)
    -- --------------------------------------------------------
    T8.DgeDes                              As DgeDes,

    -- --------------------------------------------------------
    -- Linea del asiento
    -- --------------------------------------------------------
    T1.CtaCve                              As CtaCve,
    -- Clave de la cuenta contable

    T1.AuxCve                              As AuxCve,
    -- Clave del auxiliar; 0 = sin auxiliar

    -- Descripcion: nombre de cuenta o de auxiliar segun caso
    (Case When T1.AuxCve = 0
     Then T4.CtaDes
     Else T5.AuxNom
     End)                                  As Descripcion,

    T1.CcoCve                              As CcoCve,
    -- Clave del centro de costo

    T6.CcoDes                              As CcoDes,
    -- Descripcion del centro de costo

    T1.DgeDe1                              As DgeDe1,
    -- Descripcion libre de la linea del asiento

    -- --------------------------------------------------------
    -- Valor de la transaccion con signo
    -- DgeOri=1 (Debito)  -> valor positivo
    -- DgeOri=2 (Credito) -> valor negativo
    -- --------------------------------------------------------
    (Case When T1.DgeOri = 1
     Then  T1.DgeVal
     Else (T1.DgeVal * -1)
     End)                                  As Valor_Transaccion,

    -- --------------------------------------------------------
    -- Clasificacion de forma de pago (CxP)
    -- --------------------------------------------------------
    T1.CfaCve                              As CfaCve,
    -- Clave de la clasificacion de forma de pago

    T7.CfaDes                              As CfaDes,
    -- Descripcion de la clasificacion de forma de pago

    -- --------------------------------------------------------
    -- Campos adicionales de identificacion
    -- --------------------------------------------------------
    T1.DgeTid                              As DgeTid,
    -- Tipo de identificacion fiscal

    T1.DgeIde                              As DgeIde,
    -- Numero de identificacion fiscal

    T1.NcfNro                              As NcfNro,
    -- Numero de comprobante fiscal (NCF)

    -- --------------------------------------------------------
    -- Referencias del asiento
    -- --------------------------------------------------------
    T1.DgeRe1                              As Referencia_1,
    -- Referencia 1 de la linea del asiento

    T1.DgeRe2                              As Referencia_2
    -- Referencia 2 de la linea del asiento

-- ============================================================
-- FROM y JOINs
-- ============================================================
From CogHdgd As T1

-- Tipo de documento contable
Join CogTdi As T2
    On T1.TdiCve = T2.TdiCve

-- Periodo contable: descripcion del periodo
Join CogPer As T3
    On  T1.PerAno = T3.PerAno
    And T1.PerNum = T3.PerNum

-- Catalogo de cuentas: descripcion de la cuenta
Join CogCta As T4
    On T1.CtaCve = T4.CtaCve

-- Auxiliares: LEFT porque no toda linea tiene auxiliar
Left Outer Join CogAuxd As T5
    On  T1.AuxLis = T5.AuxLis
    And T1.AuxCve = T5.AuxCve

-- Centro de costo: LEFT porque no toda linea tiene CCO
Left Outer Join CogCco As T6
    On T1.CcoCve = T6.CcoCve

-- Forma de pago CxP: LEFT porque no toda linea tiene CfaCve
Left Outer Join CxpCfa As T7
    On T1.CfaCve = T7.CfaCve

-- Encabezado del documento: descripcion general del asiento
Join CogHdgh As T8
    On  T1.TdiCve = T8.TdiCve
    And T1.PerAno = T8.PerAno
    And T1.PerNum = T8.PerNum
    And T1.DgeDoc = T8.DgeDoc

-- Calendario: resuelve DgeAno+DgeMes+DgeDia a fecha ISO
Join SegFec As T9
    On  T1.DgeAno = T9.FecAno
    And T1.DgeMes = T9.FecMes
    And T1.DgeDia = T9.FecDia

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PerAno, T1.PerNum, T1.TdiCve, T1.DgeDoc,
--          T1.DgeSec
