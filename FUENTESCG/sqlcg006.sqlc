-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : SQLCG006
-- Objeto    : VWCOG_MAYOR_GENERAL_Bcc_MESES
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Pivot mensual combinado del mayor general y del balance
--   por centro de costo, por cuenta contable, auxiliar y ano.
--   Por cada combinacion expone dos series de columnas
--   mensuales (enero-diciembre):
--     - Serie Mge: movimiento neto y balance del mayor
--       general (CogMge).
--     - Serie Bcc: movimiento neto y balance por centro
--       de costo (CogBcc).
--   Tipo_Cuenta distingue cuentas de mayor puras
--   (CtaTip=1 sin auxiliar) de las demas.
--   Descripcion muestra el nombre de la cuenta o del
--   auxiliar segun corresponda.
--   CcoCve / Descripcion_Cco pueden ser NULL cuando la
--   cuenta no tiene movimientos en CogBcc.
--   Solo incluye periodos cerrados (PerSit = 'C').
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   PerAno               Ano contable del periodo     (CogMge)
--   CtaCve               Clave de la cuenta contable  (CogCta)
--   AuxLis               Lista (tipo) del auxiliar    (CogMge)
--   AuxCve               Clave del auxiliar           (CogMge)
--   Tipo_Cuenta          1=mayor pura, 2=con auxiliar (calc)
--   Descripcion          Nombre de cuenta o auxiliar  (calc)
--   CcoCve               Clave del centro de costo    (CogBcc)
--   Descripcion_Cco      Descripcion del CCO          (CogCco)
--   Movimiento_Mge_Ene   Movimiento neto enero (Mge)  (calc)
--   Balance_Mge_Ene      Saldo acumulado enero (Mge)  (calc)
--   Movimiento_Mge_Feb   Movimiento neto feb (Mge)    (calc)
--   Balance_Mge_Feb      Saldo acumulado feb (Mge)    (calc)
--   Movimiento_Mge_Mar   Movimiento neto mar (Mge)    (calc)
--   Balance_Mge_Mar      Saldo acumulado mar (Mge)    (calc)
--   Movimiento_Mge_Abr   Movimiento neto abr (Mge)    (calc)
--   Balance_Mge_Abr      Saldo acumulado abr (Mge)    (calc)
--   Movimiento_Mge_May   Movimiento neto may (Mge)    (calc)
--   Balance_Mge_May      Saldo acumulado may (Mge)    (calc)
--   Movimiento_Mge_Jun   Movimiento neto jun (Mge)    (calc)
--   Balance_Mge_Jun      Saldo acumulado jun (Mge)    (calc)
--   Movimiento_Mge_Jul   Movimiento neto jul (Mge)    (calc)
--   Balance_Mge_Jul      Saldo acumulado jul (Mge)    (calc)
--   Movimiento_Mge_Ago   Movimiento neto ago (Mge)    (calc)
--   Balance_Mge_Ago      Saldo acumulado ago (Mge)    (calc)
--   Movimiento_Mge_Sep   Movimiento neto sep (Mge)    (calc)
--   Balance_Mge_Sep      Saldo acumulado sep (Mge)    (calc)
--   Movimiento_Mge_Oct   Movimiento neto oct (Mge)    (calc)
--   Balance_Mge_Oct      Saldo acumulado oct (Mge)    (calc)
--   Movimiento_Mge_Nov   Movimiento neto nov (Mge)    (calc)
--   Balance_Mge_Nov      Saldo acumulado nov (Mge)    (calc)
--   Movimiento_Mge_Dic   Movimiento neto dic (Mge)    (calc)
--   Balance_Mge_Dic      Saldo acumulado dic (Mge)    (calc)
--   Movimiento_Bcc_Ene   Movimiento neto enero (Bcc)  (calc)
--   Balance_Bcc_Ene      Saldo acumulado enero (Bcc)  (calc)
--   Movimiento_Bcc_Feb   Movimiento neto feb (Bcc)    (calc)
--   Balance_Bcc_Feb      Saldo acumulado feb (Bcc)    (calc)
--   Movimiento_Bcc_Mar   Movimiento neto mar (Bcc)    (calc)
--   Balance_Bcc_Mar      Saldo acumulado mar (Bcc)    (calc)
--   Movimiento_Bcc_Abr   Movimiento neto abr (Bcc)    (calc)
--   Balance_Bcc_Abr      Saldo acumulado abr (Bcc)    (calc)
--   Movimiento_Bcc_May   Movimiento neto may (Bcc)    (calc)
--   Balance_Bcc_May      Saldo acumulado may (Bcc)    (calc)
--   Movimiento_Bcc_Jun   Movimiento neto jun (Bcc)    (calc)
--   Balance_Bcc_Jun      Saldo acumulado jun (Bcc)    (calc)
--   Movimiento_Bcc_Jul   Movimiento neto jul (Bcc)    (calc)
--   Balance_Bcc_Jul      Saldo acumulado jul (Bcc)    (calc)
--   Movimiento_Bcc_Ago   Movimiento neto ago (Bcc)    (calc)
--   Balance_Bcc_Ago      Saldo acumulado ago (Bcc)    (calc)
--   Movimiento_Bcc_Sep   Movimiento neto sep (Bcc)    (calc)
--   Balance_Bcc_Sep      Saldo acumulado sep (Bcc)    (calc)
--   Movimiento_Bcc_Oct   Movimiento neto oct (Bcc)    (calc)
--   Balance_Bcc_Oct      Saldo acumulado oct (Bcc)    (calc)
--   Movimiento_Bcc_Nov   Movimiento neto nov (Bcc)    (calc)
--   Balance_Bcc_Nov      Saldo acumulado nov (Bcc)    (calc)
--   Movimiento_Bcc_Dic   Movimiento neto dic (Bcc)    (calc)
--   Balance_Bcc_Dic      Saldo acumulado dic (Bcc)    (calc)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CogCta    T1  Catalogo de cuentas (tabla base)
--   CogMge    T2  Movimientos del mayor general
--   CogAuxd   T3  Catalogo de auxiliares
--   CogBcc    T4  Balance por cuenta y centro de costo
--   CogCco    T5  Catalogo de centros de costo
--   CogPer    T6  Periodos contables
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Filtra por T6.PerSit = 'C' (periodos cerrados).
--   PerAno identifica el ano contable; el pivot distribuye
--   los valores en columnas segun PerNum (01..12) tanto
--   para la serie Mge como para la serie Bcc.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Considerar separar en dos vistas (MESES_MGE y
--      MESES_BCC) para simplificar mantenimiento.
--   2. Agregar columnas de totales anuales por serie.
--   3. Evaluar uso de CTE para pre-agregar Mge y Bcc
--      antes del pivot y reducir complejidad.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           IfNull -> Coalesce, sin acentos
-- ==============================================================

Create Or Replace View VWCOG_MAYOR_GENERAL_Bcc_MESES As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T2.PerAno                              As PerAno,
    -- Ano contable del periodo

    T1.CtaCve                              As CtaCve,
    -- Clave de la cuenta contable

    T2.AuxLis                              As AuxLis,
    -- Lista (tipo) del auxiliar; 0 = sin auxiliar

    T2.AuxCve                              As AuxCve,
    -- Clave del auxiliar; 0 = sin auxiliar

    -- Tipo_Cuenta:
    --   1 = cuenta de mayor pura (CtaTip=1, sin auxiliar)
    --   2 = cuenta con auxiliar o de otro tipo
    (Case When T1.CtaTip = 1
          And  T2.AuxLis = 0
          And  T2.AuxCve = 0
     Then 1
     Else 2
     End)                                  As Tipo_Cuenta,

    -- Descripcion: nombre de cuenta o de auxiliar segun caso
    (Case When T2.AuxCve = 0
     Then T1.CtaDes
     Else T3.AuxNom
     End)                                  As Descripcion,

    T4.CcoCve                              As CcoCve,
    -- Clave del centro de costo (NULL si no hay en CogBcc)

    T5.CcoDes                              As Descripcion_Cco,
    -- Descripcion del centro de costo

    -- --------------------------------------------------------
    -- Pivot mensual mayor general (CogMge)
    -- Movimiento_Mge = Debito - Credito del mayor
    -- Balance_Mge    = Saldo acumulado del mayor
    -- --------------------------------------------------------
    Coalesce(Sum(Case When T2.PerNum = 01
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Ene,
    Coalesce(Sum(Case When T2.PerNum = 01
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Ene,

    Coalesce(Sum(Case When T2.PerNum = 02
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Feb,
    Coalesce(Sum(Case When T2.PerNum = 02
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Feb,

    Coalesce(Sum(Case When T2.PerNum = 03
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Mar,
    Coalesce(Sum(Case When T2.PerNum = 03
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Mar,

    Coalesce(Sum(Case When T2.PerNum = 04
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Abr,
    Coalesce(Sum(Case When T2.PerNum = 04
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Abr,

    Coalesce(Sum(Case When T2.PerNum = 05
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_May,
    Coalesce(Sum(Case When T2.PerNum = 05
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_May,

    Coalesce(Sum(Case When T2.PerNum = 06
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Jun,
    Coalesce(Sum(Case When T2.PerNum = 06
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Jun,

    Coalesce(Sum(Case When T2.PerNum = 07
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Jul,
    Coalesce(Sum(Case When T2.PerNum = 07
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Jul,

    Coalesce(Sum(Case When T2.PerNum = 08
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Ago,
    Coalesce(Sum(Case When T2.PerNum = 08
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Ago,

    Coalesce(Sum(Case When T2.PerNum = 09
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Sep,
    Coalesce(Sum(Case When T2.PerNum = 09
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Sep,

    Coalesce(Sum(Case When T2.PerNum = 10
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Oct,
    Coalesce(Sum(Case When T2.PerNum = 10
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Oct,

    Coalesce(Sum(Case When T2.PerNum = 11
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Nov,
    Coalesce(Sum(Case When T2.PerNum = 11
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Nov,

    Coalesce(Sum(Case When T2.PerNum = 12
               Then (T2.MgeDeb - T2.MgeCre)
               End), 0)                    As Movimiento_Mge_Dic,
    Coalesce(Sum(Case When T2.PerNum = 12
               Then T2.MgeBal
               End), 0)                    As Balance_Mge_Dic,

    -- --------------------------------------------------------
    -- Pivot mensual centro de costo (CogBcc)
    -- Movimiento_Bcc = Debito - Credito del CCO
    -- Balance_Bcc    = Saldo acumulado del CCO
    -- 0 cuando la cuenta no tiene movimientos en CogBcc
    -- --------------------------------------------------------
    Coalesce(Sum(Case When T4.PerNum = 01
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Ene,
    Coalesce(Sum(Case When T4.PerNum = 01
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Ene,

    Coalesce(Sum(Case When T4.PerNum = 02
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Feb,
    Coalesce(Sum(Case When T4.PerNum = 02
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Feb,

    Coalesce(Sum(Case When T4.PerNum = 03
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Mar,
    Coalesce(Sum(Case When T4.PerNum = 03
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Mar,

    Coalesce(Sum(Case When T4.PerNum = 04
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Abr,
    Coalesce(Sum(Case When T4.PerNum = 04
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Abr,

    Coalesce(Sum(Case When T4.PerNum = 05
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_May,
    Coalesce(Sum(Case When T4.PerNum = 05
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_May,

    Coalesce(Sum(Case When T4.PerNum = 06
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Jun,
    Coalesce(Sum(Case When T4.PerNum = 06
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Jun,

    Coalesce(Sum(Case When T4.PerNum = 07
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Jul,
    Coalesce(Sum(Case When T4.PerNum = 07
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Jul,

    Coalesce(Sum(Case When T4.PerNum = 08
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Ago,
    Coalesce(Sum(Case When T4.PerNum = 08
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Ago,

    Coalesce(Sum(Case When T4.PerNum = 09
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Sep,
    Coalesce(Sum(Case When T4.PerNum = 09
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Sep,

    Coalesce(Sum(Case When T4.PerNum = 10
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Oct,
    Coalesce(Sum(Case When T4.PerNum = 10
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Oct,

    Coalesce(Sum(Case When T4.PerNum = 11
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Nov,
    Coalesce(Sum(Case When T4.PerNum = 11
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Nov,

    Coalesce(Sum(Case When T4.PerNum = 12
               Then (T4.BccDeb - T4.BccCre)
               End), 0)                    As Movimiento_Bcc_Dic,
    Coalesce(Sum(Case When T4.PerNum = 12
               Then T4.BccBal
               End), 0)                    As Balance_Bcc_Dic

-- ============================================================
-- FROM y JOINs
-- ============================================================
From CogCta As T1

-- Mayor general: movimientos por cuenta
Join CogMge As T2
    On T1.CtaCve = T2.CtaCve

-- Auxiliares: LEFT porque no toda cuenta tiene auxiliar
Left Outer Join CogAuxd As T3
    On  T2.AuxLis = T3.AuxLis
    And T2.AuxCve = T3.AuxCve

-- Balance por CCO: LEFT porque no toda cuenta/periodo
-- tiene movimientos por centro de costo
Left Outer Join CogBcc As T4
    On  T2.PerAno = T4.PerAno
    And T2.PerNum = T4.PerNum
    And T1.CtaCve = T4.CtaCve
    And T2.AuxLis = T4.AuxLis
    And T2.AuxCve = T4.AuxCve

-- Centro de costo: LEFT porque T4 puede ser NULL
Left Outer Join CogCco As T5
    On T4.CcoCve = T5.CcoCve

-- Periodo contable: filtra solo periodos cerrados
Join CogPer As T6
    On  T2.PerAno = T6.PerAno
    And T2.PerNum = T6.PerNum

-- ============================================================
-- Filtro: solo periodos cerrados
-- ============================================================
Where T6.PerSit = 'C'

-- ============================================================
-- GROUP BY: todas las dimensiones no agregadas del SELECT
-- ============================================================
Group By
    T2.PerAno,
    T1.CtaCve,
    T2.AuxLis,
    T2.AuxCve,
    (Case When T1.CtaTip = 1
          And  T2.AuxLis = 0
          And  T2.AuxCve = 0
     Then 1
     Else 2
     End),
    (Case When T2.AuxCve = 0
     Then T1.CtaDes
     Else T3.AuxNom
     End),
    T4.CcoCve,
    T5.CcoDes

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T2.PerAno, T1.CtaCve, T2.AuxLis,
--          T2.AuxCve, T4.CcoCve
