Create Or Replace View VWCOG_MAYOR_GENERALMESES
As Select T1.PerAno,
T1.CtaCve, T1.AuxLis, T1.AuxCve,
(Case When T3.CtaTip = 1 And T1.AuxLis = 0 And T1.AuxCve = 0 Then 1
Else 2 End) Tipo_Cuenta,
(Case When T1.AuxCve = 0 Then T3.CtaDes Else T4.AuxNom End)
Descripcion,
IfNull (Sum(Case When T1.PerNum = 01 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Ene,
IfNull (Sum(Case When T1.PerNum = 01 Then T1.MgeBal End), 0)
Balance_Ene,
IfNull (Sum(Case When T1.PerNum = 02 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Feb,
IfNull (Sum(Case When T1.PerNum = 02 Then T1.MgeBal End), 0)
Balance_Feb,
IfNull (Sum(Case When T1.PerNum = 03 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Mar,
IfNull (Sum(Case When T1.PerNum = 03 Then T1.MgeBal End), 0)
Balance_Mar,
IfNull (Sum(Case When T1.PerNum = 04 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Abr,
IfNull (Sum(Case When T1.PerNum = 04 Then T1.MgeBal End), 0)
Balance_Abr,
IfNull (Sum(Case When T1.PerNum = 05 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_May,
IfNull (Sum(Case When T1.PerNum = 05 Then T1.MgeBal End), 0)
Balance_May,
IfNull (Sum(Case When T1.PerNum = 06 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Jun,
IfNull (Sum(Case When T1.PerNum = 06 Then T1.MgeBal End), 0)
Balance_Jun,
IfNull (Sum(Case When T1.PerNum = 07 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Jul,
IfNull (Sum(Case When T1.PerNum = 07 Then T1.MgeBal End), 0)
Balance_Jul,
IfNull (Sum(Case When T1.PerNum = 08 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Ago,
IfNull (Sum(Case When T1.PerNum = 08 Then T1.MgeBal End), 0)
Balance_Ago,
IfNull (Sum(Case When T1.PerNum = 09 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Sep,
IfNull (Sum(Case When T1.PerNum = 09 Then T1.MgeBal End), 0)
Balance_Sep,
IfNull (Sum(Case When T1.PerNum = 10 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Oct,
IfNull (Sum(Case When T1.PerNum = 10 Then T1.MgeBal End), 0)
Balance_Oct,
IfNull (Sum(Case When T1.PerNum = 11 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Nov,
IfNull (Sum(Case When T1.PerNum = 11 Then T1.MgeBal End), 0)
Balance_Nov,
IfNull (Sum(Case When T1.PerNum = 12 Then (T1.MgeDeb - T1.MgeCre)
End), 0) Movimiento_Dic,
IfNull (Sum(Case When T1.PerNum = 12 Then T1.MgeBal End), 0)
Balance_Dic
  From CogMge T1
  Join CogPer T2
    On (T1.PerAno = T2.PerAno)
   And (T1.PerNum = T2.PerNum)
  Join CogCta T3
    On (T1.CtaCve = T3.CtaCve)
Left Outer Join CogAuxd T4
    On (T1.AuxLis = T4.AuxLis)
   And (T1.AuxCve = T4.AuxCve)
  Where (T2.PerSit = 'C')
  Group By T1.PerAno, T1.CtaCve, T1.Auxlis, T1.AuxCve,
  (Case When T3.CtaTip = 1 And T1.AuxLis = 0 And T1.AuxCve = 0 Then 1
  Else 2 End),
  (Case When T1.AuxCve = 0 Then T3.CtaDes Else T4.AuxNom End)
