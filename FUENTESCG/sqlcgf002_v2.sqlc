--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ============================================================
-- Función  : SEGLIB.SG_TIEMPO_ANOS
-- Propósito: Calcula la diferencia en años cumplidos entre dos
--            fechas, equivalente al programa SG7006.
-- Versión  : 2.0 (escalar - respaldo)
-- Parámetros:
--   FechaDes  DATE  Fecha de inicio (desde).
--   FechaHas  DATE  Fecha de fin    (hasta).
-- Retorna:
--   INTEGER  Años cumplidos entre FechaDes y FechaHas.
--            NULL  si alguno de los parámetros es NULL.
--            0     si FechaHas < FechaDes (sin resultado negativo).
-- Nota: Esta versión es ESCALAR (RETURNS INTEGER).
--       Ver sqlcgf002.sqlc para la versión de tabla (v3.0).
-- ============================================================

CREATE OR REPLACE FUNCTION SEGLIB.SG_TIEMPO_ANOS (
  FechaDes DATE,
  FechaHas DATE
)
RETURNS INTEGER
LANGUAGE SQL
DETERMINISTIC
NO EXTERNAL ACTION
RETURNS NULL ON NULL INPUT
BEGIN
  DECLARE vAnos INTEGER DEFAULT 0;

  IF FechaHas < FechaDes THEN
    RETURN 0;
  END IF;

  SET vAnos = YEAR(FechaHas) - YEAR(FechaDes);

  IF (MONTH(FechaHas) < MONTH(FechaDes))
     OR (MONTH(FechaHas) = MONTH(FechaDes) AND
         DAY(FechaHas) < DAY(FechaDes)) THEN
    SET vAnos = vAnos - 1;
  END IF;

  RETURN vAnos;
END;


GRANT EXECUTE ON FUNCTION SEGLIB.SG_TIEMPO_ANOS TO PUBLIC;
