-- ==============================================================
-- Modulo    : Contabilidad General
-- Programa  : SQLCG001
-- Objeto    : VWCOG_MAYOR_GENERALMESES
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Pivot del mayor general por cuenta contable, auxiliar y
--   periodo (ano), desplegando por cada mes el movimiento
--   neto (Debito - Credito) y el saldo acumulado (Balance).
--   Tipo_Cuenta distingue cuentas de mayor puras
--   (CtaTip=1 sin auxiliar) de las demas.
--   Descripcion muestra el nombre de la cuenta o del auxiliar
--   segun corresponda.
--   Solo incluye periodos cerrados (PerSit = 'C').
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   PerAno           Ano contable del periodo
--   CtaCve           Clave de la cuenta contable
--   AuxLis           Lista del auxiliar (0 = sin auxiliar)
--   AuxCve           Clave del auxiliar (0 = sin auxiliar)
--   Tipo_Cuenta      1=mayor pura, 2=con auxiliar o mixta
--   Descripcion      Nombre de cuenta o de auxiliar
--   Movimiento_Ene   Debito - Credito enero
--   Balance_Ene      Saldo acumulado enero
--   Movimiento_Feb   Debito - Credito febrero
--   Balance_Feb      Saldo acumulado febrero
--   Movimiento_Mar   Debito - Credito marzo
--   Balance_Mar      Saldo acumulado marzo
--   Movimiento_Abr   Debito - Credito abril
--   Balance_Abr      Saldo acumulado abril
--   Movimiento_May   Debito - Credito mayo
--   Balance_May      Saldo acumulado mayo
--   Movimiento_Jun   Debito - Credito junio
--   Balance_Jun      Saldo acumulado junio
--   Movimiento_Jul   Debito - Credito julio
--   Balance_Jul      Saldo acumulado julio
--   Movimiento_Ago   Debito - Credito agosto
--   Balance_Ago      Saldo acumulado agosto
--   Movimiento_Sep   Debito - Credito septiembre
--   Balance_Sep      Saldo acumulado septiembre
--   Movimiento_Oct   Debito - Credito octubre
--   Balance_Oct      Saldo acumulado octubre
--   Movimiento_Nov   Debito - Credito noviembre
--   Balance_Nov      Saldo acumulado noviembre
--   Movimiento_Dic   Debito - Credito diciembre
--   Balance_Dic      Saldo acumulado diciembre
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CogMge    T1  Movimientos del mayor general (tabla base)
--   CogPer    T2  Periodos contables (filtro PerSit='C')
--   CogCta    T3  Catalogo de cuentas
--   CogAuxd   T4  Catalogo de auxiliares
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   No aplica. Esta vista no maneja campos de fecha.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. El pivot de 12 meses genera 24 expresiones CASE dentro
--      de SUM. En DB2 for i se puede lograr el mismo resultado
--      con una tabla pivotante o MQT para mejor rendimiento
--      si el volumen de movimientos es alto.
--   2. El JOIN a CogPer filtra solo periodos cerrados
--      (PerSit='C'). Si se requieren periodos abiertos para
--      seguimiento, crear una vista separada sin ese filtro.
--   3. Agregar indice en CogMge(PerAno, PerNum, CtaCve) para
--      optimizar el GROUP BY y el JOIN con CogPer.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           IfNull -> Coalesce, sin acentos
-- ==============================================================

Create Or Replace View VWCOG_MAYOR_GENERALMESES As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T1.PerAno                              As PerAno,
    -- Ano contable del periodo

    T1.CtaCve                              As CtaCve,
    -- Clave de la cuenta contable

    T1.AuxLis                              As AuxLis,
    -- Lista (tipo) del auxiliar; 0 = sin auxiliar

    T1.AuxCve                              As AuxCve,
    -- Clave del auxiliar; 0 = sin auxiliar

    -- Tipo_Cuenta:
    --   1 = cuenta de mayor pura (CtaTip=1, sin auxiliar)
    --   2 = cuenta con auxiliar o de otro tipo
    (Case When T3.CtaTip = 1
          And  T1.AuxLis = 0
          And  T1.AuxCve = 0
     Then 1
     Else 2
     End)                                  As Tipo_Cuenta,

    -- Descripcion: nombre de cuenta o de auxiliar segun caso
    (Case When T1.AuxCve = 0
     Then T3.CtaDes
     Else T4.AuxNom
     End)                                  As Descripcion,

    -- --------------------------------------------------------
    -- Pivot mensual: Movimiento neto y Balance por mes
    -- Movimiento = Debito - Credito del periodo
    -- Balance    = Saldo acumulado del periodo
    -- --------------------------------------------------------
    Coalesce(Sum(Case When T1.PerNum = 01
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Ene,
    Coalesce(Sum(Case When T1.PerNum = 01
               Then T1.MgeBal
               End), 0)                    As Balance_Ene,

    Coalesce(Sum(Case When T1.PerNum = 02
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Feb,
    Coalesce(Sum(Case When T1.PerNum = 02
               Then T1.MgeBal
               End), 0)                    As Balance_Feb,

    Coalesce(Sum(Case When T1.PerNum = 03
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Mar,
    Coalesce(Sum(Case When T1.PerNum = 03
               Then T1.MgeBal
               End), 0)                    As Balance_Mar,

    Coalesce(Sum(Case When T1.PerNum = 04
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Abr,
    Coalesce(Sum(Case When T1.PerNum = 04
               Then T1.MgeBal
               End), 0)                    As Balance_Abr,

    Coalesce(Sum(Case When T1.PerNum = 05
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_May,
    Coalesce(Sum(Case When T1.PerNum = 05
               Then T1.MgeBal
               End), 0)                    As Balance_May,

    Coalesce(Sum(Case When T1.PerNum = 06
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Jun,
    Coalesce(Sum(Case When T1.PerNum = 06
               Then T1.MgeBal
               End), 0)                    As Balance_Jun,

    Coalesce(Sum(Case When T1.PerNum = 07
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Jul,
    Coalesce(Sum(Case When T1.PerNum = 07
               Then T1.MgeBal
               End), 0)                    As Balance_Jul,

    Coalesce(Sum(Case When T1.PerNum = 08
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Ago,
    Coalesce(Sum(Case When T1.PerNum = 08
               Then T1.MgeBal
               End), 0)                    As Balance_Ago,

    Coalesce(Sum(Case When T1.PerNum = 09
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Sep,
    Coalesce(Sum(Case When T1.PerNum = 09
               Then T1.MgeBal
               End), 0)                    As Balance_Sep,

    Coalesce(Sum(Case When T1.PerNum = 10
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Oct,
    Coalesce(Sum(Case When T1.PerNum = 10
               Then T1.MgeBal
               End), 0)                    As Balance_Oct,

    Coalesce(Sum(Case When T1.PerNum = 11
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Nov,
    Coalesce(Sum(Case When T1.PerNum = 11
               Then T1.MgeBal
               End), 0)                    As Balance_Nov,

    Coalesce(Sum(Case When T1.PerNum = 12
               Then (T1.MgeDeb - T1.MgeCre)
               End), 0)                    As Movimiento_Dic,
    Coalesce(Sum(Case When T1.PerNum = 12
               Then T1.MgeBal
               End), 0)                    As Balance_Dic

-- ============================================================
-- FROM y JOINs
-- ============================================================
From CogMge As T1

-- Periodo contable: filtra solo periodos cerrados (PerSit='C')
Join CogPer As T2
    On  T1.PerAno = T2.PerAno
    And T1.PerNum = T2.PerNum

-- Catalogo de cuentas: descripcion y tipo de cuenta
Join CogCta As T3
    On T1.CtaCve = T3.CtaCve

-- Auxiliares: LEFT porque no toda cuenta tiene auxiliar
Left Outer Join CogAuxd As T4
    On  T1.AuxLis = T4.AuxLis
    And T1.AuxCve = T4.AuxCve

-- ============================================================
-- Filtro: solo periodos cerrados
-- ============================================================
Where T2.PerSit = 'C'

-- ============================================================
-- GROUP BY: todas las dimensiones no agregadas del SELECT
-- ============================================================
Group By
    T1.PerAno,
    T1.CtaCve,
    T1.AuxLis,
    T1.AuxCve,
    (Case When T3.CtaTip = 1
          And  T1.AuxLis = 0
          And  T1.AuxCve = 0
     Then 1
     Else 2
     End),
    (Case When T1.AuxCve = 0
     Then T3.CtaDes
     Else T4.AuxNom
     End)

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PerAno, T1.CtaCve, T1.AuxLis, T1.AuxCve
