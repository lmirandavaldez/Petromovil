--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : Nomina de Empleados
-- Programa  : SQLNM006
-- Objeto    : VWNOM_MAESTRO_EMPLEADOS_CANCELADOS
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2`n-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Maestro completo de empleados cancelados/egresados
--            (EmpSta = 'C') con datos personales, laborales,
--            de contacto y fechas clave, incluyendo anos de edad
--            y anos trabajados calculados correctamente con
--            SEGLIB.SG_TIEMPO_ANOS.
-- Correcciones v1  v2:
--   1. Anos_de_Edad corregido: SEGLIB.SG_TIEMPO_ANOS via
--      CROSS JOIN LATERAL (sustituye YEAR(CURRENT_DATE - Date(...))
--      que producia resultados incorrectos por DURATION DB2).
--   2. Anos_Trabajo_Empresa corregido: SEGLIB.SG_TIEMPO_ANOS
--      (FechaIngreso  FechaSalida)  sustituye YEAR(Salida-Ingreso)
--      mismo problema de aritmetica DURATION.
--   3. Cedula_Empleado centralizada en LATERAL CE con
--      LATERAL(VALUES(...))  elimina CASE repetido 3 veces
--      y corrige T1.EmpCed sin calificador de tabla.
--   4. Fecha_Nacimiento centralizada en LATERAL FN (1 calculo).
--   5. Fecha_Ingreso centralizada en LATERAL FI (1 calculo).
--   6. Fecha_Salida_Empresa centralizada en LATERAL FS (1 calculo).
--   7. Fecha_Fijacion, Fecha_Inicio/Fin_Vacaciones y
--      Fecha_Salida_Empresa protegidas con CASE de validacion
--      (NULL/0/rango) para evitar error en DATE().
--   8. Capitalizacion SQL normalizada a mayusculas.
--   9. Cabecera de documentacion anadida.
-- Notas:
--   - Filtra EmpSta = 'C' (cancelados/egresados).
--   - Gemela de VWNOM_MAESTRO_EMPLEADOS (sqlnm001) con el
--     campo adicional Fecha_Salida_Empresa y Anos_Trabajo_Empresa,
--     y sin Meses_En_la_Empresa ni Dias_En_la_Empresa.
-- Tablas referenciadas:
--   NomEmp (T1)  Maestro de empleados
--   NomDep (T2)  Departamentos
--   NomCar (T3)  Cargos
--   NomCat (T4)  Categorias
--   NomCmc (T5)  Centros de costo de nomina
--   NomCno (T6)  Conceptos
--   NomNac (T7)  Nacionalidades
--   NomUbi (T8)  Ubicaciones
--   NomPro (T9)  Provincias
--   CogCco (T10) Centros de costo contables
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWNOM_MAESTRO_EMPLEADOS_CANCELADOS AS
SELECT
    -- Identificacion del empleado
    T1.EmpCve,
    T1.EmpNom,
    T1.EmpApe,

    -- Cedula formateada ###-#######-# centralizada en LATERAL CE
    CE.Cedula_Empleado,

    -- Clasificaciones
    T1.CnoCve,  T6.CnoDes,
    T1.DepCve,  T2.DepDes,
    T1.CatCve,  T4.CatDes,
    T1.CarCve,  T3.CarDes,
    T1.UbiCve,  T8.UbiDes,

    -- Datos personales
    T1.EmpSex,
    T1.NacCve,  T7.NacDes,
    T1.EmpLna,
    T1.EmpEsc,

    -- Contacto
    T1.EmpTe1, T1.EmpTd1,
    T1.EmpTe2, T1.EmpTd2,
    T1.EmpTe3, T1.EmpTd3,
    T1.EmpDi1, T1.EmpDi2,
    T1.EmpEma,
    T1.EmpNd1, T1.EmpDd1,
    T1.EmpNd2, T1.EmpDd2,

    -- Datos laborales y salariales
    T1.ProCve,  T9.ProDes,
    T1.EmpTSa,
    T1.EmpRnc,  T1.EmpRss,  T1.EmpPes,
    T1.EmpEst,  T1.EmpCPe,  T1.EmpTez,
    T1.EmpSba,  T1.EmpSbp,  T1.EmpSal,
    T1.EmpSop,  T1.EmpShr,  T1.EmpFpg,
    T1.BanCve,  T1.EmpCba,  T1.EmpTcb,
    T1.EmpTip,  T1.EmpTsl,  T1.EmpEva,
    T1.CtaCve,  T1.AuxCve,
    T1.CcoCve,  T10.CcoDes,
    T1.CmcCve,  T5.CmcDes,
    T1.EmpSta,

    -- Fecha de nacimiento centralizada en LATERAL FN
    FN.Fecha_Nacimiento,

    -- Edad en anos usando SG_TIEMPO_ANOS (correcto para DB2 for i)
    EA.ANOS                                     AS Anos_de_Edad,

    -- Fecha de ingreso centralizada en LATERAL FI
    FI.Fecha_Ingreso,

    -- Fechas opcionales con centinela DATE('1900-01-01') si invalidas
    CASE
        WHEN T1.EmpAfi IS NULL OR T1.EmpAfi = 0
          OR T1.EmpMfi IS NULL OR T1.EmpMfi = 0
          OR T1.EmpDfi IS NULL OR T1.EmpDfi = 0
          OR T1.EmpAfi < 1900  OR T1.EmpAfi > 9999
          OR T1.EmpMfi < 1     OR T1.EmpMfi > 12
          OR T1.EmpDfi < 1     OR T1.EmpDfi > 31
            THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAfi)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMfi)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDfi)), 2))
    END AS Fecha_Fijacion,

    CASE
        WHEN T1.EmpAva IS NULL OR T1.EmpAva = 0
          OR T1.EmpMva IS NULL OR T1.EmpMva = 0
          OR T1.EmpDva IS NULL OR T1.EmpDva = 0
          OR T1.EmpAva < 1900  OR T1.EmpAva > 9999
          OR T1.EmpMva < 1     OR T1.EmpMva > 12
          OR T1.EmpDva < 1     OR T1.EmpDva > 31
            THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAva)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMva)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDva)), 2))
    END AS Fecha_Inicio_Vacaciones,

    CASE
        WHEN T1.EmpAfv IS NULL OR T1.EmpAfv = 0
          OR T1.EmpMfv IS NULL OR T1.EmpMfv = 0
          OR T1.EmpDfv IS NULL OR T1.EmpDfv = 0
          OR T1.EmpAfv < 1900  OR T1.EmpAfv > 9999
          OR T1.EmpMfv < 1     OR T1.EmpMfv > 12
          OR T1.EmpDfv < 1     OR T1.EmpDfv > 31
            THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAfv)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMfv)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDfv)), 2))
    END AS Fecha_Fin_Vacaciones,

    -- Fecha de salida centralizada en LATERAL FS
    FS.Fecha_Salida_Empresa,

    -- Anos trabajados: desde Fecha_Ingreso hasta Fecha_Salida
    -- SG_TIEMPO_ANOS es correcto; YEAR(Salida-Ingreso) usa DURATION DB2
    -- y produce resultado incorrecto si el aniversario no ocurrio
    AT.ANOS                                     AS Anos_Trabajo_Empresa

FROM NomEmp T1
LEFT OUTER JOIN NomDep T2  ON T1.DepCve = T2.DepCve
LEFT OUTER JOIN NomCar T3  ON T1.CarCve = T3.CarCve
LEFT OUTER JOIN NomCat T4  ON T1.CatCve = T4.CatCve
LEFT OUTER JOIN NomCmc T5  ON T1.CmcCve = T5.CmcCve
LEFT OUTER JOIN NomCno T6  ON T1.CnoCve = T6.CnoCve
LEFT OUTER JOIN NomNac T7  ON T1.NacCve = T7.NacCve
LEFT OUTER JOIN NomUbi T8  ON T1.UbiCve = T8.UbiCve
LEFT OUTER JOIN NomPro T9  ON T1.ProCve = T9.ProCve
LEFT OUTER JOIN CogCco T10 ON T1.CcoCve = T10.CcoCve

-- LATERAL CE: cedula formateada ###-#######-# (un solo CASE aplanado)
CROSS JOIN LATERAL (
    SELECT
        SUBSTR(CED_VAL, 1,  3) || '-' ||
        SUBSTR(CED_VAL, 4,  7) || '-' ||
        SUBSTR(CED_VAL, 11, 1) AS Cedula_Empleado
    FROM SYSIBM.SYSDUMMY1,
         LATERAL (VALUES (
             CASE LENGTH(TRIM(CHAR(T1.EmpCed)))
                 WHEN 9  THEN '00' || TRIM(CHAR(T1.EmpCed))
                 WHEN 10 THEN '0'  || TRIM(CHAR(T1.EmpCed))
                 ELSE         TRIM(CHAR(T1.EmpCed))
             END
         )) AS V(CED_VAL)
) AS CE

-- LATERAL FN: fecha de nacimiento construida una sola vez
CROSS JOIN LATERAL (
    SELECT DATE(
        CONCAT(SUBSTRING('0000', 0, 5 - LENGTH(TRIM(T1.EmpAna))),
               TRIM(T1.EmpAna)) || '-' ||
        CONCAT(SUBSTRING('00',   0, 3 - LENGTH(TRIM(T1.EmpMna))),
               TRIM(T1.EmpMna)) || '-' ||
        CONCAT(SUBSTRING('00',   0, 3 - LENGTH(TRIM(T1.EmpDna))),
               TRIM(T1.EmpDna))
    ) AS Fecha_Nacimiento
    FROM SYSIBM.SYSDUMMY1
) AS FN

-- LATERAL EA: anos de edad usando SG_TIEMPO_ANOS (correcto)
CROSS JOIN LATERAL (
    SELECT ANOS
    FROM TABLE(SEGLIB.SG_TIEMPO_ANOS(FN.Fecha_Nacimiento, CURRENT_DATE))
) AS EA

-- LATERAL FI: fecha de ingreso construida una sola vez
CROSS JOIN LATERAL (
    SELECT DATE(
        CONCAT(SUBSTRING('0000', 0, 5 - LENGTH(TRIM(T1.EmpAin))),
               TRIM(T1.EmpAin)) || '-' ||
        CONCAT(SUBSTRING('00',   0, 3 - LENGTH(TRIM(T1.EmpMin))),
               TRIM(T1.EmpMin)) || '-' ||
        CONCAT(SUBSTRING('00',   0, 3 - LENGTH(TRIM(T1.EmpDin))),
               TRIM(T1.EmpDin))
    ) AS Fecha_Ingreso
    FROM SYSIBM.SYSDUMMY1
) AS FI

-- LATERAL FS: fecha de salida construida y validada una sola vez
-- Centinela DATE('1900-01-01') si campos invalidos
CROSS JOIN LATERAL (
    SELECT CASE
               WHEN T1.EmpAsa IS NULL OR T1.EmpAsa = 0
                 OR T1.EmpMsa IS NULL OR T1.EmpMsa = 0
                 OR T1.EmpDsa IS NULL OR T1.EmpDsa = 0
                 OR T1.EmpAsa < 1900  OR T1.EmpAsa > 9999
                 OR T1.EmpMsa < 1     OR T1.EmpMsa > 12
                 OR T1.EmpDsa < 1     OR T1.EmpDsa > 31
                   THEN DATE('1900-01-01')
               ELSE DATE(
                   CONCAT(SUBSTRING('0000', 0, 5 - LENGTH(TRIM(T1.EmpAsa))),
                          TRIM(T1.EmpAsa)) || '-' ||
                   CONCAT(SUBSTRING('00',   0, 3 - LENGTH(TRIM(T1.EmpMsa))),
                          TRIM(T1.EmpMsa)) || '-' ||
                   CONCAT(SUBSTRING('00',   0, 3 - LENGTH(TRIM(T1.EmpDsa))),
                          TRIM(T1.EmpDsa))
               )
           END AS Fecha_Salida_Empresa
    FROM SYSIBM.SYSDUMMY1
) AS FS

-- LATERAL AT: anos trabajados desde ingreso hasta salida (correcto)
-- Si Fecha_Salida es el centinela 1900-01-01, SG_TIEMPO_ANOS retorna 0
CROSS JOIN LATERAL (
    SELECT ANOS
    FROM TABLE(SEGLIB.SG_TIEMPO_ANOS(FI.Fecha_Ingreso,
               FS.Fecha_Salida_Empresa))
) AS AT

WHERE T1.EmpSta = 'C';
