--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : Nomina de Empleados
-- Programa  : SQLNM001
-- Objeto    : VWNOM_MAESTRO_EMPLEADOS
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Versión  : 3.0
-- --------------------------------------------------------------
-- Propósito: Maestro completo de empleados activos con datos
--            personales, laborales, de contacto y fechas clave,
--            incluyendo años de edad y antigüedad calculados con
--            SEGLIB.SG_TIEMPO_ANOS.
-- Correcciones v1  v2:
--   1. Anos_de_Edad y Anos_En_la_Empresa corregidos: se usa
--      SEGLIB.SG_TIEMPO_ANOS vía CROSS JOIN LATERAL en lugar de
--      YEAR(Current Date - Date(...)), que producía resultados
--      incorrectos por aritmética de duraciones en DB2 for i.
--   2. Fecha_Fijacion, Fecha_Inicio_Vacaciones y Fecha_Fin_
--      Vacaciones protegidas con CASE de validación de campos
--      (NULL/0/rango) para evitar error al construir la DATE.
--   3. Cedula_Empleado centralizada en LATERAL CE con
--      LATERAL(VALUES(...))  elimina el CASE repetido 3 veces.
--   4. Fecha_Nacimiento centralizada en LATERAL FN (1 cálculo).
--   5. Fecha_Ingreso centralizada en LATERAL FI (1 cálculo).
--   6. T1.EmpCed calificado con alias de tabla en todos los usos.
--   7. Capitalización SQL normalizada a mayúsculas.
--   8. Cabecera de documentación añadida.
-- Correcciones v2  v3:
--   9. LATERAL FN (nacimiento) y FI (ingreso) protegidos con
--      validación completa NULL/0/rango mes-dia, igual que las
--      fechas opcionales. Centinela DATE('1900-01-01').
--  10. Relleno de ceros estandarizado a RIGHT('00'||TRIM(CHAR()),2)
--      en todos los LATERAL (FN, FI)  consistencia con fechas
--      opcionales.
-- Tablas base:
--   NomEmp (T1)  Maestro de empleados
--   NomDep (T2)  Departamentos
--   NomCar (T3)  Cargos
--   NomCat (T4)  Categorías
--   NomCmc (T5)  Centros de costo de nómina
--   NomCno (T6)  Conceptos
--   NomNac (T7)  Nacionalidades
--   NomUbi (T8)  Ubicaciones
--   NomPro (T9)  Provincias
--   CogCco (T10) Centros de costo contables
-- ============================================================

CREATE OR REPLACE VIEW VWNOM_MAESTRO_EMPLEADOS AS
SELECT
    -- Identificación del empleado
    T1.EmpCve,
    T1.EmpNom,
    T1.EmpApe,

    -- Cédula formateada ###-#######-# centralizada en LATERAL CE
    CE.Cedula_Empleado,

    -- Clasificaciones
    T1.CnoCve,  T6.CnoDes,
    T1.DepCve,  T2.DepDes,
    T1.CatCve,  T4.CatDes,
    T1.CarCve,  T3.CarDes,
    T1.UbiCve,  T8.UbiDes,

    -- Datos personales
    T1.EmpSex,
    T1.NacCve,  T7.NacDes,
    T1.EmpLna,
    T1.EmpEsc,

    -- Contacto
    T1.EmpTe1, T1.EmpTd1,
    T1.EmpTe2, T1.EmpTd2,
    T1.EmpTe3, T1.EmpTd3,
    T1.EmpDi1, T1.EmpDi2,
    T1.EmpEma,
    T1.EmpNd1, T1.EmpDd1,
    T1.EmpNd2, T1.EmpDd2,

    -- Datos laborales y salariales
    T1.ProCve,  T9.ProDes,
    T1.EmpTSa,
    T1.EmpRnc,  T1.EmpRss,  T1.EmpPes,
    T1.EmpEst,  T1.EmpCPe,  T1.EmpTez,
    T1.EmpSba,  T1.EmpSbp,  T1.EmpSal,
    T1.EmpSop,  T1.EmpShr,  T1.EmpFpg,
    T1.BanCve,  T1.EmpCba,  T1.EmpTcb,
    T1.EmpTip,  T1.EmpTsl,  T1.EmpEva,
    T1.CtaCve,  T1.AuxCve,
    T1.CcoCve,  T10.CcoDes,
    T1.CmcCve,  T5.CmcDes,
    T1.EmpSta,

    -- Fecha de nacimiento centralizada en LATERAL FN
    FN.Fecha_Nacimiento,

    -- Edad en años usando SG_TIEMPO_ANOS (correcto para DB2 for i)
    -- YEAR(CURRENT_DATE - FechaNac) extrae solo la parte entera de
    -- años de una DURATION, sin ajustar por si el cumpleaños ya ocurrió.
    EA.ANOS                                     AS Anos_de_Edad,

    -- Fecha de ingreso centralizada en LATERAL FI
    FI.Fecha_Ingreso,

    -- Años de antigüedad usando SG_TIEMPO_ANOS (correcto)
    A.ANOS                                      AS Anos_En_la_Empresa,

    -- Fechas opcionales con centinela DATE('1900-01-01') si campo inválido
    -- Protección: NULL, 0, o fuera de rango producirían error en DATE()
    CASE
        WHEN T1.EmpAfi IS NULL OR T1.EmpAfi = 0
          OR T1.EmpMfi IS NULL OR T1.EmpMfi = 0
          OR T1.EmpDfi IS NULL OR T1.EmpDfi = 0
          OR T1.EmpAfi < 1900  OR T1.EmpAfi > 9999
          OR T1.EmpMfi < 1     OR T1.EmpMfi > 12
          OR T1.EmpDfi < 1     OR T1.EmpDfi > 31
            THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAfi)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMfi)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDfi)), 2))
    END AS Fecha_Fijacion,

    CASE
        WHEN T1.EmpAva IS NULL OR T1.EmpAva = 0
          OR T1.EmpMva IS NULL OR T1.EmpMva = 0
          OR T1.EmpDva IS NULL OR T1.EmpDva = 0
          OR T1.EmpAva < 1900  OR T1.EmpAva > 9999
          OR T1.EmpMva < 1     OR T1.EmpMva > 12
          OR T1.EmpDva < 1     OR T1.EmpDva > 31
            THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAva)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMva)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDva)), 2))
    END AS Fecha_Inicio_Vacaciones,

    CASE
        WHEN T1.EmpAfv IS NULL OR T1.EmpAfv = 0
          OR T1.EmpMfv IS NULL OR T1.EmpMfv = 0
          OR T1.EmpDfv IS NULL OR T1.EmpDfv = 0
          OR T1.EmpAfv < 1900  OR T1.EmpAfv > 9999
          OR T1.EmpMfv < 1     OR T1.EmpMfv > 12
          OR T1.EmpDfv < 1     OR T1.EmpDfv > 31
            THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAfv)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMfv)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDfv)), 2))
    END AS Fecha_Fin_Vacaciones

FROM NomEmp T1
LEFT OUTER JOIN NomDep T2  ON T1.DepCve = T2.DepCve
LEFT OUTER JOIN NomCar T3  ON T1.CarCve = T3.CarCve
LEFT OUTER JOIN NomCat T4  ON T1.CatCve = T4.CatCve
LEFT OUTER JOIN NomCmc T5  ON T1.CmcCve = T5.CmcCve
LEFT OUTER JOIN NomCno T6  ON T1.CnoCve = T6.CnoCve
LEFT OUTER JOIN NomNac T7  ON T1.NacCve = T7.NacCve
LEFT OUTER JOIN NomUbi T8  ON T1.UbiCve = T8.UbiCve
LEFT OUTER JOIN NomPro T9  ON T1.ProCve = T9.ProCve
LEFT OUTER JOIN CogCco T10 ON T1.CcoCve = T10.CcoCve

-- LATERAL CE: cédula formateada ###-#######-# (un solo CASE aplanado)
-- LATERAL(VALUES(...)) mantiene la correlación con T1 en un solo nivel
CROSS JOIN LATERAL (
    SELECT
        SUBSTR(CED_VAL, 1,  3) || '-' ||
        SUBSTR(CED_VAL, 4,  7) || '-' ||
        SUBSTR(CED_VAL, 11, 1) AS Cedula_Empleado
    FROM SYSIBM.SYSDUMMY1,
         LATERAL (VALUES (
             CASE LENGTH(TRIM(CHAR(T1.EmpCed)))
                 WHEN 9  THEN '00' || TRIM(CHAR(T1.EmpCed))
                 WHEN 10 THEN '0'  || TRIM(CHAR(T1.EmpCed))
                 ELSE         TRIM(CHAR(T1.EmpCed))
             END
         )) AS V(CED_VAL)
) AS CE

-- LATERAL FN: fecha de nacimiento  validacion completa NULL/0/rango
CROSS JOIN LATERAL (
    SELECT CASE
        WHEN T1.EmpAna IS NULL OR T1.EmpAna = 0
          OR T1.EmpMna IS NULL OR T1.EmpMna = 0
          OR T1.EmpDna IS NULL OR T1.EmpDna = 0
          OR T1.EmpAna < 1900  OR T1.EmpAna > 9999
          OR T1.EmpMna < 1     OR T1.EmpMna > 12
          OR T1.EmpDna < 1     OR T1.EmpDna > 31
              THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAna)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMna)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDna)), 2))
    END AS Fecha_Nacimiento
    FROM SYSIBM.SYSDUMMY1
) AS FN

-- LATERAL EA: años de edad usando SG_TIEMPO_ANOS (correcto)
CROSS JOIN LATERAL (
    SELECT ANOS
    FROM TABLE(SEGLIB.SG_TIEMPO_ANOS(FN.Fecha_Nacimiento, CURRENT_DATE))
) AS EA

-- LATERAL FI: fecha de ingreso  validacion completa NULL/0/rango
CROSS JOIN LATERAL (
    SELECT CASE
        WHEN T1.EmpAin IS NULL OR T1.EmpAin = 0
          OR T1.EmpMin IS NULL OR T1.EmpMin = 0
          OR T1.EmpDin IS NULL OR T1.EmpDin = 0
          OR T1.EmpAin < 1900  OR T1.EmpAin > 9999
          OR T1.EmpMin < 1     OR T1.EmpMin > 12
          OR T1.EmpDin < 1     OR T1.EmpDin > 31
              THEN DATE('1900-01-01')
        ELSE DATE(
            TRIM(CHAR(T1.EmpAin)) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpMin)), 2) || '-' ||
            RIGHT('00' || TRIM(CHAR(T1.EmpDin)), 2))
    END AS Fecha_Ingreso
    FROM SYSIBM.SYSDUMMY1
) AS FI

-- LATERAL A: años completos de antigüedad
CROSS JOIN LATERAL (
    SELECT ANOS
    FROM TABLE(SEGLIB.SG_TIEMPO_ANOS(FI.Fecha_Ingreso, CURRENT_DATE))
) AS A

WHERE T1.EmpSta = 'A';

