-- ==============================================================
-- Modulo    : Nomina de Empleados
-- Programa  : SQLNM009
-- Objeto    : VWNOM_ACUMULADOS_CLASE_TIPO_CONCEPTOS
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Descripcion:
--   Presenta acumulados de importes de nomina por empleado, ciclo, periodo
--   y concepto de movimiento, clasificando el importe como Ingreso o Descuento
--   segun el tipo de concepto (CmcTip).
--
--   A diferencia de VWNOM_HISTORICO_NOMINAS_DETALLE (sqlnm008), esta vista
--   no incluye las columnas de Cantidad (NgeCan) ni Valor (NgeVal);
--   su proposito es obtener unicamente los acumulados monetarios agrupados
--   por clase y tipo de concepto.
--
-- Tablas involucradas:
--   NomNgeh  - Movimientos de nomina (detalle historico)
--   NomEmp   - Empleados
--   NomCmc   - Conceptos de movimiento de nomina
--   NomCno   - Tipos de ciclo de nomina
--   NomTno   - Tipos de nomina
--   NomUbi   - Ubicaciones (centros de trabajo)
--   NomDep   - Departamentos
--   NomCar   - Cargos / Puestos
--   NomCat   - Categorias
--
-- Columnas calculadas:
-- Ingresos   - Suma del importe cuando CmcTip = 1  (percepciones)
-- Descuentos - Suma del importe cuando CmcTip <> 1 (deducciones / descuentos)
--
-- Notas:
--   * Se usan LEFT OUTER JOIN para conservar todos los movimientos aunque
--     alguna tabla maestra no tenga registro asociado (datos huerfanos).
--   * CipAno / CipNum identifican el ano y numero de periodo de nomina.
--   * CmcTip determina la naturaleza del concepto:
--       1        Percepcion  (suma en Ingresos)
--       distinto  Deduccion  (suma en Descuentos)
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================
Create Or Replace View VWNOM_ACUMULADOS_CLASE_TIPO_CONCEPTOS
AS
Select
    -- -------------------------------------------------------------------------
    -- Ciclo y tipo de nomina
    -- -------------------------------------------------------------------------
    T1.CnoCve,                          -- Clave del ciclo de nomina
    T4.CnoDes,                          -- Descripcion del ciclo de nomina
    T1.TnoCve,                          -- Clave del tipo de nomina
    T5.TnoDes,                          -- Descripcion del tipo de nomina

    -- -------------------------------------------------------------------------
    -- Datos del empleado
    -- -------------------------------------------------------------------------
    T1.EmpCve,                          -- Clave del empleado
    T2.EmpApe,                          -- Apellidos del empleado
    T2.EmpNom,                          -- Nombre(s) del empleado

    -- -------------------------------------------------------------------------
    -- Clasificacion organizacional del empleado
    -- -------------------------------------------------------------------------
    T2.UbiCve,                          -- Clave de ubicacion
    T6.UbiDes,                          -- Descripcion de ubicacion
    T2.DepCve,                          -- Clave de departamento
    T7.DepDes,                          -- Descripcion de departamento
    T2.CarCve,                          -- Clave de cargo / puesto
    T8.CarDes,                          -- Descripcion de cargo / puesto
    T2.CatCve,                          -- Clave de categoria
    T9.CatDes,                          -- Descripcion de categoria

    -- -------------------------------------------------------------------------
    -- Concepto de movimiento de nomina
    -- -------------------------------------------------------------------------
    T1.CmcCve,                     -- Clave del concepto de movimiento
    T3.CmcDes,                     -- Descripcion del concepto
    T3.CmcTip,                     -- Tipo: 1 = Percepcion, otro = Deduccion

    -- -------------------------------------------------------------------------
    -- Periodo de nomina
    -- -------------------------------------------------------------------------
    T1.CipAno,                          -- Ano del periodo de nomina
    T1.CipNum,                          -- Numero del periodo de nomina

    -- -------------------------------------------------------------------------
    -- Acumulados monetarios por clase y tipo de concepto
    -- -------------------------------------------------------------------------
    Sum(Case When T3.CmcTip =  1 Then T1.NgeImp Else 0 End)        As Ingresos,
    Sum(Case When T3.CmcTip <> 1 Then T1.NgeImp Else 0 End)        As Descuentos

From NomNgeh T1                                       -- Movimientos historicos
Left Outer Join NomEmp T2 On (T1.EmpCve = T2.EmpCve)  -- Datos del empleado
Left Outer Join NomCmc T3 On (T1.CmcCve = T3.CmcCve)  -- Concepto de movimiento
Left Outer Join NomCno T4 On (T1.CnoCve = T4.CnoCve)  -- Ciclo de nomina
Left Outer Join NomTno T5 On (T1.TnoCve = T5.TnoCve)  -- Tipo de nomina
Left Outer Join NomUbi T6 On (T2.UbiCve = T6.UbiCve) --Ubicacion del empleado
Left Outer Join NomDep T7 On (T2.DepCve = T7.DepCve) --Departamento del empleado
Left Outer Join NomCar T8 On (T2.CarCve = T8.CarCve) --Cargo/puesto del empleado
Left Outer Join NomCat T9 On (T2.CatCve = T9.CatCve) --Categoria del empleado

Group By
    T1.CnoCve, T4.CnoDes,
    T1.TnoCve, T5.TnoDes,
    T1.EmpCve, T2.EmpApe,  T2.EmpNom,
    T2.UbiCve, T6.UbiDes,
    T2.DepCve, T7.DepDes,
    T2.CarCve, T8.CarDes,
    T2.CatCve, T9.CatDes,
    T1.CmcCve, T3.CmcDes,  T3.CmcTip,
    T1.CipAno, T1.CipNum

