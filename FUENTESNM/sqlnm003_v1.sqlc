-- VERSIÓN ORIGINAL (respaldo) — ver sqlnm003.sqlc para v2.0
-- PROBLEMAS CONOCIDOS:
--   1. IfNull no estándar — usar COALESCE.
--   2. Alias As en línea separada — dificulta legibilidad.
--   3. Sin CAST explícito en horas/minutos.
--   4. CRÍTICO: Falta T9.FecAno y T9.FecMes en SELECT y GROUP BY.
--      Sin esos campos, las horas de todos los meses/años se acumulan
--      juntas para cada número de día — resultado incorrecto.
--   5. Sin cabecera de documentación.
--   6. Capitalización SQL mixta.
Create Or Replace View VWNOM_DIST_HORAS_EXTRAS_TEMP
As Select T1.EmpCve, T2.EmpNom, T2.EmpApe,
IfNull (Sum(Case When T9.FecDia = 01 Then (T1.HorCht) End), 0) As
Horas_01,
IfNull (Sum(Case When T9.FecDia = 01 Then (T1.HorMin) End), 0) As
Minutos_01,
IfNull (Sum(Case When T9.FecDia = 02 Then (T1.HorCht) End), 0) As
Horas_02,
IfNull (Sum(Case When T9.FecDia = 02 Then (T1.HorMin) End), 0) As
Minutos_02,
IfNull (Sum(Case When T9.FecDia = 03 Then (T1.HorCht) End), 0) As
Horas_03,
IfNull (Sum(Case When T9.FecDia = 03 Then (T1.HorMin) End), 0) As
Minutos_03,
IfNull (Sum(Case When T9.FecDia = 04 Then (T1.HorCht) End), 0) As
Horas_04,
IfNull (Sum(Case When T9.FecDia = 04 Then (T1.HorMin) End), 0) As
Minutos_04,
IfNull (Sum(Case When T9.FecDia = 05 Then (T1.HorCht) End), 0) As
Horas_05,
IfNull (Sum(Case When T9.FecDia = 05 Then (T1.HorMin) End), 0) As
Minutos_05,
IfNull (Sum(Case When T9.FecDia = 06 Then (T1.HorCht) End), 0) As
Horas_06,
IfNull (Sum(Case When T9.FecDia = 06 Then (T1.HorMin) End), 0) As
Minutos_06,
IfNull (Sum(Case When T9.FecDia = 07 Then (T1.HorCht) End), 0) As
Horas_07,
IfNull (Sum(Case When T9.FecDia = 07 Then (T1.HorMin) End), 0) As
Minutos_07,
