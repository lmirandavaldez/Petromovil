IfNull (Sum(Case When T9.FecDia = 13 Then (T1.HorCht) End), 0) As
Horas_13,
IfNull (Sum(Case When T9.FecDia = 13 Then (T1.HorMin) End), 0) As
Minutos_13,
IfNull (Sum(Case When T9.FecDia = 14 Then (T1.HorCht) End), 0) As
Horas_14,
IfNull (Sum(Case When T9.FecDia = 14 Then (T1.HorMin) End), 0) As
