--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : Nomina de Empleados
-- Programa  : SQLNM001X2
-- Objeto    : VWNOM_MAESTRO_EMPLEADOS_V2
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Maestro de empleados activos con antiguedad desglosada en
--   anos, meses y dias usando las funciones de tabla
--   SEGLIB.SG_TIEMPO_*. Las funciones se invocan correctamente
--   via CROSS JOIN LATERAL para evitar SQL0390.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   (Ver SELECT en el SQL)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   NomEmp  (T1)  Maestro de empleados (tabla base)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Fechas calculadas via LATERAL usando DATE(ano-mes-dia)
--   con validacion de NULL y rango.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Ver versiones posteriores (sqlnm001) para mejoras.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, formato 80 cols
-- ==============================================================

Create Or Replace View VWNOM_MAESTRO_EMPLEADOS_V2 (
    EmpCve,
    EmpNom,
    EmpApe,
    Fecha_Ingreso,
    Anos_En_la_Empresa,
    Meses_En_la_Empresa,
    Dias_En_la_Empresa
) AS
SELECT
    T1.EmpCve,
    T1.EmpNom,
    T1.EmpApe,
    FI.Fecha_Ingreso,
    A.ANOS    AS Anos_En_la_Empresa,
    M.MESES   AS Meses_En_la_Empresa,
    D.DIAS    AS Dias_En_la_Empresa

FROM NomEmp T1

-- LATERAL 1: construye Fecha_Ingreso una sola vez
-- evita repetir la misma expresion en cada funcion
CROSS JOIN LATERAL (
    SELECT DATE(
        Concat(Substring('0000', 0, 5 - Length(Trim(T1.EmpAin))),
               Trim(T1.EmpAin)) || '-' ||
        Concat(Substring('00',   0, 3 - Length(Trim(T1.EmpMin))),
               Trim(T1.EmpMin)) || '-' ||
        Concat(Substring('00',   0, 3 - Length(Trim(T1.EmpDin))),
               Trim(T1.EmpDin))
    ) AS Fecha_Ingreso
    FROM SYSIBM.SYSDUMMY1
) AS FI

-- LATERAL 2: anos completos de antiguedad
-- SG_TIEMPO_ANOS es funcion de tabla -> se llama con TABLE(...)
CROSS JOIN LATERAL (
    SELECT ANOS
    FROM TABLE(SEGLIB.SG_TIEMPO_ANOS(
        FI.Fecha_Ingreso,
        CURRENT_DATE
    ))
) AS A

-- LATERAL 3: meses fraccionarios de antiguedad
-- SG_TIEMPO_MESES es funcion de tabla -> se llama con TABLE(...)
CROSS JOIN LATERAL (
    SELECT MESES
    FROM TABLE(SEGLIB.SG_TIEMPO_MESES(
        FI.Fecha_Ingreso,
        CURRENT_DATE
    ))
) AS M

-- LATERAL 4: dias fraccionarios de antiguedad
-- SG_TIEMPO_DIAS es funcion de tabla -> se llama con TABLE(...)
-- IncluirDia = 1 para replicar el comportamiento de SG7006
CROSS JOIN LATERAL (
    SELECT DIAS
    FROM TABLE(SEGLIB.SG_TIEMPO_DIAS(
        FI.Fecha_Ingreso,
        CURRENT_DATE,
        1
    ))
) AS D

WHERE T1.EmpSta = 'A';
