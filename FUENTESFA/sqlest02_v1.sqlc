Create Or Replace View VWEST_Estadisticas_Ventas_Productos
AS SELECT
    T1.ARTCVE,
    T1.DtoANO AS EstAno,
    T1.DtoMes AS EstMes,
    Sum(T1.DtoCua) AS ESTCUA,
    Sum(T1.DtoCup) AS ESTCUD,
    Sum(T1.DtoImp) AS ESTIBV,
    Sum(T1.DtoMpd) AS ESTIDV,
    Sum(T1.DtoIm1 + T1.DtoIm2) AS ESTIIV,
    Sum((T1.DtoImp - T1.DtoMpd) + T1.DtoIm1 + T1.DtoIm2) AS ESTINV,
    Sum(T1.DtoMcp) AS ESTCPR,
    Sum(T1.DtoMcu) AS ESTCUL
FROM FACDTOD T1
Group By T1.ArtCve, T1.DtoAno, T1.DtoMes
