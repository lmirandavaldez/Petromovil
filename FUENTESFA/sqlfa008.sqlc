-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWFAC_Fec_Ult_Documento As

Select
    -- --------------------------------------------------------
    -- Dimension de agrupacion
    -- --------------------------------------------------------
    T1.CliCve         As CliCve,   -- Codigo del cliente

    -- --------------------------------------------------------
    -- Metrica: fecha del ultimo documento valido
    -- --------------------------------------------------------
    -- Max() sobre FecYmd (YYYYMMDD). Cuando FecYmd = NULL
    -- (documento sin entrada en SegFec), Max() lo ignora;
    -- el resultado sera NULL solo si el cliente no tiene
    -- ningun documento con fecha en el calendario.
    Max(T9.FecYmd)    As DtoFec    -- Fecha (YYYYMMDD) del ultimo 
                                   -- documento valido

From FacDtoh As T1

-- Calendario: convierte ano+mes+dia en valor numerico FecYmd.
-- LEFT OUTER JOIN para que documentos con combinacion
-- ano+mes+dia no cargada en SegFec no queden excluidos;
-- Max() ignorara esos FecYmd = NULL correctamente.
Join SegFec As T9
    On  T1.DtoAno = T9.FecAno
    And T1.DtoMes = T9.FecMes
    And T1.DtoDia = T9.FecDia

Where
    -- Solo documentos activos / aplicados
    -- DtoSta: 'A' = Activo; 'C' = Cancelados
    COALESCE(T1.DtoSta, '') = 'A'

    -- Excluye tipo 2 (devolucion), tipo 3 (Promociones) 
    -- y Tipo 8 (notas Debito) 
    And (COALESCE(T1.DtoTip, 0) Not In(2,3,8))

Group By
    T1.CliCve

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.CliCve
