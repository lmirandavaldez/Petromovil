-- Crear el procedimiento para actualizar clientes inactivos

CREATE OR REPLACE PROCEDURE PRO_ACTUALIZAR_MESES_INACTIVO()
LANGUAGE SQL
BEGIN
    UPDATE CLIENTE_INACTIVIDAD
    SET MESES_INACTIVO = MONTHS_BETWEEN(CURRENT_DATE, FECHA_ULTIMA_COMPRA),
        ESTADO_CLIENTE = CASE
            WHEN MONTHS_BETWEEN(CURRENT_DATE, FECHA_ULTIMA_COMPRA) >= 36 THEN
'INACTIVO'
            ELSE 'ACTIVO'
        END,
        ES_NUEVO = CASE
            WHEN MONTHS_BETWEEN(CURRENT_DATE, FECHA_ULTIMA_COMPRA) >= 36 THEN
'N'
            ELSE ES_NUEVO
        END,
    FECHA_ULTIMA_INACTIVIDAD = CASE
            WHEN ESTADO_CLIENTE = 'INACTIVO' AND FECHA_ULTIMA_INACTIVIDAD <
FECHA_ULTIMA_COMPRA THEN FECHA_ULTIMA_COMPRA
            ELSE FECHA_ULTIMA_INACTIVIDAD
        END;
END;
