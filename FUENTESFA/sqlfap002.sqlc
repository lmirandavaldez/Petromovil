--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================
CL: CHGCURLIB  CURLIB("FACLIB.V2") ;

CREATE OR REPLACE PROCEDURE "FACLIB.V2".PRO_ACTUALIZAR_MESES_INACTIVO ()
SPECIFIC          PRO_ACTUALIZAR_MESES_INACTIVO
LANGUAGE          SQL

BEGIN

    -- -------------------------------------------------------
    -- Actualizacion masiva de inactividad de clientes.
    -- UPDATE directo compatible con IBM i DB2.
    -- MONTHS_BETWEEN se evalua en cada CASE por ser la
    -- unica forma soportada (sin subconsulta correlacionada
    -- en el SET en esta plataforma).
    -- Umbral de inactividad: >= 36 meses (3 anos).
    -- -------------------------------------------------------
    UPDATE CLIENTE_INACTIVIDAD
    SET
        -- Meses transcurridos desde la ultima compra a hoy
        MESES_INACTIVO =
            MONTHS_BETWEEN(
                CURRENT_DATE,
                FECHA_ULTIMA_COMPRA
            ),

        -- Estado segun umbral de 36 meses
        ESTADO_CLIENTE = CASE
            WHEN MONTHS_BETWEEN(
                     CURRENT_DATE, FECHA_ULTIMA_COMPRA
                 ) >= 36
                THEN CAST('INACTIVO' AS CHAR(10))
            ELSE     CAST('ACTIVO'  AS CHAR(10))
        END,

        -- ES_NUEVO: 'N' si inactivo >= 36 meses;
        -- sin cambio si aun activo
        ES_NUEVO = CASE
            WHEN MONTHS_BETWEEN(
                     CURRENT_DATE, FECHA_ULTIMA_COMPRA
                 ) >= 36
                THEN CAST('N' AS CHAR(1))
            ELSE ES_NUEVO
        END,

        -- FECHA_ULTIMA_INACTIVIDAD: se actualiza si los
        -- meses >= 36 (cliente pasa a INACTIVO) Y la fecha
        -- de inactividad registrada es anterior a la ultima
        -- compra (evita sobreescribir una mas reciente).
        -- CORRECCION v2: el original usaba ESTADO_CLIENTE
        -- (valor ANTES del UPDATE), nunca capturando la
        -- primera vez que el cliente pasa a inactivo.
        -- Se usa MONTHS_BETWEEN directamente (consistente).
        FECHA_ULTIMA_INACTIVIDAD = CASE
            WHEN MONTHS_BETWEEN(
                     CURRENT_DATE, FECHA_ULTIMA_COMPRA
                 ) >= 36
             AND FECHA_ULTIMA_INACTIVIDAD < FECHA_ULTIMA_COMPRA
                THEN FECHA_ULTIMA_COMPRA
            ELSE FECHA_ULTIMA_INACTIVIDAD
        END;

END;
