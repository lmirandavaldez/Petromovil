-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWFAC_Pedidos_Entregados As

Select
    -- --------------------------------------------------------
    -- Identificacion del pedido / planilla
    -- --------------------------------------------------------
    T1.PlaDis        As PlaDis,   -- Distribucion / division de la planilla
    T1.PlaNro        As PlaNro,   -- Numero de planilla
    T1.CiaCve        As CiaCve,   -- Codigo de compania
    T1.DisCve        As DisCve,   -- Codigo de distribucion
    T1.OrdNro        As OrdNro,   -- Numero de orden del pedido
    T1.OrdAmd        As OrdAmd,   -- Numero de enmienda / version de la orden

    -- --------------------------------------------------------
    -- Datos del cliente
    -- --------------------------------------------------------
    T1.CliCve        As CliCve,   -- Codigo del cliente
    T1.CliNom        As CliNom,   -- Nombre del cliente
    T1.CliDir        As CliDir,   -- Direccion de entrega del cliente
    T1.CliLoc        As CliLoc,   -- Localidad del cliente
    T1.CliCiu        As CliCiu,   -- Ciudad del cliente
    T1.CliTe1        As CliTe1,   -- Telefono 1 del cliente
    T1.CliTe2        As CliTe2,   -- Telefono 2 del cliente

    -- --------------------------------------------------------
    -- Datos del vendedor
    -- --------------------------------------------------------
    T1.VenCve        As VenCve,   -- Codigo del vendedor
    T1.VenNom        As VenNom,   -- Nombre del vendedor
    T1.VenEma        As VenEma,   -- Correo electronico del vendedor

    -- --------------------------------------------------------
    -- Datos de entrega (cabecera de planilla FacPlah)
    -- --------------------------------------------------------
    T2.VehFic        As VehFic,   -- Ficha / placa del vehiculo de entrega
    T2.ChoCve        As ChoCve,   -- Codigo del chofer
    T2.PlaFpl        As PlaFpl,   -- Fecha planificada de entrega
    T2.PlaFen        As PlaFen    -- Fecha efectiva de entrega

From FacPlad As T1

-- INNER JOIN intencional: solo se incluyen detalles de pedido
-- que tengan cabecera de planilla registrada en FacPlah.
-- La clave compuesta es PlaDis + PlaNro.
Inner Join FacPlah As T2
    On  T1.PlaDis = T2.PlaDis
    And T1.PlaNro = T2.PlaNro

Where
    -- Solo planillas terminadas (entregadas completamente)
    T2.SitCve = 'T'             -- SitCve: 'T' = Terminada
    -- Solo detalles de pedido realizados (no cancelados)
    And T1.PlaSta = 'R'         -- PlaSta: 'R' = Realizado

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PlaDis, T1.PlaNro, T1.OrdNro
