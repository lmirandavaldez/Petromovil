-- ============================================================
-- Vista   : VWFAC_Ventas_Distrito_Meses
-- Módulo  : Facturación
-- Objeto  : Pivot de ventas por mes (enero–diciembre) a nivel
--           de distrito, artículo y año.
--           Por cada combinación devuelve tres métricas
--           mensuales: cantidad vendida, importe bruto y
--           costo promedio; más los totales anuales de cada
--           métrica.
--           Incluye todos los tipos de documento (sin filtro
--           de DtoTip); si se requiere excluir devoluciones
--           agregar: Where COALESCE(T1.DtoTip, 0) <> 3
-- Tablas  : FacDtod  — detalle de documentos de facturación
--           SegDis   — maestro de distribuciones / distritos
--           InvArt   — maestro de artículos
--           InvCat   — categorías de artículos (LEFT JOIN:
--                      puede ser NULL si artículo sin categoría)
-- Esquema : (default)
-- Autor   : L. Miranda
-- Copyright: Miranda Valdez, S. A., 1997
-- Versión : 2  (mejorada)
-- Cambios :
--   v2 - Se consolida cada expresión del pivot en una sola
--          línea (alias en la misma línea que el IfNull),
--          eliminando las 36 rupturas de línea del original.
--        Se eliminan paréntesis redundantes en los Then del
--          CASE (Then T1.DtoCan en lugar de Then (T1.DtoCan)).
--        Se convierten INNER JOIN SegDis e INNER JOIN InvArt
--          a LEFT OUTER JOIN para preservar detalles cuya
--          distribución o artículo no tengan registro en sus
--          tablas maestras (DisDes/ArtDes = NULL).
--        Se agrega alias explícito As en todos los FROM/JOIN.
--        Se reformatea SELECT con secciones comentadas y
--          una dimensión por línea.
--        Se reformatea GROUP BY con una columna por línea.
--        Se agrega nota sobre filtrado de DtoTip (comentado).
--        Se agrega ORDER BY sugerido (comentado).
--        Cabecera de documentación completa.
-- ============================================================

Create Or Replace View VWFAC_Ventas_Distrito_Meses As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupación
    -- --------------------------------------------------------
    T1.DisCve   As DisCve,  -- Código del distrito / distribución
    T2.DisDes   As DisDes,  -- Descripción del distrito
    T1.DtoAno   As DtoAno,  -- Año del período
    T1.ArtCve   As ArtCve,  -- Código del artículo
    T3.ArtDes   As ArtDes,  -- Descripción del artículo
    T3.CatCve   As CatCve,  -- Código de categoría
    T4.CatDes   As CatDes,  -- Descripción de categoría 
                            -- (NULL si sin categoría)
    T3.ArtPpr   As ArtPpr,  -- Precio de referencia del artículo

    -- --------------------------------------------------------
    -- Pivot mensual — Cantidad, Importe y Costo por mes
    -- --------------------------------------------------------
    -- Enero
    IfNull(Sum(Case When T1.DtoMes = 01 Then T1.DtoCan End), 0)        
    As Cantidad_Ene,
    IfNull(Sum(Case When T1.DtoMes = 01 Then T1.DtoImp End), 0)        
    As Importe_Ene,
    IfNull(Sum(Case When T1.DtoMes = 01 Then T1.DtoMcp End), 0)        
    As Costo_Ene,
    -- Febrero
    IfNull(Sum(Case When T1.DtoMes = 02 Then T1.DtoCan End), 0)        
    As Cantidad_Feb,
    IfNull(Sum(Case When T1.DtoMes = 02 Then T1.DtoImp End), 0)        
    As Importe_Feb,
    IfNull(Sum(Case When T1.DtoMes = 02 Then T1.DtoMcp End), 0)        
    As Costo_Feb,
    -- Marzo
    IfNull(Sum(Case When T1.DtoMes = 03 Then T1.DtoCan End), 0)        
    As Cantidad_Mar,
    IfNull(Sum(Case When T1.DtoMes = 03 Then T1.DtoImp End), 0)        
    As Importe_Mar,
    IfNull(Sum(Case When T1.DtoMes = 03 Then T1.DtoMcp End), 0)        
    As Costo_Mar,
    -- Abril
    IfNull(Sum(Case When T1.DtoMes = 04 Then T1.DtoCan End), 0)        
    As Cantidad_Abr,
    IfNull(Sum(Case When T1.DtoMes = 04 Then T1.DtoImp End), 0)        
    As Importe_Abr,
    IfNull(Sum(Case When T1.DtoMes = 04 Then T1.DtoMcp End), 0)        
    As Costo_Abr,
    -- Mayo
    IfNull(Sum(Case When T1.DtoMes = 05 Then T1.DtoCan End), 0)        
    As Cantidad_May,
    IfNull(Sum(Case When T1.DtoMes = 05 Then T1.DtoImp End), 0)        
    As Importe_May,
    IfNull(Sum(Case When T1.DtoMes = 05 Then T1.DtoMcp End), 0)        
    As Costo_May,
    -- Junio
    IfNull(Sum(Case When T1.DtoMes = 06 Then T1.DtoCan End), 0)        
    As Cantidad_Jun,
    IfNull(Sum(Case When T1.DtoMes = 06 Then T1.DtoImp End), 0)        
    As Importe_Jun,
    IfNull(Sum(Case When T1.DtoMes = 06 Then T1.DtoMcp End), 0)        
    As Costo_Jun,
    -- Julio
    IfNull(Sum(Case When T1.DtoMes = 07 Then T1.DtoCan End), 0)        
    As Cantidad_Jul,
    IfNull(Sum(Case When T1.DtoMes = 07 Then T1.DtoImp End), 0)        
    As Importe_Jul,
    IfNull(Sum(Case When T1.DtoMes = 07 Then T1.DtoMcp End), 0)        
    As Costo_Jul,
    -- Agosto
    IfNull(Sum(Case When T1.DtoMes = 08 Then T1.DtoCan End), 0)        
    As Cantidad_Ago,
    IfNull(Sum(Case When T1.DtoMes = 08 Then T1.DtoImp End), 0)        
    As Importe_Ago,
    IfNull(Sum(Case When T1.DtoMes = 08 Then T1.DtoMcp End), 0)        
    As Costo_Ago,
    -- Septiembre
    IfNull(Sum(Case When T1.DtoMes = 09 Then T1.DtoCan End), 0)        
    As Cantidad_Sep,
    IfNull(Sum(Case When T1.DtoMes = 09 Then T1.DtoImp End), 0)        
    As Importe_Sep,
    IfNull(Sum(Case When T1.DtoMes = 09 Then T1.DtoMcp End), 0)        
    As Costo_Sep,
    -- Octubre
    IfNull(Sum(Case When T1.DtoMes = 10 Then T1.DtoCan End), 0)        
    As Cantidad_Oct,
    IfNull(Sum(Case When T1.DtoMes = 10 Then T1.DtoImp End), 0)        
    As Importe_Oct,
    IfNull(Sum(Case When T1.DtoMes = 10 Then T1.DtoMcp End), 0)        
    As Costo_Oct,
    -- Noviembre
    IfNull(Sum(Case When T1.DtoMes = 11 Then T1.DtoCan End), 0)        
    As Cantidad_Nov,
    IfNull(Sum(Case When T1.DtoMes = 11 Then T1.DtoImp End), 0)        
    As Importe_Nov,
    IfNull(Sum(Case When T1.DtoMes = 11 Then T1.DtoMcp End), 0)        
    As Costo_Nov,
    -- Diciembre
    IfNull(Sum(Case When T1.DtoMes = 12 Then T1.DtoCan End), 0)        
    As Cantidad_Dic,
    IfNull(Sum(Case When T1.DtoMes = 12 Then T1.DtoImp End), 0)        
    As Importe_Dic,
    IfNull(Sum(Case When T1.DtoMes = 12 Then T1.DtoMcp End), 0)        
    As Costo_Dic,

    -- --------------------------------------------------------
    -- Totales anuales
    -- --------------------------------------------------------
    IfNull(Sum(T1.DtoCan), 0)     As Total_Cantidad,
    IfNull(Sum(T1.DtoImp), 0)     As Total_Importe,
    IfNull(Sum(T1.DtoMcp), 0)     As Total_Costo

-- ============================================================
-- FROM y JOINs
-- ============================================================
From FacDtod As T1

-- Cambiar a INNER JOIN si solo se quieren distritos válidos.
Join SegDis As T2
    On T1.DisCve = T2.DisCve

-- Cambiar a INNER JOIN si solo se quieren artículos del maestro.
Join InvArt As T3
    On T1.ArtCve = T3.ArtCve

-- Categoría: LEFT es correcto — un artículo puede no tener
-- categoría asignada (CatDes = NULL en esos casos).
Left Outer Join InvCat As T4
    On T3.CatCve = T4.CatCve

-- Nota: sin filtro de DtoTip — incluye todos los tipos de
-- documento (facturas, devoluciones, notas, etc.).
-- Para excluir Promociones (tipo 3) agregar:
-- Where COALESCE(T1.DtoTip, 0) <> 3

-- ============================================================
-- GROUP BY — todas las dimensiones del SELECT no agregadas
-- ============================================================
Group By
    T1.DisCve,
    T2.DisDes,
    T1.DtoAno,
    T1.ArtCve,
    T3.ArtDes,
    T3.CatCve,
    T4.CatDes,
    T3.ArtPpr

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.DtoAno, T1.DisCve, T1.ArtCve
