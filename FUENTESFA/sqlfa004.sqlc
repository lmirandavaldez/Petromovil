-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWFAC_Ventas_Sup_Ven_Cli_Art_Ano_Meses As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T1.DtoAno       As DtoAno,   -- Ano del periodo
    T4.SupCve       As SupCve,   -- Codigo del supervisor
    T5.SupNom       As SupNom,   -- Nombre del supervisor
    T3.VenCve       As VenCve,   -- Codigo del vendedor
    T4.VenNom       As VenNom,   -- Nombre del vendedor
    T1.CliCve       As CliCve,   -- Codigo del cliente
    T6.CliNom       As CliNom,   -- Nombre del cliente
    T1.ArtCve       As ArtCve,   -- Codigo del articulo
    T2.ArtDes       As ArtDes,   -- Descripcion del articulo

    -- --------------------------------------------------------
    -- Pivot mensual — Cantidad vendida por mes
    -- --------------------------------------------------------
    Coalesce(Sum(Case When T1.DtoMes = 01 Then T1.DtoCua End), 0)  
    As Ene,      -- Cantidad enero
    Coalesce(Sum(Case When T1.DtoMes = 02 Then T1.DtoCua End), 0)  
    As Feb,      -- Cantidad febrero
    Coalesce(Sum(Case When T1.DtoMes = 03 Then T1.DtoCua End), 0)  
    As Mar,      -- Cantidad marzo
    Coalesce(Sum(Case When T1.DtoMes = 04 Then T1.DtoCua End), 0)  
    As Abr,      -- Cantidad abril
    Coalesce(Sum(Case When T1.DtoMes = 05 Then T1.DtoCua End), 0)  
    As May,      -- Cantidad mayo
    Coalesce(Sum(Case When T1.DtoMes = 06 Then T1.DtoCua End), 0)  
    As Jun,      -- Cantidad junio
    Coalesce(Sum(Case When T1.DtoMes = 07 Then T1.DtoCua End), 0)  
    As Jul,      -- Cantidad julio
    Coalesce(Sum(Case When T1.DtoMes = 08 Then T1.DtoCua End), 0)  
    As Ago,      -- Cantidad agosto
    Coalesce(Sum(Case When T1.DtoMes = 09 Then T1.DtoCua End), 0)  
    As Sep,      -- Cantidad septiembre
    Coalesce(Sum(Case When T1.DtoMes = 10 Then T1.DtoCua End), 0)  
    As Oct,      -- Cantidad octubre
    Coalesce(Sum(Case When T1.DtoMes = 11 Then T1.DtoCua End), 0)  
    As Nov,      -- Cantidad noviembre
    Coalesce(Sum(Case When T1.DtoMes = 12 Then T1.DtoCua End), 0)  
    As Dic,      -- Cantidad diciembre

    -- --------------------------------------------------------
    -- Total anual de cantidad
    -- --------------------------------------------------------
    Coalesce(Sum(T1.DtoCua), 0)             
    As Total     -- Total anual de cantidad

From FacDtod As T1

-- Articulo: LEFT para conservar lineas con articulos no
-- catalogados en InvArt (ArtDes = NULL en esos casos).
-- Cambiar a INNER JOIN si se desea filtrar solo articulos
-- existentes en el maestro.
Join InvArt As T2
    On T1.ArtCve = T2.ArtCve

-- Para Buscar el vendedor en CxcRvc.
Join CxcRvc T3
    On T1.CliCve = T3.CliCve

-- Datos del vendedor (incluye SupCve y VenNom)
Join CxcVen As T4
    On T3.VenCve = T4.VenCve

-- Datos del supervisor
Join CxcSup As T5
    On T4.SupCve = T5.SupCve

-- Datos del cliente (nombre)
Join CxcCli As T6
    On T1.CliCve = T6.CliCve

Where
    -- Excluir tipo 3 (Promociones)
    -- COALESCE defensivo: si DtoTip fuera NULL se trata como 0
    COALESCE(T1.DtoTip, 0) <> 3

Group By
    T1.DtoAno,
    T4.SupCve,
    T5.SupNom,
    T3.VenCve,
    T4.VenNom,
    T1.CliCve,
    T6.CliNom,
    T1.ArtCve,
    T2.ArtDes

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.DtoAno, T4.SupCve, T3.VenCve, T1.CliCve, T1.ArtCve
