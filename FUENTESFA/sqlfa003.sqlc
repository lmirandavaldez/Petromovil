-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWFAC_Ventas_Vendedor_Cliente_Articulos_Dias As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T1.DtoAno               As DtoAno,      -- Ano del periodo
    T1.DtoMes               As DtoMes,      -- Mes del periodo (1–12)
    T3.VenCve               As VenCve,      -- Codigo del vendedor 
                                            -- (NULL si sin asignacion)
    T1.CliCve               As CliCve,      -- Codigo del cliente
    T1.ArtCve               As ArtCve,      -- Codigo del articulo

    -- --------------------------------------------------------
    -- Pivot diario — Cantidad vendida por dia del mes
    -- --------------------------------------------------------
    Coalesce(Sum(Case When T1.DtoDia = 01 Then T1.DtoCua End), 0)       As Dia01,
    Coalesce(Sum(Case When T1.DtoDia = 02 Then T1.DtoCua End), 0)       As Dia02,
    Coalesce(Sum(Case When T1.DtoDia = 03 Then T1.DtoCua End), 0)       As Dia03,
    Coalesce(Sum(Case When T1.DtoDia = 04 Then T1.DtoCua End), 0)       As Dia04,
    Coalesce(Sum(Case When T1.DtoDia = 05 Then T1.DtoCua End), 0)       As Dia05,
    Coalesce(Sum(Case When T1.DtoDia = 06 Then T1.DtoCua End), 0)       As Dia06,
    Coalesce(Sum(Case When T1.DtoDia = 07 Then T1.DtoCua End), 0)       As Dia07,
    Coalesce(Sum(Case When T1.DtoDia = 08 Then T1.DtoCua End), 0)       As Dia08,
    Coalesce(Sum(Case When T1.DtoDia = 09 Then T1.DtoCua End), 0)       As Dia09,
    Coalesce(Sum(Case When T1.DtoDia = 10 Then T1.DtoCua End), 0)       As Dia10,
    Coalesce(Sum(Case When T1.DtoDia = 11 Then T1.DtoCua End), 0)       As Dia11,
    Coalesce(Sum(Case When T1.DtoDia = 12 Then T1.DtoCua End), 0)       As Dia12,
    Coalesce(Sum(Case When T1.DtoDia = 13 Then T1.DtoCua End), 0)       As Dia13,
    Coalesce(Sum(Case When T1.DtoDia = 14 Then T1.DtoCua End), 0)       As Dia14,
    Coalesce(Sum(Case When T1.DtoDia = 15 Then T1.DtoCua End), 0)       As Dia15,
    Coalesce(Sum(Case When T1.DtoDia = 16 Then T1.DtoCua End), 0)       As Dia16,
    Coalesce(Sum(Case When T1.DtoDia = 17 Then T1.DtoCua End), 0)       As Dia17,
    Coalesce(Sum(Case When T1.DtoDia = 18 Then T1.DtoCua End), 0)       As Dia18,
    Coalesce(Sum(Case When T1.DtoDia = 19 Then T1.DtoCua End), 0)       As Dia19,
    Coalesce(Sum(Case When T1.DtoDia = 20 Then T1.DtoCua End), 0)       As Dia20,
    Coalesce(Sum(Case When T1.DtoDia = 21 Then T1.DtoCua End), 0)       As Dia21,
    Coalesce(Sum(Case When T1.DtoDia = 22 Then T1.DtoCua End), 0)       As Dia22,
    Coalesce(Sum(Case When T1.DtoDia = 23 Then T1.DtoCua End), 0)       As Dia23,
    Coalesce(Sum(Case When T1.DtoDia = 24 Then T1.DtoCua End), 0)       As Dia24,
    Coalesce(Sum(Case When T1.DtoDia = 25 Then T1.DtoCua End), 0)       As Dia25,
    Coalesce(Sum(Case When T1.DtoDia = 26 Then T1.DtoCua End), 0)       As Dia26,
    Coalesce(Sum(Case When T1.DtoDia = 27 Then T1.DtoCua End), 0)       As Dia27,
    Coalesce(Sum(Case When T1.DtoDia = 28 Then T1.DtoCua End), 0)       As Dia28,
    Coalesce(Sum(Case When T1.DtoDia = 29 Then T1.DtoCua End), 0)       As Dia29,
    Coalesce(Sum(Case When T1.DtoDia = 30 Then T1.DtoCua End), 0)       As Dia30,
    Coalesce(Sum(Case When T1.DtoDia = 31 Then T1.DtoCua End), 0)       As Dia31,

    -- --------------------------------------------------------
    -- Total mensual de cantidad
    -- --------------------------------------------------------
    Coalesce(Sum(T1.DtoCua), 0)    As Total_Cantidad

From FacDtod As T1

-- Articulos: LEFT para conservar lineas con articulos no
-- catalogados en InvArt. Cambiar a INNER JOIN si se desea
-- filtrar solo articulos existentes en el maestro.
Left Outer Join InvArt As T2
    On T1.ArtCve = T2.ArtCve

-- Vendedor por cliente — subconsulta 1:1 para evitar
-- multiplicacion de filas cuando un cliente tiene mas de un
-- vendedor en CxcRvc. LEFT para conservar ventas sin vendedor.
Left Outer Join (
    Select CliCve, VenCve
    From   CxcRvc
    Fetch First 1 Row Only
) As T3
    On T1.CliCve = T3.CliCve

Where
    -- Excluir tipo 3 (notas de credito / devoluciones)
    -- COALESCE defensivo: si DtoTip fuera NULL, se trata como 0
    COALESCE(T1.DtoTip, 0) <> 3

Group By
    T1.DtoAno,
    T1.DtoMes,
    T3.VenCve,
    T1.CliCve,
    T1.ArtCve

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.DtoAno, T1.DtoMes, T3.VenCve, T1.CliCve, T1.ArtCve
