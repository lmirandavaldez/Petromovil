-- Objeto    : VWFAC_Pedidos_Autorizados
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWFAC_Pedidos_Autorizados As

Select
    -- --------------------------------------------------------
    -- Distribucion / Division
    -- --------------------------------------------------------
    T1.DisCve      As DisCve,   -- Codigo de distribucion del pedido
    T2.DisDes      As DisDes,   -- Descripcion de la distribucion 
                                -- (NULL si no en catalogo)

    -- --------------------------------------------------------
    -- Identificacion del pedido
    -- --------------------------------------------------------
    T1.OrdNro      As OrdNro,   -- Numero de orden / pedido autorizado

    -- --------------------------------------------------------
    -- Datos de la autorizacion
    -- --------------------------------------------------------
    T9.FecIso      As FecIso,   -- Fecha ISO de autorizacion 
                                -- (YYYY-MM-DD, desde SegFec)
    T1.PauHor      As PauHor,   -- Hora de la autorizacion
    T1.PauWsi      As PauWsi,   -- Identificador de sesion / workstation
    T1.PauUsr      As PauUsr,   -- Codigo del usuario que autorizo
    T4.UsrNom      As UsrNom,   -- Nombre del usuario que autorizo

    -- --------------------------------------------------------
    -- Datos del cliente
    -- --------------------------------------------------------
    T1.CliCve      As CliCve,   -- Codigo del cliente
    T3.CliNom      As CliNom,   -- Nombre del cliente

    -- --------------------------------------------------------
    -- Montos y tipo de pedido
    -- --------------------------------------------------------
    T1.PauMon      As PauMon,   -- Monto autorizado del pedido
    T1.PauTip      As PauTip    -- Tipo de pedido / autorizacion

From FacPau As T1

-- Distribucion del pedido; LEFT para conservar autorizaciones
Join SegDis As T2
    On T1.DisCve = T2.DisCve

-- Cliente del pedido; LEFT para conservar autorizaciones
Join CxcCli As T3
    On T1.CliCve = T3.CliCve

-- Usuario que autorizo; LEFT para conservar autorizaciones
Join SegUsr As T4
    On T1.PauUsr = T4.UsrCve

-- Calendario: convierte PauFec (FecYmd) en fecha ISO.
-- LEFT para que autorizaciones con fecha no cargada en SegFec
Join SegFec As T9
    On T1.PauFec = T9.FecYmd

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.DisCve, T9.FecIso, T1.OrdNro
