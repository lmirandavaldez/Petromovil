-- ==============================================================
-- Modulo    : Facturacion
-- Programa  : SQLFA013
-- Objeto    : VWFAC_SUBDIVIDIR_MONTOS_UNICO_INGRESO_TEMPORAL
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View
    VWFAC_SUBDIVIDIR_MONTOS_UNICO_INGRESO_TEMPORAL As

-- ===========================================================
-- CTE: leer ParMti una sola vez en lugar de dos subconsultas
-- ParCve='@' = monto maximo por transaccion de unico ingreso
-- ===========================================================
With Par_Monto As (
    Select ParMti
    From   ItePar
    Where  ParCve = '@'
    Fetch First 1 Row Only
)

Select
    -- -------------------------------------------------------
    -- Dimensiones de agrupacion
    -- -------------------------------------------------------
    T1.DisCve           As Codigo_Del_Distrito,
    T2.AlmCve           As Codigo_Almacen,
    T1.OrdNro           As Numero_Pedido,
    T2.CliCve           As Codigo_Cliente,
    T9.FecYmd           As Fecha_Pedido,
    T1.ArtCve           As Codigo_Articulo,

    -- -------------------------------------------------------
    -- Metricas del pedido
    -- -------------------------------------------------------
    Sum(T1.OrdCan)      As Total_Cantidad,
    Avg(T1.OrdPve)      As Precio_Promedio,
    Sum(T1.OrdImp)      As Importe,

    -- Veces = Ceil(Importe / ParMti)
    --       = Int((Importe + ParMti - 1) / ParMti)
    -- Divide el importe total en bloques de tamano ParMti
    Int((Sum(T1.OrdImp) + P.ParMti - 1)
        / P.ParMti)     As Veces

From Facortd As T1

-- Encabezado del pedido (almacen, cliente, fecha)
Inner Join Facorth As T2
    On  T1.DisCve = T2.DisCve
    And T1.OrdNro = T2.OrdNro

-- Distrito tipo 'S'=Supermercado o 'E'=Especial
Inner Join SegDis As T3
    On  T1.DisCve = T3.DisCve
    And T3.DisTip In ('S', 'E')

-- Tipo de comprobante del cliente para Unico Ingreso:
-- TcfCve 12=Registro Unico de Ingresos,
-- 32=Fact. p/Regimen Especial de Tributacion.
-- JOIN directo: el GROUP BY consolida duplicados si
-- el cliente tiene mas de un registro en CxcAdc
Inner Join CxcAdc As T4
    On  T1.DisCve = T4.DisCve
    And T2.CliCve = T4.CliCve
    And T4.TcfCve In (12, 32)

-- Almacen de venta activo ('S') tipo 'G'=General o
-- 'E'=Especial. JOIN directo: el GROUP BY consolida
-- duplicados si hay mas de un almacen coincidente
Inner Join InvAlm As T5
    On  T1.DisCve = T5.DisCve
    And T2.AlmCve = T5.AlmCve
    And T5.AlmVen = 'S'
    And T5.AlmTip In ('G', 'E')

-- Calendario: fecha del pedido (ano+mes+dia -> FecYmd)
-- LEFT para conservar pedidos con fecha no en SegFec
Left Outer Join SegFec As T9
    On  T2.OrdAno = T9.FecAno
    And T2.OrdMes = T9.FecMes
    And T2.OrdDia = T9.FecDia

-- Parametro de monto maximo (leido una sola vez por CTE)
Cross Join Par_Monto As P

Group By
    T1.DisCve,
    T2.AlmCve,
    T1.OrdNro,
    T2.CliCve,
    T9.FecYmd,
    T1.ArtCve,
    P.ParMti

Having
    -- Solo renglones con movimiento real
    Sum(T1.OrdCan) > 0
    And Sum(T1.OrdImp) > 0

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.DisCve, T9.FecYmd, T1.OrdNro, T1.ArtCve
