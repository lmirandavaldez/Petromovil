-- ============================================================
-- Vista   : VWEST_Estadisticas_Ventas_Clientes
-- Módulo  : Estadísticas de Ventas
-- Objeto  : Resume las estadísticas de ventas desglosadas por
--           cliente, año y mes a partir del detalle de
--           documentos de facturación (FacDtod).
--           Incluye importes brutos, descuentos, impuestos,
--           neto a cobrar y costos.
-- Tabla   : FacDtod  — detalle de documentos de facturación
-- Esquema : (default)
-- Autor   : L. Miranda
-- Versión : 2  (mejorada)
-- Cambios :
--   v2 - CORRECCIÓN DE BUG: T1.VenCve As CliCve en el SELECT
--          original referenciaba una columna inexistente en
--          FacDtod (VenCve pertenece a CxcRvc, no a FacDtod).
--          La columna correcta es T1.CliCve, que ya estaba
--          correctamente usada en el GROUP BY.
--        Se agrega alias explícito As en FROM.
--        Se documentan todas las columnas con su significado
--          de negocio.
--        Se descompone ESTINV con comentario de fórmula.
--        Se expande GROUP BY a una columna por línea.
--        Se agrega ORDER BY sugerido (comentado).
--        Mejora de formato e indentación.
--        Cabecera de documentación completa.
-- ============================================================

Create Or Replace View VWEST_Estadisticas_Ventas_Clientes As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupación
    -- --------------------------------------------------------
    -- CORRECCIÓN: era T1.VenCve (campo inexistente en FacDtod).
    -- El campo correcto es T1.CliCve, consistente con GROUP BY.
    T1.CliCve                   As CliCve,   -- Código del cliente
    T1.DtoAno                   As EstAno,   -- Año del período
    T1.DtoMes                   As EstMes,   -- Mes del período (1–12)

    -- --------------------------------------------------------
    -- Importes de ventas
    -- --------------------------------------------------------
    Sum(T1.DtoImp)              As ESTIBV,  -- Importe Bruto de Ventas
    Sum(T1.DtoMpd)              As ESTIDV,  -- Importe de Descuentos de Ventas
    Sum(T1.DtoIm1 + T1.DtoIm2)  As ESTIIV,  -- Importe de Impuestos 
                                            -- (tasa1 + tasa2)

    -- Neto de Ventas = (Bruto − Descuento) + Impuestos
    Sum((T1.DtoImp - T1.DtoMpd) + T1.DtoIm1 + T1.DtoIm2) As ESTINV,   
                                            -- Importe Neto de Ventas

    -- --------------------------------------------------------
    -- Costos
    -- --------------------------------------------------------
    Sum(T1.DtoMcp)              As ESTCPR,   -- Costo Promedio de los 
                                             -- artículos vendidos
    Sum(T1.DtoMcu)              As ESTCUL    -- Costo Último de los 
                                             -- artículos vendidos

From FacDtod As T1

Group By
    T1.CliCve,
    T1.DtoAno,
    T1.DtoMes

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.CliCve, T1.DtoAno, T1.DtoMes
