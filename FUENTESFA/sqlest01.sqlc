-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWEST_Estadisticas_de_Ventas_General As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupacion
    -- --------------------------------------------------------
    T1.DtoAno                  As EstAno,   -- Ano del periodo
    T1.DtoMes                  As EstMes,   -- Mes del periodo (1–12)

    -- --------------------------------------------------------
    -- Importes de ventas
    -- --------------------------------------------------------
    Sum(T1.DtoImp)             As ESTIBV,   -- Importe Bruto de Ventas
    Sum(T1.DtoMpd)             As ESTIDV,   -- Importe de Descuentos de Ventas
    Sum(T1.DtoIm1 + T1.DtoIm2) As ESTIIV,   -- Importe de Impuestos de Ventas
                                            -- (tasa1 + tasa2)

    -- Neto de Ventas = (Bruto − Descuento) + Impuestos
    Sum((T1.DtoImp - T1.DtoMpd) + T1.DtoIm1 + T1.DtoIm2) As ESTINV, 
                                            -- Importe Neto de Ventas

    -- --------------------------------------------------------
    -- Costos
    -- --------------------------------------------------------
    Sum(T1.DtoMcp)             As ESTCPR,   -- Costo Promedio de los 
                                            -- articulos vendidos
    Sum(T1.DtoMcu)             As ESTCUL    -- Costo Ultimo de los 
                                            -- articulos vendidos

From FacDtod As T1

Group By
    T1.DtoAno,
    T1.DtoMes

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.DtoAno, T1.DtoMes
