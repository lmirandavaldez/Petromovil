-- ==============================================================
-- Modulo    : Facturacion
-- Programa  : SQLFAT001
-- Objeto    : CLIENTE_INACTIVIDAD
-- Tipo      : DDL Tabla (CREATE TABLE)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 4
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================
Create Or Replace Table CLIENTE_INACTIVIDAD
For System Name ESTICC
(
    -- Codigo del cliente (PK — corresponde a CxcCli.CliCve)
    ID_CLIENTE               For CLICVE  Decimal(7,0)  Not Null,

    -- Fecha en que el cliente fue dado de alta en el sistema
    FECHA_INGRESO            For IccFin  Date          Not Null,

    -- Fecha de la primera compra registrada
    FECHA_PRIMERA_COMPRA     For IccFPC  Date          Not Null,

    -- Fecha de la compra mas reciente
    FECHA_ULTIMA_COMPRA      For ICCFUC  Date          Not Null,

    -- Fecha en que se detecto la ultima inactividad
    FECHA_ULTIMA_INACTIVIDAD For ICCFUI  Date          Not Null,

    -- Fecha en que el cliente fue reactivado
    FECHA_REACTIVACION       For ICCFUR  Date          Not Null,

    -- Meses transcurridos desde la ultima compra (calculado)
    MESES_INACTIVO           For ICCMIN  Decimal(10,0) Default 0,

    -- 'S'=Cliente nuevo o reactivado; 'N'=Cliente regular
    ES_NUEVO                 For ICCNUE  Char(1)       Default 'N',

    -- Estado actual: 'ACTIVO' o 'INACTIVO' (10 chars)
    ESTADO_CLIENTE           For ICCSTA  Char(10)      Default 'ACTIVO',

    -- Restriccion de clave primaria
    Primary Key (ID_CLIENTE)
)
Rcdfmt ESTICCF;

-- ===========================================================
-- Labels de tabla
-- ===========================================================
Label On Table CLIENTE_INACTIVIDAD
    Is 'Tabla: Historico Inactividad Clientes';

-- ===========================================================
-- Labels de texto de columnas (descripcion larga)
-- ===========================================================
Label On Column CLIENTE_INACTIVIDAD
(
    ID_CLIENTE               Text Is 'Codigo de Cliente',
    FECHA_INGRESO            Text Is 'Fecha de Ingreso',
    FECHA_PRIMERA_COMPRA     Text Is 'Fecha Primera Compra',
    FECHA_ULTIMA_COMPRA      Text Is 'Fecha Ultima Compra',
    -- CORRECCION: era 'Inactivadad' (typo)
    FECHA_ULTIMA_INACTIVIDAD Text Is 'Fecha Ultima Inactividad',
    FECHA_REACTIVACION       Text Is 'Fecha de Reactivacion',
    MESES_INACTIVO           Text Is 'Meses Inactivo',
    ES_NUEVO                 Text Is 'Es Nuevo el cliente',
    ESTADO_CLIENTE           Text Is 'Estado de Cliente'
);

-- ===========================================================
-- Encabezados de columnas (heading en pantalla/reporte)
-- ===========================================================
Label On Column CLIENTE_INACTIVIDAD
(
    ID_CLIENTE               Is 'Codigo de Cliente',
    FECHA_INGRESO            Is 'Fecha de Ingreso',
    FECHA_PRIMERA_COMPRA     Is 'Fecha Primera Compra',
    FECHA_ULTIMA_COMPRA      Is 'Fecha Ultima Compra',
    -- CORRECCION: era 'Inactivadad' (typo)
    FECHA_ULTIMA_INACTIVIDAD Is 'Fecha Ultima Inactividad',
    FECHA_REACTIVACION       Is 'Fecha de Reactivacion',
    MESES_INACTIVO           Is 'Meses Inactivo',
    ES_NUEVO                 Is 'Es Nuevo el cliente',
    ESTADO_CLIENTE           Is 'Estado de Cliente'
);

-- ===========================================================
-- Indice compuesto para consultas por cliente y fecha
-- (soporta los filtros de sqlfap001 y sqlfap002)
-- ===========================================================
Create Index ESTICC_INDEX_00001
    On CLIENTE_INACTIVIDAD (ID_CLIENTE, FECHA_ULTIMA_COMPRA);

Label On Index ESTICC_INDEX_00001
    Is 'Index: ID_CLIENTE, FECHA_ULTIMA_COMPRA';
