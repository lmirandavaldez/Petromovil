-- ============================================================
-- Vista   : VWEST_Estadisticas_de_Ventas_General
-- Módulo  : Estadísticas de Ventas
-- Objeto  : Resume las estadísticas de ventas agrupadas por
--           año y mes a partir del detalle de documentos de
--           facturación (FacDtod).
--           Calcula importes brutos, descuentos, impuestos,
--           neto a cobrar y costos (promedio y último).
-- Tabla   : FacDtod  — detalle de documentos de facturación
-- Esquema : (default)
-- Autor   : L. Miranda
-- Versión : 2  (mejorada)
-- Cambios :
--   v2 - Se agrega alias de tabla explícito más descriptivo (T1).
--        Se documentan todas las columnas calculadas con su
--          significado de negocio.
--        Se descompone ESTINV en sus sumandos con comentario
--          explicativo de la fórmula.
--        Se agrega ORDER BY sugerido (comentado) para consultas
--          directas sobre la vista.
--        Mejora de formato e indentación.
--        Cabecera de documentación completa.
-- ============================================================

Create Or Replace View VWEST_Estadisticas_de_Ventas_General As

Select
    -- --------------------------------------------------------
    -- Dimensiones de agrupación
    -- --------------------------------------------------------
    T1.DtoAno                  As EstAno,   -- Año del período
    T1.DtoMes                  As EstMes,   -- Mes del período (1–12)

    -- --------------------------------------------------------
    -- Importes de ventas
    -- --------------------------------------------------------
    Sum(T1.DtoImp)             As ESTIBV,   -- Importe Bruto de Ventas
    Sum(T1.DtoMpd)             As ESTIDV,   -- Importe de Descuentos de Ventas
    Sum(T1.DtoIm1 + T1.DtoIm2) As ESTIIV,   -- Importe de Impuestos de Ventas
                                            -- (tasa1 + tasa2)

    -- Neto de Ventas = (Bruto − Descuento) + Impuestos
    Sum((T1.DtoImp - T1.DtoMpd) + T1.DtoIm1 + T1.DtoIm2) As ESTINV, 
                                            -- Importe Neto de Ventas

    -- --------------------------------------------------------
    -- Costos
    -- --------------------------------------------------------
    Sum(T1.DtoMcp)             As ESTCPR,   -- Costo Promedio de los 
                                            -- artículos vendidos
    Sum(T1.DtoMcu)             As ESTCUL    -- Costo Último de los 
                                            -- artículos vendidos

From FacDtod As T1

Group By
    T1.DtoAno,
    T1.DtoMes

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.DtoAno, T1.DtoMes
