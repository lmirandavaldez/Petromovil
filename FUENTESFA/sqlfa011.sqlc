-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion en comentarios dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en el SELECT del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en los JOINs del SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver seccion Cambios en el historial del archivo original.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWFAC_Comprobantes_Planillas As

Select
    -- --------------------------------------------------------
    -- Identificacion de la planilla (FacPlah = T1)
    -- --------------------------------------------------------
    T1.PlaDis                   As CODIGO_DISTRITO_PLANILLA_Plah,   
                                   -- Codigo de distrito de la planilla
    T1.PlaNro                   As NUMERO_DEFINITIVO_PLANILLA_Plah, 
                                   -- Numero definitivo de la planilla
    T1.VehFic                   As FICHA_DEL_VEHICULO_Plah,         
                                   -- Ficha / placa del vehiculo
    T1.PlaFpl                   As FECHA_DE_LA_PLANILLA_Plah,       
                                   -- Fecha de la planilla

    -- --------------------------------------------------------
    -- Detalle del pedido en planilla (FacPlad = T2)
    -- --------------------------------------------------------
    T2.DisCve                   As CODIGO_DE_DISTRITO_Plad,         
                                   -- Codigo de distrito del pedido
    Coalesce(T4.AlmCve, 0)        As CODIGO_DEL_ALMACEN_Ordh,         
                                   -- Almacen del pedido
                                   -- (FacOrdh; 0 si sin pedido)
    T2.OrdNro                   As NUMERO_ORDEN_PEDIDO_Plad,        
                                   -- Numero de orden / pedido
    T2.OrdAmd                   As FECHA_ORDEN_DEL_PEDIDO_AMD_Plad, 
                                   -- Fecha de la orden (formato AMD)
    T2.CliCve                   As CODIGO_DEL_CLIENTE_Plad,         
                                   -- Codigo del cliente

    -- --------------------------------------------------------
    -- Tipo de comprobante fiscal del cliente (CxcAdc = T5)
    -- --------------------------------------------------------
    T5.TcfCve                   As TIPO_COMPROBANTE_FISCAL          
                                   -- Tipo comprobante fiscal 
                                   -- asignado al cliente

From FacPlah As T1

-- Detalle de planilla — INNER JOIN intencional:
-- una cabecera sin detalle no aporta informacion
Inner Join FacPlad As T2
    On  T1.PlaDis = T2.PlaDis
    And T1.PlaNro = T2.PlaNro

-- Vehiculo — LEFT OUTER para preservar planillas cuyo vehiculo
-- no este en el maestro; COALESCE en WHERE maneja los NULL
Left Outer Join FacVeh As T3
    On T1.VehFic = T3.VehFic

-- Pedido origen — LEFT: el almacen puede no estar disponible
-- (solo activo cuando PlaOri='P', condicion en WHERE)
Left Outer Join FacOrdh As T4
    On  T2.DisCve = T4.DisCve
    And T2.OrdNro = T4.OrdNro
    And T2.CliCve = T4.CliCve
    And T2.PlaOri = 'P'

-- Tipo de comprobante fiscal por cliente — INNER JOIN:
-- solo se incluyen clientes con TcfCve valido para emision.
-- El original era LEFT JOIN con filtro en WHERE (equivalente
-- a INNER JOIN efectivo pero enganoso). Se hace explicito.
Inner Join CxcAdc As T5
    On T2.CliCve = T5.CliCve

Where
    -- Planillas en situacion valida para carga
    -- Excluye: 'O'=Ocupada, 'R'=Recibida/Revertida, 'Y'=Ya procesada
    T1.SitCve Not In ('O', 'R', 'Y')

    -- Solo vehiculos propios ('P'=Propio; excluye 'T'=Tercero)
    -- COALESCE: si el vehiculo no existe en FacVeh, VehOri=NULL -> excluye
    And COALESCE(T3.VehOri, '') = 'P'

    -- Solo vehiculos tipo 1 o 2 (livianos/medianos)
    -- COALESCE: si el vehiculo no existe en FacVeh, VehTip=NULL -> excluye
    And COALESCE(T3.VehTip, 99) <= 2

    -- Solo detalles activos ('A'=Activo)
    And T2.PlaSta = 'A'

    -- Solo renglones de origen Pedido (no facturas ya emitidas)
    And T2.PlaOri = 'P'

    -- Solo tipos de comprobante fiscal validos para emision:
    -- 01=Factura de Credito Fiscal, 02=Factura de Consumidor Final,
    -- 14=Reg. Unico de Ingresos, 15=Comp. de Compras,
    -- 31=Fact. de Exportacion, 32=Fact. p/Reg. Esp. de Tributacion,
    -- 44=Reg. de Gastos Menores, 45=Comp. para Gastos Gubernamentales
    And T5.TcfCve In (01, 02, 14, 15, 31, 32, 44, 45)

    -- Solo planillas cuya fecha de programacion ya llego o paso
    And Date(T1.PlaTpl) <= Current Date

-- Orden sugerido para consultas directas sobre la vista:
-- Order By T1.PlaDis, T1.PlaNro, T2.OrdNro
