-- =============================================================
-- Modulo    : Importaciones
-- Programa  : SQLIM004
-- Objeto    : VWIME_Datos_Cabecera_Detalle
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2
-- -------------------------------------------------------------
-- Descripcion:
--   Vista de deducciones de facturas de importacion con datos
--   de cabecera y detalle asociados. Es la tercera perspectiva
--   del conjunto de vistas de importacion: la tabla base es
--   ImeDed (deducciones) con LEFT OUTER JOIN a ImeFach
--   (encabezado) e ImeFacd (detalle de factura).
--
--   Las tres vistas del modulo comparten la misma clave
--   compuesta (DisCve, DtoTip, VehFic, DtoNfe) y el patron
--   de exponer RowGui de las tablas relacionadas como
--   indicadores de existencia:
--     SQLIM002: base ImeFach  -> indica si tiene detalle/ded.
--     SQLIM003: base ImeFacd  -> indica si tiene cabecera/ded.
--     SQLIM004: base ImeDed   -> indica si tiene cabecera/det.
--
--   Los LEFT OUTER JOINs permiten devolver deducciones aun
--   si no tienen encabezado o detalle registrado, lo que
--   puede indicar registros huerfanos en ImeDed.
--
--   No hay filtros WHERE; devuelve todas las deducciones.
--   No hay campos de fecha por concatenar. DtoFec, OrdFec
--   y PlaFpl provienen de ImeFach T2 en tipo original.
--   No aplica logica de resolucion via SegFec.
-- -------------------------------------------------------------
-- Campos retornados (en orden original):
--   CODIGO_DE_DISTRITO           Clave del distrito  (ImeDed/T1)
--   TIPO_DE_DOCUMENTO            Tipo de documento   (ImeDed/T1)
--   FICHA_DEL_VEHICULO           Ficha del vehiculo  (ImeDed/T1)
--   NUMERO_FACTURA_MODULO_EXTERN Nro. factura ext.   (ImeDed/T1)
--   CODIGO_IDENT_REGISTRO_DED    RowGui deduccion    (ImeDed/T1)
--   FECHA_FACTURA_MODULO_EXTERN  Fecha factura ext.  (ImeFach/T2)
--                                NULL si sin cabecera
--   HORA_FACTURA_MODULO_EXTERNO  Hora factura ext.   (ImeFach/T2)
--                                NULL si sin cabecera
--   NRO_CUADRE_MODULO_EXTERNO    Nro. conocimiento   (ImeFach/T2)
--                                NULL si sin cabecera
--   CODIGO_DEL_CLIENTE           Clave del cliente   (ImeFach/T2)
--                                NULL si sin cabecera
--   NUMERO_ORDEN_PEDIDO          Nro. orden pedido   (ImeFach/T2)
--                                NULL si sin cabecera
--   FECHA_ORDEN_PEDIDO_AMD       Fecha orden (AMD)   (ImeFach/T2)
--                                NULL si sin cabecera
--   CODIGO_DISTRITO_PLANILLA     Distrito planilla   (ImeFach/T2)
--                                NULL si sin cabecera
--   NUMERO_DEFINITIVO_PLANILLA   Nro. definitivo     (ImeFach/T2)
--                                NULL si sin cabecera
--   FECHA_DE_LA_PLANILLA         Fecha de planilla   (ImeFach/T2)
--                                NULL si sin cabecera
--   CODIGO_IDENT_REGISTRO_FACH   RowGui encabezado   (ImeFach/T2)
--                                NULL si sin cabecera
--   CODIGO_IDENT_REGISTRO_FACD   RowGui detalle      (ImeFacd/T3)
--                                NULL si sin detalle
-- -------------------------------------------------------------
-- Tablas referenciadas:
--   ImeDed   T1   Deducciones de documentos (tabla base)
--   ImeFach  T2   Encabezado de facturas (opcional)
--   ImeFacd  T3   Detalle de facturas (opcional)
-- -------------------------------------------------------------
-- Patron de vistas SQLIM002/003/004:
--   Las tres vistas son perspectivas del mismo conjunto de
--   tablas (ImeFach, ImeFacd, ImeDed) usando la misma clave
--   compuesta de cuatro campos. Cada una parte de una tabla
--   distinta como base y expone RowGui de las otras dos
--   como indicadores de completitud del documento.
-- -------------------------------------------------------------
-- Uso tipico de RowGui:
--   CODIGO_IDENT_REGISTRO_FACH IS NULL -> deduccion sin cabecera
--   CODIGO_IDENT_REGISTRO_FACD IS NULL -> deduccion sin detalle
--   Ambos no nulos -> documento completo (cabecera+det.+ded.)
-- -------------------------------------------------------------
-- Sugerencias de mejora:
--   1. El LEFT OUTER JOIN a ImeFach T2 es inusual para una
--      deduccion: en un esquema normalizado la deduccion
--      siempre debe tener su cabecera. Usar INNER JOIN si
--      se quiere garantizar integridad, o LEFT OUTER JOIN
--      solo para detectar deducciones huerfanas.
--   2. Si ImeFacd puede tener multiples filas por documento,
--      el LEFT OUTER JOIN a T3 multiplicara filas de ImeDed.
--      Confirmar unicidad de la clave en ImeFacd o usar
--      subconsulta escalar para obtener solo RowGui.
--   3. Las tres vistas SQLIM002/003/004 tienen estructura muy
--      similar. Considerar una vista unificada con FULL OUTER
--      JOIN entre las tres tablas para obtener el estado
--      completo en una sola consulta, usando COALESCE para
--      consolidar la clave de identificacion del documento.
--   4. DtoFec, OrdFec y PlaFpl de ImeFach T2 seran NULL para
--      deducciones sin cabecera. Los reportes consumidores
--      deben manejar NULLs con COALESCE si necesario.
-- -------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  ---------------------------------
--   2026-08-02  L. Miranda  Documentacion y formato 80 cols.
-- =============================================================

CREATE OR REPLACE VIEW VWIME_Datos_Cabecera_Detalle AS
SELECT
    -- Identificacion de la deduccion (tabla base ImeDed)
    T1.DisCve                       AS CODIGO_DE_DISTRITO,
    T1.DtoTip                       AS TIPO_DE_DOCUMENTO,
    T1.VehFic                       AS FICHA_DEL_VEHICULO,
    T1.DtoNfe                       AS NUMERO_FACTURA_MODULO_EXTERNO,
    T1.RowGui                       AS CODIGO_IDENT_REGISTRO_DED,

    -- Datos del encabezado (ImeFach T2, NULL si sin cabecera)
    T2.DtoFec                       AS FECHA_FACTURA_MODULO_EXTERNO,
    T2.DtoHms                       AS HORA_FACTURA_MODULO_EXTERNO,
    T2.ImeNce                       AS NRO_CUADRE_MODULO_EXTERNO,
    T2.CliCve                       AS CODIGO_DEL_CLIENTE,
    T2.OrdNro                       AS NUMERO_ORDEN_PEDIDO,
    T2.OrdFec                       AS FECHA_ORDEN_PEDIDO_AMD,
    T2.PlaDis                       AS CODIGO_DISTRITO_PLANILLA,
    T2.PlaNro                       AS NUMERO_DEFINITIVO_PLANILLA,
    T2.PlaFpl                       AS FECHA_DE_LA_PLANILLA,
    T2.RowGui                       AS CODIGO_IDENT_REGISTRO_FACH,

    -- Indicador de detalle (ImeFacd T3, NULL si sin detalle)
    T3.RowGui                       AS CODIGO_IDENT_REGISTRO_FACD

FROM ImeDed T1

-- Encabezado de la factura (opcional: NULL si no existe)
LEFT OUTER JOIN ImeFach T2
    ON  T1.DisCve = T2.DisCve
    AND T1.DtoTip = T2.DtoTip
    AND T1.VehFic = T2.VehFic
    AND T1.DtoNfe = T2.DtoNfe

-- Detalle de la factura (opcional: NULL si no existe)
LEFT OUTER JOIN ImeFacd T3
    ON  T1.DisCve = T3.DisCve
    AND T1.DtoTip = T3.DtoTip
    AND T1.VehFic = T3.VehFic
    AND T1.DtoNfe = T3.DtoNfe;
