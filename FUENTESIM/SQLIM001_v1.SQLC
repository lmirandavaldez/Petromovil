Create Or Replace View VWIME_Documento_Sin_Cierres
As Select T1.VehFic, T1.ImeNce, T1.PlaDis, T1.PlaNro, T1.PlaFpl
     From ImeFach t1
     Join FacVeh T3
       On (T1.VehFic = T3.VehFic)
    Where Not Exists(Select * from ImeCcme T2
      Where (T1.VehFic = T2.VehFic)
        And (T1.ImeNce = T2.Imence)
        And (T1.PlaDis = T2.PlaDis)
        And (T1.PlaNro = T2.PlaNro)
        And (T1.PlaFpl = T2.PlaFpl))
      And (T3.VehTip = 2)
 Group By T1.VehFic, T1.ImeNce, T1.PlaDis, T1.PlaNro, T1.PlaFpl
