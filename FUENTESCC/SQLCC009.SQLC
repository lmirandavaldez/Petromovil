-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC009
-- Objeto    : VWCXC_Direcciones_Despacho
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Presenta todas las direcciones de despacho registradas para cada
--            cliente activo (CliSta = 'A'), enriquecidas con la descripcion
--            geografica completa (provincia, municipio, demarcacion) y los
--            datos de contacto de cada direccion, incluyendo coordenadas GPS.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcCli  - Catalogo maestro de clientes (tabla principal; filtro CliSta='A')
--   CxcDdc  - Direcciones de despacho por cliente
--   SegPrv  - Catalogo de provincias
--   SegMun  - Catalogo de municipios      (clave compuesta: PrvCve + MunCve)
--   SegDms  - Catalogo de demarcaciones   (clave compuesta: PrvCve + MunCve +
--                                          DmsCve + DmsCpo + DmsSec)
-- --------------------------------------------------------------
-- Notas:
--   - Solo se muestran clientes con estado 'A' (Activo); clientes inactivos o
--     suspendidos quedan excluidos por el filtro WHERE.
--   - CxcDdc es LEFT OUTER desde CxcCli: un cliente activo aparece en el
--     resultado aunque no tenga ninguna direccion de despacho registrada.
--   - La jerarquia geografica (Prv -> Mun -> Dms) es identica a la de la vista
--     VWCXC_Maestro_Clientes_Carga, pero referenciada desde CxcDdc en lugar
--     de CxcCli.
--   - DdcDi1 : Linea adicional de direccion de despacho 
--     (complemento de DdcDir).
--   - DdcFax : Numero de fax (campo legado, puede estar vacio).
--   - DdcLat / DdcLog : Coordenadas GPS de la direccion (latitud / longitud).
--   - T10/T11/T12 en el original sugieren tablas intermedias eliminadas en
--     versiones previas; reemplazados por alias descriptivos.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWCXC_Direcciones_Despacho AS

SELECT
    -- Cliente
    cli.CliCve       AS CliCve,      -- Clave del cliente
    cli.CliNom       AS CliNom,      -- Nombre del cliente

    -- Direccion de despacho
    ddc.DdcCve       AS DdcCve,      -- Clave de la direccion de despacho
    ddc.DdcNom       AS DdcNom,      -- Nombre / descripcion de la direccion
    ddc.DdcDir       AS DdcDir,      -- Direccion principal de despacho
    ddc.DdcDi1       AS DdcDi1,      -- Direccion complementaria (linea 2)

    -- Ubicacion geografica — provincia
    ddc.DdcPrv       AS DdcPrv,      -- Clave de provincia
    prv.PrvDes       AS PrvDes,      -- Descripcion de la provincia

    -- Ubicacion geografica — municipio
    ddc.DdcMun       AS DdcMun,      -- Clave de municipio
    mun.MunDes       AS MunDes,      -- Descripcion del municipio

    -- Ubicacion geografica — demarcacion
    ddc.DdcDms       AS DdcDms,      -- Clave de demarcacion
    dms.DmsDes       AS DmsDes,      -- Descripcion de la demarcacion

    -- Contacto de la direccion
    ddc.DdcTe1       AS DdcTe1,      -- Telefono principal de despacho
    ddc.DdcTe2       AS DdcTe2,      -- Telefono secundario de despacho
    ddc.DdcFax       AS DdcFax,      -- Fax (campo legado)

    -- Coordenadas GPS
    ddc.DdcLat       AS DdcLat,      -- Latitud de la direccion
    ddc.DdcLog       AS DdcLog       -- Longitud de la direccion

FROM CxcCli cli

-- Direcciones de despacho del cliente (puede no tener ninguna registrada)
LEFT OUTER JOIN CxcDdc ddc
    ON ddc.CliCve = cli.CliCve

-- Provincia de la direccion de despacho
LEFT OUTER JOIN SegPrv prv
    ON prv.PrvCve = ddc.DdcPrv

-- Municipio: clave compuesta provincia + municipio
LEFT OUTER JOIN SegMun mun
    ON  mun.PrvCve = ddc.DdcPrv
    AND mun.MunCve = ddc.DdcMun

-- Demarcacion: clave compuesta provincia 
-- + municipio + demarcacion + CP + sector
LEFT OUTER JOIN SegDms dms
    ON  dms.PrvCve = ddc.DdcPrv
    AND dms.MunCve = ddc.DdcMun
    AND dms.DmsCve = ddc.DdcDms
    AND dms.DmsCpo = ddc.DdcCpo
    AND dms.DmsSec = ddc.DdcSec

WHERE cli.CliSta = 'A'      -- Solo clientes activos
