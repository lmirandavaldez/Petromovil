-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC003
-- Objeto    : VWCXC_Territorios_Zonas
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Expone la relacion entre territorios de venta y las zonas
--            comerciales que los componen. Un territorio puede contener
--            multiples zonas; solo se muestran territorios con al menos
--            una zona asignada (INNER JOIN intencional).
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcTer  (T1) - Catalogo de territorios de venta
--   CxcZon  (T2) - Catalogo de zonas comerciales (N zonas por territorio)
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   - Se utiliza INNER JOIN porque la vista tiene como proposito mostrar
--     unicamente combinaciones territorio-zona validas.
--   - Si se requieren territorios sin zonas asignadas, cambiar a
--     LEFT OUTER JOIN y evaluar el impacto en los consumidores de la vista.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================
Create Or Replace View VWCXC_Territorios_Zonas
As
Select
    -- Territorio de venta
    T1.TerCve,      -- Clave del territorio
    T1.TerDes,      -- Descripcion del territorio
    -- Zona comercial asignada al territorio
    T2.ZonCve,      -- Clave de la zona
    T2.ZonDes       -- Descripcion de la zona
From CxcTer T1
    -- Zonas: INNER JOIN -> solo territorios con zonas asignadas
    Join CxcZon T2
      On T1.TerCve = T2.TerCve
