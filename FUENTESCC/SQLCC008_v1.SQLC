Create Or Replace View VWCXC_Ultimos_Documentos
   As Select T1.CliCve, T3.LdmTip, T3.LdmTor,
             Max(T9.FecYmd) As Fecha_Ultimo_Doc,
             Sum(T1.UltCon) As Cantidad_Emitidos
        From CxcUlt T1
        Join CxcCdo T2
          On (T1.CdoCve = T2.CdoCve)
        Join SegLdm T3
          On (T2.CdoRel = T3.LdmCve)
         And (T3.SisCve = 'CC')
        Join SegFec T9
          On (T1.UltAno = T9.FecAno)
         And (T1.UltMes = T9.FecMes)
         And (T1.UltDia = T9.FecDia)
    Group By T1.CliCve, T3.LdmTip, T3.LdmTor
