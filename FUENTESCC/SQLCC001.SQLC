-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC001
-- Objeto    : VWCXC_Maestro_Clientes
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Consolida la informacion maestra de clientes incluyendo datos
--            generales, direccion fiscal, zona comercial, territorio, vendedor,
--            supervisor, campana, provincia, municipio y demarcacion.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcCli  (T1)  - Maestro de clientes
--   CxcAdc  (T2)  - Datos adicionales del cliente (zona, campana, limite credito)
--   CxcDgc  (T3)  - Datos de gestion comercial (ciudad, macroflota)
--   CxcZon  (T4)  - Zonas comerciales
--   CxcTer  (T5)  - Territorios de venta
--   CxcRvc  (T6)  - Relacion vendedor-cliente (LEFT: cliente puede no tener vendedor)
--   CxcVen  (T7)  - Vendedores (LEFT: dependiente de CxcRvc)
--   CxcSup  (T8)  - Supervisores (LEFT: dependiente de CxcVen)
--   CxcCpa  (T9)  - Campanas (LEFT: cliente puede no tener campana activa)
--   SegPrv  (T10) - Catalogo de provincias (LEFT: CliPrv puede ser nulo)
--   SegMun  (T11) - Catalogo de municipios (LEFT: CliMun puede ser nulo)
--   SegDms  (T12) - Catalogo de demarcaciones/asentamientos
--           (LEFT: puede ser nulo)
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================
Create Or Replace View VWCXC_Maestro_Clientes
As
Select
    -- Datos generales del cliente
    T1.CliCve,                  -- Clave del cliente
    T1.CliNom,                  -- Nombre / Razon social
    T1.CliDir,                  -- Direccion linea 1
    T1.CliDi1,                  -- Direccion linea 2
    T1.CliTe1,                  -- Telefono 1
    T1.CliTe2,                  -- Telefono 2
    T1.CliRnc,                  -- RNC / Identificacion fiscal
    T1.CliSta,                  -- Estatus del cliente
    -- Ubicacion geografica
    T1.CliPrv,                  -- Clave de provincia
    T10.PrvDes,                 -- Descripcion de provincia
    T1.CliMun,                  -- Clave de municipio
    T11.MunDes,                 -- Descripcion de municipio
    T1.CliDms,                  -- Clave de demarcacion
    T1.CliCpo,                  -- Codigo postal
    T1.CliSec,                  -- Sector
    T12.DmsDes,                 -- Descripcion de demarcacion
    -- Datos adicionales y credito
    T2.AdcLcr,                  -- Limite de credito
    T2.CpaCve,                  -- Clave de campana
    T9.CpaDes,                  -- Descripcion de campana
    -- Datos de gestion comercial
    T3.DgcCdd,                  -- Ciudad de gestion
    T3.DgcMfl,                  -- Macroflota
    -- Estructura comercial: zona -> territorio -> supervisor -> vendedor
    T2.ZonCve,                  -- Clave de zona
    T4.ZonDes,                  -- Descripcion de zona
    T4.TerCve,                  -- Clave de territorio
    T5.TerDes,                  -- Descripcion de territorio
    T8.SupCve,                  -- Clave de supervisor 
    T8.SupNom,                  -- Nombre del supervisor
    T6.VenCve,                  -- Clave del vendedor
    T7.VenNom                   -- Nombre del vendedor
From CxcCli T1
    -- Datos adicionales: relacion obligatoria 1-1
    Join CxcAdc T2
      On T1.CliCve = T2.CliCve
    -- Datos de gestion comercial: relacion obligatoria 1-1
    Join CxcDgc T3
      On T1.CliCve = T3.CliCve
    -- Zona comercial: obligatoria desde datos adicionales
    Join CxcZon T4
      On T2.ZonCve = T4.ZonCve
    -- Territorio: obligatorio desde zona
    Join CxcTer T5
      On T4.TerCve = T5.TerCve
    -- Vendedor asignado: opcional (cliente puede no tener vendedor)
    Left Outer Join CxcRvc T6
      On T1.CliCve = T6.CliCve
    -- Datos del vendedor: depende de CxcRvc
    Left Outer Join CxcVen T7
      On T6.VenCve = T7.VenCve
    -- Supervisor: depende de CxcVen
    Left Outer Join CxcSup T8
      On T7.SupCve = T8.SupCve
    -- Campana: opcional
    Left Outer Join CxcCpa T9
      On T2.CpaCve = T9.CpaCve
    -- Provincia: opcional (direccion puede ser incompleta)
    Left Outer Join SegPrv T10
      On T1.CliPrv = T10.PrvCve
    -- Municipio: requiere provincia + municipio
    Left Outer Join SegMun T11
      On  T1.CliPrv = T11.PrvCve
     And  T1.CliMun = T11.MunCve
    -- Demarcacion / asentamiento: requiere provincia 
    -- + municipio + demarcacion + CP + sector
    Left Outer Join SegDms T12
      On  T1.CliPrv = T12.PrvCve
     And  T1.CliMun = T12.MunCve
     And  T1.CliDms = T12.DmsCve
     And  T1.CliCpo = T12.DmsCpo
     And  T1.CliSec = T12.DmsSec
