-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC015
-- Objeto    : VWCXC_Cantidad_Cheques
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Resume, por cliente, la fecha del ultimo cheque emitido y la
--            cantidad total de cheques registrados en CxcUlt, filtrando
--            unicamente los tipos de documento cuyo CdoRel = '02' (cheques).
--            La fecha se obtiene desde la tabla de fechas del sistema (SegFec)
--            usando los campos ANO/MES/DIA descompuestos de CxcUlt.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcUlt  - Ultimos documentos por cliente (contadores y fecha descompuesta:
--             UltAno, UltMes, UltDia; contador: UltCon)
--   CxcCdo  - Catalogo de tipos de documento (filtro: CdoRel = '02' = cheques)
--   SegFec  - Tabla de fechas del sistema (convierte Ano/Mes/Dia -> FecYmd)
-- --------------------------------------------------------------
-- Filtro aplicado:
--   CdoRel = '02'  ->  Solo documentos de tipo cheque.
--   CxcCdo se usa exclusivamente en el WHERE (no aporta columnas al SELECT).
--   El JOIN INNER con CxcCdo garantiza que el tipo de documento tenga
--   correspondencia en el catalogo; documentos sin tipo registrado quedan
--   excluidos.
-- --------------------------------------------------------------
-- Relacion con otras vistas:
--   Comparte estructura base con VWCXC_Ultimos_Documentos (SQLCC008).
--   Diferencias clave:
--     • SQLCC008 filtra por SegLdm (SisCve='CC') y agrupa por CliCve +
--       LdmTip + LdmTor (todos los tipos del subsistema CxC).
--     • Esta vista filtra por CxcCdo (CdoRel='02') y agrupa solo por
--       CliCve, entregando un unico renglon resumen de cheques por cliente.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   - El patron JOIN con SegFec convierte UltAno/UltMes/UltDia en FecYmd
--     sin construir una cadena de texto (igual que SQLCC008).
--   - UltCon : Contador de documentos emitidos para esa clave de documento.
--   - FecYmd : Fecha en formato ISO (YYYY-MM-DD o YYYYMMDD segun el motor).
--   - El alias T9 del original sugiere tablas intermedias eliminadas en
--     versiones previas del query.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWCXC_Cantidad_Cheques AS

SELECT
    -- Agrupador
    ult.CliCve       AS CliCve,              -- Clave del cliente

    -- Agregados
    MAX(fec.FecYmd)  AS Fecha_Ultimo_Doc,    
            -- Fecha del ultimo cheque emitido
    SUM(ult.UltCon)  AS Cantidad_Emitidos    
            -- Total de cheques emitidos por el cliente

FROM CxcUlt ult

-- Tipo de documento: INNER — solo registros con tipo de documento en el catalogo
-- CxcCdo no aporta columnas al SELECT; se usa exclusivamente para el filtro WHERE
INNER JOIN CxcCdo cdo
    ON cdo.CdoCve = ult.CdoCve

-- Tabla de fechas: convierte UltAno/UltMes/UltDia en FecYmd (fecha ISO)
INNER JOIN SegFec fec
    ON  fec.FecAno = ult.UltAno
    AND fec.FecMes = ult.UltMes
    AND fec.FecDia = ult.UltDia

WHERE cdo.CdoRel = '02'         -- Solo documentos de tipo cheque

GROUP BY
    ult.CliCve                  -- Un renglon resumen de cheques por cliente
