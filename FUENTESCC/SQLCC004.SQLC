-- Objeto    : VWCXC_Vendedores_Comision
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Expone la relacion entre vendedores y sus rangos/parametros de
--            comision por categoria de inventario. Consolida la informacion
--            de las tablas CxcVen (vendedores), CxcRcv (rangos de comision
--            por vendedor) e InvCat (catalogo de categorias de inventario).
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcVen  - Catalogo de vendedores
--   CxcRcv  - Rangos y factores de comision por vendedor / categoria
--   InvCat  - Catalogo de categorias de inventario
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWCXC_Vendedores_Comision AS

SELECT
    -- Vendedor
    ven.VenCve                  AS VenCve,   -- Clave del vendedor
    ven.VenNom                  AS VenNom,   -- Nombre del vendedor

    -- Categoria de inventario
    rcv.CatCve                  AS CatCve,   -- Clave de la categoria
    cat.CatDes                  AS CatDes,   -- Descripcion de la categoria

    -- Rangos de comision
    rcv.RcvLmi                  AS RcvLmi,   -- Limite inferior del rango
    rcv.RcvLms                  AS RcvLms,   -- Limite superior del rango

    -- Parametros de calculo de comision
    rcv.RcvCfi                  AS RcvCfi,   -- Factor de comision
    rcv.RcvPad                  AS RcvPad,   -- Porcentaje adicional
    rcv.RcvVa1                  AS RcvVa1,   -- Valor auxiliar 1
    rcv.RcvPo1                  AS RcvPo1,   -- Porcentaje auxiliar 1
    rcv.RcvMdc                  AS RcvMdc    -- Modalidad de comision

FROM CxcVen  ven

-- Rangos de comision definidos para el vendedor (puede no tener ninguno)
LEFT OUTER JOIN CxcRcv rcv
    ON rcv.VenCve = ven.VenCve

-- Descripcion de la categoria asociada al rango (puede no existir en catalogo)
LEFT OUTER JOIN InvCat cat
    ON cat.CatCve = rcv.CatCve
