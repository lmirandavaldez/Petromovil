-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC012
-- Objeto    : VWCXC_Relacion_Comision_Vendedores_Externos
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Presenta la relacion de comisiones asignadas a vendedores
--            externos por cliente. Para cada registro de CxcRcve muestra
--            el nombre del vendedor externo, el nombre del cliente y el
--            valor/porcentaje de comision acordado (RcvVa1).
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcRcve - Relacion de comisiones por vendedor externo / cliente (principal)
--   CxcVex  - Catalogo de vendedores externos
--   CxcCli  - Catalogo de clientes
-- --------------------------------------------------------------
-- Relacion con otras vistas:
--   Esta vista es el equivalente externo de VWCXC_Relacion_Comision_Vendedores
--   (SQLCC011), que trabaja con vendedores internos (CxcRcv / CxcVen).
--   Diferencias clave:
--     • CxcRcve / CxcVex  -> vendedores externos (agentes / comisionistas)
--     • CxcRcv  / CxcVen  -> vendedores internos de la empresa
--     • El esquema externo asocia la comision por cliente (CliCve),
--       mientras el interno la asocia por categoria de inventario (CatCve).
-- --------------------------------------------------------------
-- Notas:
--   - Todos los JOINs son INNER: solo se muestran registros cuyo vendedor
--     externo y cliente esten completamente catalogados. Registros con
--     referencias huerfanas quedan excluidos.
--   - RcvVa1 : Valor o porcentaje de comision del vendedor externo
--              acordado para ese cliente especifico.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWCXC_Relacion_Comision_Vendedores_Externos AS

SELECT
    -- Vendedor externo
    rcve.VexCve AS VexCve,  -- Clave del vendedor externo
    vex.VexNom  AS VexNom,  -- Nombre del vendedor externo

    -- Cliente asociado
    rcve.CliCve AS CliCve,  -- Clave del cliente
    cli.CliNom  AS CliNom,  -- Nombre del cliente

    -- Comision acordada
    rcve.RcvVa1 AS RcvVa1   -- Valor / porcentaje de comision para este cliente

FROM CxcRcve rcve

-- Vendedor externo: INNER — excluye comisiones con vendedor no catalogado
INNER JOIN CxcVex vex
    ON vex.VexCve = rcve.VexCve

-- Cliente: INNER — excluye comisiones con cliente no registrado
INNER JOIN CxcCli cli
    ON cli.CliCve = rcve.CliCve
