-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC006
-- Objeto    : VWCXC_Maestro_Clientes_Carga
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Consolida los datos maestros del cliente con su informacion
--            geografica (provincia, municipio, demarcacion) y el vendedor
--            asignado. Disenada para ser usada en procesos de carga/migracion
--            de datos y reportes del maestro de clientes.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcCli  - Catalogo maestro de clientes (tabla principal)
--   CxcRvc  - Relacion cliente-vendedor
--   CxcVen  - Catalogo de vendedores
--   SegPrv  - Catalogo de provincias
--   SegMun  - Catalogo de municipios      (clave compuesta: PrvCve + MunCve)
--   SegDms  - Catalogo de demarcaciones   (clave compuesta: PrvCve + MunCve +
--                                          DmsCve + DmsCpo + DmsSec)
-- --------------------------------------------------------------
-- Notas:
--   - CliRnc : Numero de Registro Nacional del Contribuyente (dato fiscal).
--   - CliDi1 : Linea adicional de direccion (complemento de CliDir).
--   - Los alias T10/T11/T12 del original sugieren tablas intermedias
--     eliminadas en revisiones previas; se reemplazaron por alias descriptivos.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWCXC_Maestro_Clientes_Carga AS

SELECT
    -- Identificacion del cliente
    cli.CliCve  AS CliCve,      -- Clave del cliente
    cli.CliNom  AS CliNom,      -- Nombre / razon social
    cli.CliRnc  AS CliRnc,      -- RNC (Registro Nacional del Contribuyente)
    cli.CliEma  AS CliEma,      -- Correo electronico

    -- Telefonos
    cli.CliTe1  AS CliTe1,      -- Telefono principal
    cli.CliTe2  AS CliTe2,      -- Telefono secundario

    -- Direccion
    cli.CliDir  AS CliDir,      -- Direccion principal
    cli.CliDi1  AS CliDi1,      -- Direccion complementaria (linea 2)

    -- Ubicacion geografica — provincia
    cli.CliPrv  AS CliPrv,      -- Clave de provincia
    prv.PrvDes  AS PrvDes,      -- Descripcion de la provincia

    -- Ubicacion geografica — municipio
    cli.CliMun  AS CliMun,      -- Clave de municipio
    mun.MunDes  AS MunDes,      -- Descripcion del municipio

    -- Ubicacion geografica — demarcacion (sector / codigo postal)
    cli.CliDms  AS CliDms,      -- Clave de demarcacion
    cli.CliCpo  AS CliCpo,      -- Codigo postal
    cli.CliSec  AS CliSec,      -- Sector
    dms.DmsDes  AS DmsDes,      -- Descripcion de la demarcacion

    -- Vendedor asignado
    rvc.VenCve  AS VenCve,      -- Clave del vendedor
    ven.VenNom  AS VenNom       -- Nombre del vendedor

FROM CxcCli cli

-- Vendedor asignado al cliente (un cliente puede no tener vendedor)
LEFT OUTER JOIN CxcRvc rvc
    ON rvc.CliCve = cli.CliCve

-- Datos del vendedor
LEFT OUTER JOIN CxcVen ven
    ON ven.VenCve = rvc.VenCve

-- Provincia del cliente
LEFT OUTER JOIN SegPrv prv
    ON prv.PrvCve = cli.CliPrv

-- Municipio: clave compuesta provincia + municipio
LEFT OUTER JOIN SegMun mun
    ON  mun.PrvCve = cli.CliPrv
    AND mun.MunCve = cli.CliMun

-- Demarcacion: clave compuesta provincia 
-- + municipio + demarcacion + CP + sector
LEFT OUTER JOIN SegDms dms
    ON  dms.PrvCve = cli.CliPrv
    AND dms.MunCve = cli.CliMun
    AND dms.DmsCve = cli.CliDms
    AND dms.DmsCpo = cli.CliCpo
    AND dms.DmsSec = cli.CliSec
