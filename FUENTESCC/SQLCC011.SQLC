-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC011
-- Objeto    : VWCXC_Relacion_Comision_Vendedores
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Presenta la configuracion completa de comisiones por vendedor,
--            mostrando para cada rango de comision (CxcRcv) el supervisor
--            del vendedor, el plan de comision, la categoria de inventario
--            a la que aplica y los parametros del rango (limites y factor).
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcRcv  - Rangos de comision por vendedor / categoria (tabla principal)
--   CxcVen  - Catalogo de vendedores (aporta VenNom y SupCve)
--   InvCat  - Catalogo de categorias de inventario
--   CxcSup  - Catalogo de supervisores de vendedores
--   CxcCpa  - Catalogo de planes / comprobantes de comision
-- --------------------------------------------------------------
-- Cadena de dependencia:
--   CxcRcv -> CxcVen  (por VenCve)  -> nombre del vendedor y clave del supervisor
--   CxcVen -> CxcSup  (por SupCve)  -> nombre del supervisor
--   CxcRcv -> InvCat  (por CatCve)  -> descripcion de la categoria
--   CxcRcv -> CxcCpa  (por CpaCve)  -> descripcion del plan de comision
-- --------------------------------------------------------------
-- Notas:
--   - Todos los JOINs son INNER: solo se muestran rangos cuyo vendedor tenga
--     categoria, supervisor y plan de comision completamente catalogados.
--     Rangos con alguna referencia huerfana quedan excluidos.
--   - RcvLmi : Limite inferior del rango de comision.
--   - RcvLms : Limite superior del rango de comision.
--   - RcvCfi : Factor (porcentaje / coeficiente) de comision del rango.
--   - RcvMdc : Modalidad de calculo de la comision.
--   - CpaDes : Descripcion del plan / comprobante de comision.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWCXC_Relacion_Comision_Vendedores AS

SELECT
    -- Supervisor del vendedor
    ven.SupCve     AS SupCve,      -- Clave del supervisor
    sup.SupNom     AS SupNom,      -- Nombre del supervisor

    -- Vendedor
    rcv.VenCve     AS VenCve,      -- Clave del vendedor
    ven.VenNom     AS VenNom,      -- Nombre del vendedor

    -- Plan de comision
    rcv.CpaCve     AS CpaCve,      -- Clave del plan / comprobante de comision
    cpa.CpaDes     AS CpaDes,      -- Descripcion del plan de comision

    -- Categoria de inventario a la que aplica el rango
    rcv.CatCve     AS CatCve,      -- Clave de la categoria de inventario
    cat.CatDes     AS CatDes,      -- Descripcion de la categoria

    -- Parametros del rango de comision
    rcv.RcvLmi     AS RcvLmi,      -- Limite inferior del rango
    rcv.RcvLms     AS RcvLms,      -- Limite superior del rango
    rcv.RcvCfi     AS RcvCfi,      -- Factor / porcentaje de comision
    rcv.RcvMdc     AS RcvMdc       -- Modalidad de calculo de la comision

FROM CxcRcv rcv

-- Vendedor: aporta nombre y clave del supervisor
INNER JOIN CxcVen ven
    ON ven.VenCve = rcv.VenCve

-- Categoria de inventario del rango
INNER JOIN InvCat cat
    ON cat.CatCve = rcv.CatCve

-- Supervisor del vendedor (a traves de CxcVen.SupCve)
INNER JOIN CxcSup sup
    ON sup.SupCve = ven.SupCve

-- Plan / comprobante de comision
INNER JOIN CxcCpa cpa
    ON cpa.CpaCve = rcv.CpaCve
