-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC002
-- Objeto    : VWCXC_Supervisores_Vendedores
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Muestra la relacion entre supervisores y los vendedores que tienen
--            asignados. Solo incluye supervisores que tengan al menos un vendedor
--            activo (INNER JOIN intencional).
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcSup  (T1) - Catalogo de supervisores
--   CxcVen  (T2) - Catalogo de vendedores (un vendedor pertenece a un supervisor)
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   - Se utiliza INNER JOIN porque la vista tiene como proposito mostrar
--     unicamente las combinaciones supervisor-vendedor validas.
--   - Si se requieren supervisores sin vendedores asignados, cambiar a
--     LEFT OUTER JOIN y considerar renombrar la vista.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================
Create Or Replace View VWCXC_Supervisores_Vendedores
As
Select
    -- Supervisor
    T1.SupCve,      -- Clave del supervisor
    T1.SupNom,      -- Nombre del supervisor
    -- Vendedor asignado
    T2.VenCve,      -- Clave del vendedor
    T2.VenNom,      -- Nombre del vendedor
    T2.VenSta       -- Estatus del vendedor
From CxcSup T1
    -- Vendedores: INNER JOIN -> solo supervisores con vendedores asignados
    Join CxcVen T2
      On T1.SupCve = T2.SupCve
