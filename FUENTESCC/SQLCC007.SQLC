-- ==============================================================
-- Modulo    : Cuentas por Cobrar 
-- Programa  : SQLCC007
-- Objeto    : VWCXC_Historico_Descuentos
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito: Presenta el historial de descuentos por cliente y articulo
--            registrados en CxcCdc, enriquecido con la descripcion del cliente,
--            el vendedor asignado, la descripcion del articulo y el usuario
--            que aplico el descuento. Incluye la fecha y hora de creacion
--            desglosadas del timestamp de aplicacion (AplTst).
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxcCdc  - Historial / detalle de descuentos por cliente-articulo 
--   CxcCli  - Catalogo de clientes
--   CxcRvc  - Relacion cliente-vendedor
--   CxcVen  - Catalogo de vendedores
--   InvArt  - Catalogo de articulos de inventario
--   SegUsr  - Catalogo de usuarios del sistema
-- --------------------------------------------------------------
-- Notas importantes:
--   - Todos los JOINs son INNER: solo se muestran descuentos cuyo cliente
--     tenga vendedor asignado (CxcRvc), articulo existente (InvArt) y
--     usuario valido (SegUsr). Registros huerfanos quedan excluidos.
--   - DprVde : Descuento por precio de venta especial.
--   - CdcVde : Codigo / clave del descuento aplicado.
--   - AplTst : Timestamp completo de aplicacion; se desglosa en DATE y TIME.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Documentacion: secciones estandar,
--                           sin acentos, formato 80 cols
-- ==============================================================

CREATE OR REPLACE VIEW VWCXC_Historico_Descuentos AS

SELECT
    -- Cliente
    cdc.CliCve  AS CliCve,          -- Clave del cliente
    cli.CliNom  AS CliNom,          -- Nombre del cliente

    -- Vendedor asignado al cliente
    rvc.VenCve  AS VenCve,          -- Clave del vendedor
    ven.VenNom  AS VenNom,          -- Nombre del vendedor

    -- Articulo
    cdc.ArtCve  AS ArtCve,          -- Clave del articulo
    art.ArtDes  AS ArtDes,          -- Descripcion del articulo

    -- Descuento
    cdc.DprVde  AS DprVde,          -- Descuento por precio de venta especial
    cdc.CdcVde  AS CdcVde,          -- Codigo / clave del descuento aplicado

    -- Usuario que aplico el descuento
    cdc.AplUsr  AS AplUsr,          -- Clave del usuario
    usr.UsrNom  AS UsrNom,          -- Nombre del usuario

    -- Fecha y hora de aplicacion (desglosadas del timestamp AplTst)
    DATE(cdc.AplTst) AS Fecha_Creacion,  -- Fecha de aplicacion del descuento
    TIME(cdc.AplTst) AS Hora_Creacion    -- Hora de aplicacion del descuento

FROM CxcCdc cdc

-- Cliente: INNER — solo descuentos con cliente registrado
INNER JOIN CxcCli cli
    ON cli.CliCve = cdc.CliCve

-- Vendedor asignado: INNER — excluye clientes sin vendedor en CxcRvc
INNER JOIN CxcRvc rvc
    ON rvc.CliCve = cdc.CliCve

-- Datos del vendedor
INNER JOIN CxcVen ven
    ON ven.VenCve = rvc.VenCve

-- Articulo: INNER — excluye descuentos con articulo no catalogado
INNER JOIN InvArt art
    ON art.ArtCve = cdc.ArtCve

-- Usuario aplicador: INNER — excluye descuentos con usuario no registrado
INNER JOIN SegUsr usr
    ON usr.UsrCve = cdc.AplUsr
