-- =============================================================================
-- Vista   : VWCXC_Historico_Descuentos
-- Módulo  : Cuentas por Cobrar (CxC)
-- Propósito: Presenta el historial de descuentos por cliente y artículo
--            registrados en CxcCdc, enriquecido con la descripción del cliente,
--            el vendedor asignado, la descripción del artículo y el usuario
--            que aplicó el descuento. Incluye la fecha y hora de creación
--            desglosadas del timestamp de aplicación (AplTst).
-- -----------------------------------------------------------------------------
-- Tablas base:
--   CxcCdc  - Historial / detalle de descuentos por cliente-artículo 
--   CxcCli  - Catálogo de clientes
--   CxcRvc  - Relación cliente-vendedor
--   CxcVen  - Catálogo de vendedores
--   InvArt  - Catálogo de artículos de inventario
--   SegUsr  - Catálogo de usuarios del sistema
-- -----------------------------------------------------------------------------
-- Notas importantes:
--   - Todos los JOINs son INNER: solo se muestran descuentos cuyo cliente
--     tenga vendedor asignado (CxcRvc), artículo existente (InvArt) y
--     usuario válido (SegUsr). Registros huérfanos quedan excluidos.
--   - DprVde : Descuento por precio de venta especial.
--   - CdcVde : Código / clave del descuento aplicado.
--   - AplTst : Timestamp completo de aplicación; se desglosa en DATE y TIME.
-- -----------------------------------------------------------------------------
-- Historial de cambios:
--   v1  Versión original
--   v2  Alias descriptivos, JOINs explícitos (INNER JOIN), calificación
--       completa de columnas, documentación y convención UPPER CASE
-- =============================================================================

CREATE OR REPLACE VIEW VWCXC_Historico_Descuentos AS

SELECT
    -- Cliente
    cdc.CliCve  AS CliCve,          -- Clave del cliente
    cli.CliNom  AS CliNom,          -- Nombre del cliente

    -- Vendedor asignado al cliente
    rvc.VenCve  AS VenCve,          -- Clave del vendedor
    ven.VenNom  AS VenNom,          -- Nombre del vendedor

    -- Artículo
    cdc.ArtCve  AS ArtCve,          -- Clave del artículo
    art.ArtDes  AS ArtDes,          -- Descripción del artículo

    -- Descuento
    cdc.DprVde  AS DprVde,          -- Descuento por precio de venta especial
    cdc.CdcVde  AS CdcVde,          -- Código / clave del descuento aplicado

    -- Usuario que aplicó el descuento
    cdc.AplUsr  AS AplUsr,          -- Clave del usuario
    usr.UsrNom  AS UsrNom,          -- Nombre del usuario

    -- Fecha y hora de aplicación (desglosadas del timestamp AplTst)
    DATE(cdc.AplTst) AS Fecha_Creacion,  -- Fecha de aplicación del descuento
    TIME(cdc.AplTst) AS Hora_Creacion    -- Hora de aplicación del descuento

FROM CxcCdc cdc

-- Cliente: INNER — solo descuentos con cliente registrado
INNER JOIN CxcCli cli
    ON cli.CliCve = cdc.CliCve

-- Vendedor asignado: INNER — excluye clientes sin vendedor en CxcRvc
INNER JOIN CxcRvc rvc
    ON rvc.CliCve = cdc.CliCve

-- Datos del vendedor
INNER JOIN CxcVen ven
    ON ven.VenCve = rvc.VenCve

-- Artículo: INNER — excluye descuentos con artículo no catalogado
INNER JOIN InvArt art
    ON art.ArtCve = cdc.ArtCve

-- Usuario aplicador: INNER — excluye descuentos con usuario no registrado
INNER JOIN SegUsr usr
    ON usr.UsrCve = cdc.AplUsr
