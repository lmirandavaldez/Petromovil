-- ==============================================================
-- Modulo    : Control de Inventarios
-- Programa  : SQLIV009
-- Objeto    : VWINV_Articulos_Costos
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- --------------------------------------------------------------
-- Descripcion:
--   Vista extendida del maestro de articulos con costos y datos
--   adicionales. Es una variante de VWINV_Maestro_Articulos
--   (SQLIV001) que agrega dos campos provenientes de InvDad:
--     CmeArt : cantidad de articulos en la unidad de empaque
--              (dato adicional de inventario)
--     ArtPdp : precio de distribuidor de producto
--
--   Al igual que SQLIV001, todos los joins son LEFT OUTER para
--   preservar articulos aunque alguna tabla de clasificacion
--   o de datos adicionales no tenga registro correspondiente.
--
--   La diferencia respecto a SQLIV001 es que en esta vista
--   InvDad (T2) si aporta campos al SELECT (CmeArt y ArtPdp),
--   mientras que en SQLIV001 el join a InvDad no proyectaba
--   ningun campo.
--
--   Clasificacion del articulo:
--     TiiCve/TiiDes : tipo de item
--     CatCve/CatDes : categoria
--     ScaCve/ScaDes : subcategoria (clave compuesta con CatCve)
--     MarCve/MarDes : marca
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   TiiCve   Clave del tipo de item          (InvArt)
--   TiiDes   Descripcion del tipo de item    (InvTii)
--   CatCve   Clave de categoria              (InvArt)
--   CatDes   Descripcion de categoria        (InvCat)
--   ScaCve   Clave de subcategoria           (InvArt)
--   ScaDes   Descripcion de subcategoria     (InvSca)
--   MarCve   Clave de marca                  (InvArt)
--   MarDes   Descripcion de marca            (InvMar)
--   CmeArt   Cantidad en unidad de empaque   (InvDad)
--   ArtCve   Clave del articulo              (InvArt)
--   ArtDes   Descripcion del articulo        (InvArt)
--   ArtPre   Precio del articulo             (InvArt)
--   ArtUal   Unidad alterna del articulo     (InvArt)
--   UndDes   Descripcion de la unidad        (InvUnd)
--   ArtCua   Cantidad de empaque almacen     (InvArt)
--   ArtMer   Merma                           (InvArt)
--   ArtCpl   Costo promedio ultimo           (InvArt)
--   ArtCul   Costo ultimo                    (InvArt)
--   ArtCst   Costo estandar                  (InvArt)
--   ArtCmi   Costo minimo                    (InvArt)
--   ArtCma   Costo maximo                    (InvArt)
--   ArtCre   Costo de reposicion             (InvArt)
--   ArtPdp   Precio de distribuidor          (InvDad)
--   ArtSta   Estatus del articulo            (InvArt)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   InvArt  T1  Maestro de articulos (tabla base)
--   InvDad  T2  Datos adicionales del articulo (CmeArt,ArtPdp)
--   InvTii  T3  Tipos de item
--   InvCat  T4  Categorias
--   InvMar  T5  Marcas
--   InvUnd  T6  Unidades de medida
--   InvSca  T7  Subcategorias (clave: CatCve + ScaCve)
-- --------------------------------------------------------------
-- Diferencias con VWINV_Maestro_Articulos (SQLIV001):
--   SQLIV001: InvDad se une sin proyectar campos
--   SQLIV009: InvDad aporta CmeArt y ArtPdp al SELECT
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Evaluar consolidar SQLIV001 y SQLIV009 en una sola vista
--      que siempre proyecte CmeArt y ArtPdp; si los campos de
--      InvDad son NULL cuando no existe registro, no hay costo
--      adicional para los consumidores que no los usen.
--   2. El join a InvSca usa clave compuesta (CatCve + ScaCve);
--      verificar que el indice compuesto exista en InvSca.
--   3. Considerar agregar GRANT SELECT ON VIEW con control
--      diferenciado para columnas de costos (ArtCpl, ArtCul,
--      ArtCst, ArtCmi, ArtCma, ArtCre) y precio (ArtPdp).
--   4. ArtPdp en InvDad podria estar duplicando logica de
--      precio que ya existe en InvArt (ArtPre). Verificar si
--      ambos campos se mantienen sincronizados.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2025-07-07  L. Miranda  Documentacion y mejoras de formato
-- ==============================================================

CREATE OR REPLACE VIEW VWINV_Articulos_Costos AS
SELECT
    -- Clasificacion: tipo de item
    T1.TiiCve,
    T3.TiiDes,
    -- Clasificacion: categoria
    T1.CatCve,
    T4.CatDes,
    -- Clasificacion: subcategoria
    T1.ScaCve,
    T7.ScaDes,
    -- Clasificacion: marca
    T1.MarCve,
    T5.MarDes,
    -- Datos adicionales (InvDad)
    T2.CmeArt,
    -- Identificacion y descripcion del articulo
    T1.ArtCve,
    T1.ArtDes,
    T1.ArtPre,
    -- Unidad de medida alterna
    T1.ArtUal,
    T6.UndDes,
    -- Parametros de empaque y costos
    T1.ArtCua,
    T1.ArtMer,
    T1.ArtCpl,
    T1.ArtCul,
    T1.ArtCst,
    T1.ArtCmi,
    T1.ArtCma,
    T1.ArtCre,
    -- Precio de distribuidor (InvDad)
    T2.ArtPdp,
    -- Estatus
    T1.ArtSta

FROM InvArt T1

-- Datos adicionales del articulo (CmeArt, ArtPdp)
LEFT OUTER JOIN InvDad T2
    ON  T1.ArtCve = T2.ArtCve

-- Tipo de item
LEFT OUTER JOIN InvTii T3
    ON  T1.TiiCve = T3.TiiCve

-- Categoria
LEFT OUTER JOIN InvCat T4
    ON  T1.CatCve = T4.CatCve

-- Marca
LEFT OUTER JOIN InvMar T5
    ON  T1.MarCve = T5.MarCve

-- Unidad de medida alterna
LEFT OUTER JOIN InvUnd T6
    ON  T1.ArtUal = T6.UndCve

-- Subcategoria (clave compuesta: categoria + subcategoria)
LEFT OUTER JOIN InvSca T7
    ON  T1.CatCve = T7.CatCve
    AND T1.ScaCve = T7.ScaCve;
