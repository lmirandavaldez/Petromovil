-- ==============================================================
-- Modulo    : Control de Inventarios
-- Programa  : SQLIV002
-- Objeto    : VWINV_Transacciones_Entradas_Salidas
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 1
-- --------------------------------------------------------------
-- Descripcion:
--   Vista que resume las entradas y salidas de inventario por
--   distribucion, almacen, articulo y familia de fecha.
--
--   Agrupa todas las transacciones de InvTrad y clasifica cada
--   movimiento como entrada o salida segun el tipo de movimiento
--   definido en InvTmo (campo TmoOri):
--
--     Entradas:
--       TmoOri = 1                          -> Entrada directa
--       TmoOri = 3 AND TmoCdt = '  '        -> Transferencia
--                                              entrada
--     Salidas:
--       TmoOri = 2                          -> Salida directa
--       TmoOri = 3 AND TmoCdt <> '  '       -> Transferencia
--                                              salida (negativa)
--
--   Las salidas se acumulan como valores negativos (TraCan * -1)
--   La fecha se agrupa por familia de fecha (FecFam) de SegFec,
--   que convierte el formato AAAAMMDD en un agrupador de periodo.
--
--   Precedencia de operadores OR/AND:
--     AND tiene mayor precedencia que OR, por lo que la logica
--     equivale a:
--       TmoOri = 1 OR (TmoOri = 3 AND TmoCdt = '  ')
--       TmoOri = 2 OR (TmoOri = 3 AND TmoCdt <> '  ')
--     En la version documentada se agregan parentesis explici-
--     tos para hacer esa precedencia visible y sin ambiguedad.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   DisCve   Clave de la Distrito           (InvTrad)
--   AlmCve   Clave del almacen              (InvTrad)
--   ArtCve   Clave del articulo             (InvTrad)
--   FecFam   Familia / agrupador de fecha   (SegFec)
--   Entradas Suma de entradas en TraCan     (calculado)
--   Salidas  Suma de salidas en TraCan *-1  (calculado)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   InvTrad  T1  Transacciones de inventario
--   InvTmo   T2  Tipos de movimiento (TmoOri, TmoCdt)
--   SegFec   T9  Tabla de fechas (FecAno, FecMes, FecDia,
--                FecFam)
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Sustituir IFNULL por COALESCE: COALESCE es estandar SQL
--      y portable; IFNULL es una extension de algunos motores.
--   2. Agregar parentesis explici​tos en las condiciones CASE
--      para documentar la precedencia OR/AND y evitar errores
--      futuros al mantener el codigo.
--   3. Si el volumen de InvTrad es alto, verificar que exista
--      un indice compuesto en (DisCve, AlmCve, ArtCve, TmoCve)
--      y que SegFec tenga indice en (FecAno, FecMes, FecDia).
--   4. Considerar agregar las columnas FecAno y FecMes al
--      GROUP BY si los consumidores necesitan drill-down por
--      mes sin depender del valor de FecFam.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-01  L. Miranda  Documentacion y mejoras de formato
-- ==============================================================

CREATE OR REPLACE VIEW VWINV_Transacciones_Entradas_Salidas AS
SELECT
    T1.DisCve,
    T1.AlmCve,
    T1.ArtCve,
    T9.FecFam,

    -- Entradas: TmoOri=1 o TmoOri=3 con TmoCdt en blanco
    COALESCE(
        SUM(
            CASE
                WHEN T2.TmoOri = 1
                  OR (T2.TmoOri = 3 AND T2.TmoCdt = '  ')
                THEN T1.TraCan
                ELSE 0
            END
        ), 0
    ) AS Entradas,

    -- Salidas: TmoOri=2 o TmoOri=3 con TmoCdt no en blanco
    COALESCE(
        SUM(
            CASE
                WHEN T2.TmoOri = 2
                  OR (T2.TmoOri = 3 AND T2.TmoCdt <> '  ')
                THEN T1.TraCan * -1
                ELSE 0
            END
        ), 0
    ) AS Salidas

FROM InvTrad T1

-- Tipo de movimiento: determina si es entrada o salida
JOIN InvTmo T2
    ON  T1.TmoCve = T2.TmoCve

-- Tabla de fechas: convierte AAAAMMDD a familia de fecha
JOIN SegFec T9
    ON  T1.TraAtr = T9.FecAno
    AND T1.TraMtr = T9.FecMes
    AND T1.TraDtr = T9.FecDia

GROUP BY
    T1.DisCve,
    T1.AlmCve,
    T1.ArtCve,
    T9.FecFam;
