--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);

-- ==============================================================
-- Modulo    : Control de Inventarios
-- Programa  : sqlivf002
-- Objeto    : SEGLIB.IV_ULTIMO_PERIODO_CERRADO
-- Tipo      : Funcion SQL (Table Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3.0
-- Proyecto  : Inventarios / Periodos
-- --------------------------------------------------------------
-- Proposito:
--   Retorna una fila con el periodo contable cerrado mas
--   reciente (ANO_UPC / MES_UPC), junto con las fechas de
--   inicio y fin de dicho periodo y del periodo siguiente.
--   La fuente es InvPar filtrada por ParCve = '@'.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   ANO_UPC           INTEGER  Ano del periodo cerrado
--   MES_UPC           INTEGER  Numero de mes del periodo cerrado
--   FECHA_INI_CERRADO DATE     Primer dia del periodo cerrado
--   FECHA_FIN_CERRADO DATE     Ultimo dia del periodo cerrado
--   FECHA_INI_SIG     DATE     Primer dia del periodo siguiente
--   FECHA_FIN_SIG     DATE     Ultimo dia del periodo siguiente
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   InvPar   -- parametros de inventario (ParCve = '@')
--   SegFec   -- calendario (FecAno, FecMes, FecDia, FecIso)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   La fecha base es el dia 1 del mes del periodo cerrado.
--   Se hace LEFT JOIN a SegFec buscando ese dia 1 exacto.
--   Si no existe en el calendario se usa DATE('2039-12-31')
--   como valor centinela en lugar de abortar con error.
--   La CTE PeriodoCerrado calcula FechaBase una sola vez;
--   las cuatro fechas de salida se derivan de esa base con
--   LAST_DAY y ADD_MONTHS, igual que en la version anterior.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Agregar READS SQL DATA para que el optimizador elija
--      el mejor plan de acceso a InvPar y SegFec.
--   2. Declarar NOT DETERMINISTIC porque el resultado depende
--      del estado actual de InvPar.
--   3. Agregar SPECIFIC IV_ULTIMO_PERIODO_CERRADO para
--      facilitar DROP/mantenimiento por nombre especifico.
--   4. Documentar en InvPar que ParCve = '@' es la clave del
--      ultimo periodo cerrado (comportamiento: si no existe
--      la funcion retorna cero filas sin error).
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-01  L. Miranda  Documentacion y mejoras de formato
--                           Se sustituye TIMESTAMP_FORMAT de
--                           string por LEFT JOIN a SegFec;
--                           valor por defecto 2039-12-31 si
--                           la fecha no existe en calendario.
--                           Se agregan READS SQL DATA y
--                           NOT DETERMINISTIC.
-- ==============================================================

CREATE OR REPLACE FUNCTION SEGLIB.IV_ULTIMO_PERIODO_CERRADO ()
RETURNS TABLE (
    ANO_UPC            INTEGER,
    MES_UPC            INTEGER,
    FECHA_INI_CERRADO  DATE,
    FECHA_FIN_CERRADO  DATE,
    FECHA_INI_SIG      DATE,
    FECHA_FIN_SIG      DATE
)
LANGUAGE SQL
READS SQL DATA
NOT DETERMINISTIC
BEGIN

    RETURN
        -- InvPar: parametros de inventario (ultimo periodo
        --         cerrado, clave ParCve = '@')
        -- SegFec T9: calendario para el dia 1 del periodo
        --            (FecAno = AnoUpc, FecMes = NumUpc, FecDia = 1)
        -- LEFT JOIN: si el dia 1 no esta en SegFec se aplica
        --            DATE('2039-12-31') como valor centinela.
        -- CTE PeriodoCerrado: calcula FechaBase una sola vez
        --   para no repetir la resolucion en cada columna.
        WITH PeriodoCerrado AS (
            SELECT
                IP.AnoUpc,
                IP.NUMUPC,
                COALESCE(T9.FecIso, DATE('2039-12-31'))
                    AS FechaBase
            FROM InvPar AS IP

            -- LEFT JOIN al calendario por el dia 1 del mes
            LEFT JOIN SegFec AS T9
                ON  T9.FecAno = IP.AnoUpc
                AND T9.FecMes = IP.NUMUPC
                AND T9.FecDia = 1

            WHERE IP.ParCve = '@'
        )
        -- SELECT final: proyecta las seis columnas de retorno
        -- usando FechaBase calculada en la CTE.
        SELECT
            AnoUpc                              AS ANO_UPC,
            NUMUPC                              AS MES_UPC,
            -- Primer dia del periodo cerrado
            FechaBase                           AS FECHA_INI_CERRADO,
            -- Ultimo dia del periodo cerrado
            LAST_DAY(FechaBase)                 AS FECHA_FIN_CERRADO,
            -- Primer dia del periodo siguiente
            ADD_MONTHS(FechaBase, 1)            AS FECHA_INI_SIG,
            -- Ultimo dia del periodo siguiente
            LAST_DAY(ADD_MONTHS(FechaBase, 1))  AS FECHA_FIN_SIG
        FROM PeriodoCerrado;

END;

GRANT EXECUTE ON FUNCTION SEGLIB.IV_ULTIMO_PERIODO_CERRADO TO PUBLIC;
