--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- Para Sustituir el Programa SG7006

CREATE OR REPLACE FUNCTION SEGLIB.SG_TIEMPO_MESES (
  FechaDes DATE,
  FechaHas DATE
)
RETURNS INTEGER
LANGUAGE SQL
DETERMINISTIC
NO EXTERNAL ACTION
BEGIN
  DECLARE vAnos INTEGER;
  DECLARE vMeses INTEGER;
  DECLARE FechaBase DATE;

  -- calcular años completos
  SET vAnos = YEAR(FechaHas) - YEAR(FechaDes);
  IF (MONTH(FechaHas) < MONTH(FechaDes))
     OR (MONTH(FechaHas) = MONTH(FechaDes)
     AND DAY(FechaHas) < DAY(FechaDes)) THEN
    SET vAnos = vAnos - 1;
  END IF;

  -- fecha base tras quitar años
  SET FechaBase = ADD_MONTHS(FechaDes, vAnos * 12);

  -- meses restantes
  SET vMeses = (YEAR(FechaHas) * 12 + MONTH(FechaHas))
               - (YEAR(FechaBase) * 12 + MONTH(FechaBase));

  IF DAY(FechaHas) < DAY(FechaBase) THEN
    SET vMeses = vMeses - 1;
  END IF;

  RETURN vMeses;
END;



    GRANT EXECUTE ON FUNCTION SEGLIB.SG_TIEMPO_MESES TO PUBLIC;
