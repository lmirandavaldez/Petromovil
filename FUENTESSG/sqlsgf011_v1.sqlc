CREATE OR REPLACE FUNCTION SEGLIB.SG_VALIDAR_IDENTIFICACION (
    TEXTO VARCHAR(200),
    LONGITUD_ESPERADA INT
)
RETURNS VARCHAR(250)
LANGUAGE SQL
DETERMINISTIC
BEGIN ATOMIC
    DECLARE NUM VARCHAR(200);
    DECLARE LEN INT;
    DECLARE I INT DEFAULT 1;
    DECLARE SUMA INT DEFAULT 0;
    DECLARE DIG INT;
    DECLARE PESO INT;
    DECLARE TEMP INT;
    DECLARE RESTA INT;
    DECLARE DIGVER INT;
    DECLARE VAL SMALLINT DEFAULT 1;

    -- Limpiar todo excepto dígitos
    SET NUM = REGEXP_REPLACE(TEXTO, '[^0-9]', '');
    SET LEN = LENGTH(NUM);

    -- Si la longitud no coincide con la esperada → inválido
    IF LEN <> LONGITUD_ESPERADA THEN
        RETURN NUM CONCAT ' ' CONCAT 1;
    END IF;

    --------------------------------------------------------------------
    -- Validación de CÉDULA (11 dígitos)
    --------------------------------------------------------------------
    IF LONGITUD_ESPERADA = 11 THEN
        SET SUMA = 0;
        SET I = 1;

        WHILE I <= 11 DO
            SET DIG = SUBSTR(NUM, I, 1);

            SET PESO = CASE WHEN MOD(I,2)=1 THEN 1 ELSE 2 END;

            SET TEMP = DIG * PESO;

            IF TEMP >= 10 THEN
                SET TEMP = (TEMP / 10) + MOD(TEMP,10);
            END IF;

            SET SUMA = SUMA + TEMP;

            SET I = I + 1;
        END WHILE;

        IF MOD(SUMA,10)=0 THEN
            SET VAL = 0;
        END IF;

        RETURN NUM CONCAT ' ' CONCAT VAL;
    END IF;

    --------------------------------------------------------------------
    -- Validación de RNC (9 dígitos)
    --------------------------------------------------------------------
    IF LONGITUD_ESPERADA = 9 THEN
        SET SUMA = 0;
        SET I = 1;

        WHILE I <= 8 DO
            SET DIG = SUBSTR(NUM, I, 1);

            SET PESO = CASE I
                WHEN 1 THEN 7
                WHEN 2 THEN 9
                WHEN 3 THEN 8
                WHEN 4 THEN 6
                WHEN 5 THEN 5
                WHEN 6 THEN 4
                WHEN 7 THEN 3
                WHEN 8 THEN 2
            END;

            SET SUMA = SUMA + (DIG * PESO);

            SET I = I + 1;
        END WHILE;

        -- Aplicar reglas DGII EXACTAS
        SET RESTA = MOD(SUMA, 11);

        SET DIGVER =
            CASE
                WHEN RESTA = 0 THEN 2
                WHEN RESTA = 1 THEN 1
                ELSE 11 - RESTA
            END;

        IF DIGVER = SUBSTR(NUM, 9, 1) THEN
            SET VAL = 0;
        END IF;

        RETURN NUM CONCAT ' ' CONCAT VAL;
    END IF;

    --------------------------------------------------------------------
    -- Si la longitud es válida pero no es 9 ni 11 → inválido
    --------------------------------------------------------------------
    RETURN NUM CONCAT ' ' CONCAT 1;
END;


GRANT EXECUTE ON FUNCTION SEGLIB.SG_VALIDAR_IDENTIFICACION TO PUBLIC;