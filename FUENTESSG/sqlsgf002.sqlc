--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : Seguridad
-- Programa  : SQLSGF002
-- Objeto    : SEGLIB.SG_TIEMPO_ANOS
-- Tipo      : Funcion escalar SQL (Scalar Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Devuelve el numero de anos completos cumplidos entre dos
--   fechas. Sustituye al programa SG7006 (componente anos).
-- --------------------------------------------------------------
-- Parametros de entrada:
--   FechaDes DATE  Fecha de inicio (desde).
--   FechaHas DATE  Fecha de fin (hasta).
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   INTEGER  Anos completos (>= 0).
--   NULL     si alguno de los parametros es NULL
--            (RETURNS NULL ON NULL INPUT).
--   0        si FechaHas < FechaDes.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   (ninguna - funcion de logica pura)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Calculo puro de anos entre fechas. No usa SegFec.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Para diferencia completa (anos+meses+dias) usar la
--      funcion de tabla SEGLIB.SG_TIEMPO_EXACTO.

Create Or Replace Function SEGLIB.SG_TIEMPO_ANOS (
    FechaDes Date,
    FechaHas Date
)
Returns Integer
Language Sql
Specific SG_TIEMPO_ANOS
Deterministic
No External Action
Returns Null On Null Input
Begin
    Declare vAnos Integer;

    -- Validacion: si las fechas estan invertidas devolver 0
    If FechaDes > FechaHas Then
        Return 0;
    End If;

    -- Anos completos (ajuste si no ha cumplido el aniversario)
    Set vAnos = Year(FechaHas) - Year(FechaDes);
    If (Month(FechaHas) < Month(FechaDes))
       Or (Month(FechaHas) = Month(FechaDes) And
           Day(FechaHas)   < Day(FechaDes)) Then
        Set vAnos = vAnos - 1;
    End If;

    Return vAnos;
End;

Grant Execute On Function SEGLIB.SG_TIEMPO_ANOS To Public;
