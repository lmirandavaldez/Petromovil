--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : Seguridad
-- Programa  : SQLSGF003
-- Objeto    : SEGLIB.SG_TIEMPO_MESES
-- Tipo      : Funcion de tabla SQL (Table Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 4
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion original preservada dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en RETURNS TABLE del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Calculo puro de fechas. No usa SegFec.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver comentarios internos del SQL.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, formato 80 cols
-- ==============================================================
Create Or Replace Function SEGLIB.SG_TIEMPO_MESES (
    FechaDes Date,
    FechaHas Date
)
Returns Table (
    Meses Integer
)
Language Sql
Specific SG_TIEMPO_MESES
Deterministic
No External Action
Returns Null On Null Input
Begin
    Declare vAnos    Integer Default 0;
    Declare vMeses   Integer Default 0;
    Declare FechaBase Date;

    -- Proteccion: si la fecha final es anterior a la inicial
    -- se devuelve 0 en lugar de un valor negativo silencioso.
    If FechaHas < FechaDes Then
        Pipe (0);
        Return;
    End If;

    -- Calcular anos completos entre las dos fechas
    Set vAnos = Year(FechaHas) - Year(FechaDes);
    If (Month(FechaHas) < Month(FechaDes))
       Or (Month(FechaHas) = Month(FechaDes)
       And Day(FechaHas) < Day(FechaDes)) Then
        Set vAnos = vAnos - 1;
    End If;

    -- Fecha base: avanzar FechaDes tantos meses como anos completos
    Set FechaBase = Add_Months(FechaDes, vAnos * 12);

    -- Meses restantes entre FechaBase y FechaHas
    Set vMeses = (Year(FechaHas) * 12 + Month(FechaHas))
               - (Year(FechaBase) * 12 + Month(FechaBase));

    -- Ajuste: si todavia no ha pasado el dia del mes
    If Day(FechaHas) < Day(FechaBase) Then
        Set vMeses = vMeses - 1;
    End If;

    Pipe (vMeses);
    Return;
End;

Grant Execute On Function SEGLIB.SG_TIEMPO_MESES To Public;
