--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ==============================================================
-- Modulo    : Seguridad
-- Programa  : SQLSGF001
-- Objeto    : SEGLIB.SG_TIEMPO_EXACTO
-- Tipo      : Funcion de tabla SQL (Table Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 4
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Devuelve la diferencia exacta entre dos fechas desglosada
--   en anos, meses y dias completos. Sustituye al programa
--   SG7006.
-- --------------------------------------------------------------
-- Parametros de entrada:
--   FechaDes   DATE      Fecha de inicio (desde).
--   FechaHas   DATE      Fecha de fin (hasta).
--   IncluirDia SMALLINT  1=incluir dia final (SG7006), 0=excluir
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Anos  INTEGER  Anos completos cumplidos.
--   Meses INTEGER  Meses fraccionarios (0-11).
--   Dias  INTEGER  Dias fraccionarios (0-30).
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   (ninguna - funcion de logica pura)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Calculo puro de duracion entre fechas. No usa SegFec.
--   Usa ADD_MONTHS para evitar fechas invalidas (ej. 29-feb).
--   Cualquier parametro NULL: RETURNS NULL ON NULL INPUT.
--   FechaHas < FechaDes: devuelve (0, 0, 0).
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Si se requiere solo la diferencia en anos, usar la
--      funcion escalar SEGLIB.SG_TIEMPO_ANOS que es mas
--      eficiente al no calcular meses y dias.
--   2. PIPE es sintaxis DB2 for i para retornar filas en una
--      funcion de tabla; no es estandar ANSI SQL.
-- Uso:
--   SELECT * FROM TABLE(SG_TIEMPO_EXACTO(
--       DATE('1964-07-23'),
--       DATE('2026-07-23'),
--       0
--   )) AS x;
-- ============================================================

CREATE OR REPLACE FUNCTION SEGLIB.SG_TIEMPO_EXACTO (
    FechaDes   DATE,
    FechaHas   DATE,
    IncluirDia SMALLINT DEFAULT 1
    -- 1 = incluir día final (convención SG7006), 0 = excluir
)
RETURNS TABLE (
    Anos  INTEGER,
    Meses INTEGER,
    Dias  INTEGER
)
LANGUAGE SQL
SPECIFIC SG_TIEMPO_EXACTO
DETERMINISTIC
NO EXTERNAL ACTION
BEGIN
    DECLARE vAnos      INTEGER;
    DECLARE vMeses     INTEGER;
    DECLARE vDias      INTEGER;
    DECLARE FechaBase  DATE;
    DECLARE FechaBase2 DATE;

    -- Validación: si las fechas están invertidas devolver ceros
    IF FechaDes > FechaHas THEN
        PIPE (0, 0, 0);
        RETURN;
    END IF;

    -- Años completos (ajuste si no ha cumplido el aniversario)
    SET vAnos = YEAR(FechaHas) - YEAR(FechaDes);
    IF (MONTH(FechaHas) < MONTH(FechaDes))
       OR (MONTH(FechaHas) = MONTH(FechaDes) AND
           DAY(FechaHas)   < DAY(FechaDes)) THEN
        SET vAnos = vAnos - 1;
    END IF;

    -- Fecha base tras restar los años completos
    -- (ADD_MONTHS evita fechas inválidas, ej. 29-feb)
    SET FechaBase = ADD_MONTHS(FechaDes, vAnos * 12);

    -- Meses restantes entre FechaBase y FechaHas
    SET vMeses = (YEAR(FechaHas)  * 12 + MONTH(FechaHas))
               - (YEAR(FechaBase) * 12 + MONTH(FechaBase));

    IF DAY(FechaHas) < DAY(FechaBase) THEN
        SET vMeses = vMeses - 1;
    END IF;

    -- Fecha base tras restar también los meses
    -- (ADD_MONTHS garantiza fecha válida)
    SET FechaBase2 = ADD_MONTHS(FechaBase, vMeses);

    -- Días restantes
    SET vDias = FechaHas - FechaBase2;

    IF IncluirDia = 1 THEN
        SET vDias = vDias + 1;   -- convención inclusiva (como SG7006)
    END IF;

    -- Seguridad: no devolver negativos
    IF vDias < 0 THEN
        SET vDias = 0;
    END IF;

    PIPE (vAnos, vMeses, vDias);
    RETURN;
END;

GRANT EXECUTE ON FUNCTION SEGLIB.SG_TIEMPO_EXACTO TO PUBLIC;