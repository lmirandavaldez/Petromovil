-- ==============================================================
-- Modulo    : Seguridad
-- Programa  : SQLSG001
-- Objeto    : VWSEG_Tipo_Comprobantes_Validos
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Devuelve los tipos de comprobante fiscales (NCF) vigentes
--   junto con su codigo normalizado (serie + numero 2 digitos).
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   SERIE_RELACIONADA   Serie del comprobante (A, B, E, etc.)
--   TIPO_DE_COMPROBANTE Codigo numerico del tipo de comprobante
--   NcfTipValido        Codigo normalizado (ej: A01, B11, E03)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   SegNcf    Tipos de comprobante fiscal (tabla base)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   No aplica. Esta vista no maneja campos de fecha.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. Para series A, B y E: NcfTipValido = NcfSer + NcfTip con
--      relleno a 2 digitos. Para otras series = solo NcfSer.
--   2. El GROUP BY elimina duplicados si SegNcf tiene filas
--      repetidas por (NcfSer, NcfTip).
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, sin acentos,
--                           formato 80 cols
-- ==============================================================

Create Or Replace View VWSEG_Tipo_Comprobantes_Validos As

Select
    -- Serie del comprobante fiscal (A, B, E, etc.)
    NcfSer                                      As SERIE_RELACIONADA,

    -- Codigo numerico del tipo de comprobante
    NcfTip                                      As TIPO_DE_COMPROBANTE,

    -- Codigo normalizado: para series A, B y E se forma como
    -- SERIE + numero de tipo con relleno a 2 digitos (ej. A01, E11).
    -- Para cualquier otra serie se devuelve solo la serie.
    Case
        When NcfSer In ('A', 'B', 'E')
            Then NcfSer Concat Right('00' Concat Trim(Char(NcfTip)), 2)
        Else NcfSer
    End                                         As NcfTipValido

From SegNcf

Group By
    NcfSer,
    NcfTip
