-- Tipo      : Funcion de tabla SQL (Table Function)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 3
-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Proposito:
--   Ver descripcion original preservada dentro del SQL.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Ver definicion en RETURNS TABLE del SQL.
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   Ver comentarios en el SQL.
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   Calculo puro de fechas. No usa SegFec.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   Ver comentarios internos del SQL.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  -----------------------------------
--   2026-08-03  L. Miranda  Encabezado estandar, formato 80 cols
-- ==============================================================
CREATE OR REPLACE FUNCTION SEGLIB.SG_DIA_SEMANA (
    -- Fecha para la cual se desea conocer el dia de la semana
    Fecha DATE
)
RETURNS TABLE (
    DIA_NUM  INTEGER,       -- Numero de dia: 1=Domingo, 2=Lunes … 7=Sabado
    DIA_NOM  VARCHAR(10)    -- Nombre del dia en espanol
)
SPECIFIC          SEGLIB.SG_DIA_SEMANA
LANGUAGE          SQL
DETERMINISTIC             -- El mismo input siempre produce el mismo output
NO EXTERNAL ACTION        -- No tiene efectos secundarios externos
CALLED ON NULL INPUT      -- Si Fecha es NULL la funcion 
                          --es llamada igual (devuelve NULL)
BEGIN
    RETURN
        SELECT
            -- Numero de dia segun la convencion ISO de DB2/IBM i (1=Domingo)
            DAYOFWEEK(Fecha)                AS DIA_NUM,

            -- Nombre del dia en espanol con tildes correctas
            CASE DAYOFWEEK(Fecha)
                WHEN 1 THEN 'Domingo'
                WHEN 2 THEN 'Lunes'
                WHEN 3 THEN 'Martes'
                WHEN 4 THEN 'Miércoles'
                WHEN 5 THEN 'Jueves'
                WHEN 6 THEN 'Viernes'
                WHEN 7 THEN 'Sábado'
                ELSE        NULL    -- Nunca ocurre; cubre el CASE formalmente
            END                             AS DIA_NOM

        FROM SYSIBM.SYSDUMMY1;
END;

-- Conceder permisos de ejecucion a todos los usuarios
GRANT EXECUTE ON SPECIFIC FUNCTION SEGLIB.SG_DIA_SEMANA TO PUBLIC;
