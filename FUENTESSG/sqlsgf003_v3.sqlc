--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ============================================================
-- Función  : SEGLIB.SG_TIEMPO_MESES
-- Propósito: Calcula los meses restantes (fracción de año) entre
--            dos fechas, después de descontar los años completos.
-- Versión  : 2.0 (función de tabla)
-- Parámetros:
--   FechaDes  DATE  Fecha de inicio (desde).
--   FechaHas  DATE  Fecha de fin    (hasta).
-- Retorna tabla con columna:
--   MESES  INTEGER  Meses fraccionarios cumplidos (0-11).
--                   NULL  si alguno de los parámetros es NULL.
--                   0     si FechaHas < FechaDes.
-- Uso:
--   SELECT * FROM TABLE(SEGLIB.SG_TIEMPO_MESES(
--       DATE('1964-07-23'),
--       DATE('2026-07-23')
--   )) AS x;
-- ============================================================

CREATE OR REPLACE FUNCTION SEGLIB.SG_TIEMPO_MESES (
  FechaDes DATE,
  FechaHas DATE
)
RETURNS TABLE (
  MESES INTEGER
)
LANGUAGE SQL
DETERMINISTIC
NO EXTERNAL ACTION
RETURNS NULL ON NULL INPUT   -- Si cualquier parámetro es NULL, retorna tabla vacía
BEGIN
  DECLARE vAnos    INTEGER DEFAULT 0;
  DECLARE vMeses   INTEGER DEFAULT 0;
  DECLARE FechaBase DATE;

  -- Protección: si la fecha final es anterior a la inicial
  -- se devuelve 0 en lugar de un valor negativo silencioso.
  IF FechaHas < FechaDes THEN
    PIPE (0);
    RETURN;
  END IF;

  -- Calcular años completos entre las dos fechas
  SET vAnos = YEAR(FechaHas) - YEAR(FechaDes);
  IF (MONTH(FechaHas) < MONTH(FechaDes))
     OR (MONTH(FechaHas) = MONTH(FechaDes)
     AND DAY(FechaHas) < DAY(FechaDes)) THEN
    SET vAnos = vAnos - 1;
  END IF;

  -- Fecha base: avanzar FechaDes tantos meses como años completos
  SET FechaBase = ADD_MONTHS(FechaDes, vAnos * 12);

  -- Meses restantes entre FechaBase y FechaHas
  SET vMeses = (YEAR(FechaHas) * 12 + MONTH(FechaHas))
             - (YEAR(FechaBase) * 12 + MONTH(FechaBase));

  -- Ajuste: si todavía no ha pasado el día del mes
  IF DAY(FechaHas) < DAY(FechaBase) THEN
    SET vMeses = vMeses - 1;
  END IF;

  PIPE (vMeses);
  RETURN;
END;


GRANT EXECUTE ON FUNCTION SEGLIB.SG_TIEMPO_MESES TO PUBLIC;
