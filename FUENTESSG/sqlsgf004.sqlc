--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ============================================================
-- Función  : SEGLIB.SG_TIEMPO_DIAS
-- Módulo   : Seguridad (Comunes)
-- Propósito: Calcula los días restantes (fracción de mes) entre
--            dos fechas, después de descontar años y meses
--            completos.  Sustituye al programa SG7006
--            (componente días).
-- Parámetros:
--   FechaDes   DATE      Fecha de inicio (desde).
--   FechaHas   DATE      Fecha de fin    (hasta).
--   IncluirDia SMALLINT  1 = incluir el día final en el conteo.
--                        0 = excluir el día final.
-- Retorna tabla con columna:
--   DIAS  INTEGER  Días fraccionarios cumplidos (0-30).
--                  Tabla vacía si algún parámetro es NULL
--                    (RETURNS NULL ON NULL INPUT).
--                  0 si FechaHas < FechaDes.
-- Tablas   : (ninguna — función escalar pura)
-- Autor    : L. Miranda
-- Copyright: Miranda Valdez, S. A., 1997
-- Versión  : 3  (normalización mixed-case + revisión cabecera)
-- Cambios  :
--   v1 - Versión original (cálculo básico).
--   v2 - Función UDTF; ADD_MONTHS para fechas inválidas;
--        protección FechaHas < FechaDes; RETURNS NULL ON NULL INPUT;
--        convención inclusiva con IncluirDia.
--   v3 - Normalización de casing a mixed-case.
--        Agregado Specific SG_TIEMPO_DIAS.
--        Sin cambios lógicos.
-- Uso:
--   Select * From Table(SEGLIB.SG_TIEMPO_DIAS(
--       Date('1964-07-23'),
--       Current Date,
--       0
--   )) As x;
-- ============================================================

Create Or Replace Function SEGLIB.SG_TIEMPO_DIAS (
    FechaDes   Date,
    FechaHas   Date,
    IncluirDia SmallInt  -- 1 = incluir día final, 0 = excluir
)
Returns Table (
    Dias Integer
)
Language Sql
Specific SG_TIEMPO_DIAS
Deterministic
No External Action
Returns Null On Null Input
Begin
    Declare vAnos      Integer Default 0;
    Declare vMeses     Integer Default 0;
    Declare vDias      Integer Default 0;
    Declare FechaBase  Date;
    Declare FechaBase2 Date;

    -- Protección: si la fecha final es anterior a la inicial
    -- se devuelve 0 en lugar de propagar un resultado incorrecto.
    If FechaHas < FechaDes Then
        Pipe (0);
        Return;
    End If;

    -- Calcular años completos entre las dos fechas
    Set vAnos = Year(FechaHas) - Year(FechaDes);
    If (Month(FechaHas) < Month(FechaDes))
       Or (Month(FechaHas) = Month(FechaDes)
       And Day(FechaHas) < Day(FechaDes)) Then
        Set vAnos = vAnos - 1;
    End If;

    -- Fecha base: avanzar FechaDes tantos meses como años completos
    Set FechaBase = Add_Months(FechaDes, vAnos * 12);

    -- Meses restantes entre FechaBase y FechaHas
    Set vMeses = (Year(FechaHas) * 12 + Month(FechaHas))
               - (Year(FechaBase) * 12 + Month(FechaBase));
    If Day(FechaHas) < Day(FechaBase) Then
        Set vMeses = vMeses - 1;
    End If;

    -- Fecha base 2: avanzar FechaBase los meses restantes
    Set FechaBase2 = Add_Months(FechaBase, vMeses);

    -- Días fraccionarios entre FechaBase2 y FechaHas
    Set vDias = FechaHas - FechaBase2;

    -- Convención inclusiva: sumar 1 si se pide incluir el día final
    If IncluirDia = 1 Then
        Set vDias = vDias + 1;
    End If;

    -- Seguridad: nunca retornar un valor negativo
    If vDias < 0 Then
        Set vDias = 0;
    End If;

    Pipe (vDias);
    Return;
End;

Grant Execute On Function SEGLIB.SG_TIEMPO_DIAS To Public;
