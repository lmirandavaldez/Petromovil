--CL: CHGLIBL LIBL(QTEMP Itelib DATOS02);
-- ============================================================
-- Función  : SEGLIB.SG_TIEMPO_ANOS
-- Módulo   : Seguridad (Comunes)
-- Propósito: Devuelve el número de años completos cumplidos
--            entre dos fechas.
--            Sustituye al programa SG7006 (componente años).
-- Parámetros:
--   FechaDes DATE  Fecha de inicio (desde).
--   FechaHas DATE  Fecha de fin    (hasta).
-- Retorna:
--   INTEGER  Años completos (≥ 0).
--            Cualquier parámetro NULL → NULL
--              (RETURNS NULL ON NULL INPUT).
--            FechaHas < FechaDes → 0.
-- Tablas   : (ninguna — función escalar pura)
-- Autor    : L. Miranda
-- Copyright: Miranda Valdez, S. A., 1997
-- Versión  : 2  (cabecera completa + CALLED ON NULL INPUT)
-- Cambios  :
--   v1 - Versión original (cálculo básico).
--   v2 - Cabecera de documentación completa.
--        Agregado RETURNS NULL ON NULL INPUT.
--        Normalización de casing a mixed-case.
-- Uso:
--   Values SEGLIB.SG_TIEMPO_ANOS(DATE('1990-03-15'), CURRENT DATE);
-- ============================================================

Create Or Replace Function SEGLIB.SG_TIEMPO_ANOS (
    FechaDes Date,
    FechaHas Date
)
Returns Integer
Language Sql
Specific SG_TIEMPO_ANOS
Deterministic
No External Action
Returns Null On Null Input
Begin
    Declare vAnos Integer;

    -- Validación: si las fechas están invertidas devolver 0
    If FechaDes > FechaHas Then
        Return 0;
    End If;

    -- Años completos (ajuste si no ha cumplido el aniversario)
    Set vAnos = Year(FechaHas) - Year(FechaDes);
    If (Month(FechaHas) < Month(FechaDes))
       Or (Month(FechaHas) = Month(FechaDes) And
           Day(FechaHas)   < Day(FechaDes)) Then
        Set vAnos = vAnos - 1;
    End If;

    Return vAnos;
End;

Grant Execute On Function SEGLIB.SG_TIEMPO_ANOS To Public;
