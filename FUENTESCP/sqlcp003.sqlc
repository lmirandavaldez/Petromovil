-- ==============================================================
-- Modulo    : Cuentas por Pagar
-- Programa  : SQLCP003
-- Objeto    : VWCXP_Documentos_Al_Cierre
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2`n-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Descripcion:
--   Vista de documentos de cuentas por pagar al momento del
--   cierre de periodo. Consolida el historico de documentos
--   (CxpHDpeh) con el proveedor (CxpPro), el tipo de
--   movimiento (CxpMov), la moneda (SegMon) y el documento
--   activo correspondiente (CxpDpeh) para obtener campos
--   descriptivos como NcfNro, DpeDr1, DpeDr2 y DpeCon que
--   no se almacenan en el historico.
--
--   Se exponen dos fechas resueltas via LEFT OUTER JOIN a
--   SegFec, ambas por campo numerico FecYMd (YYYYMMDD):
--     Fecha_Documento   : fecha del documento al cierre
--                         (DpeFec de CxpHDpeh)
--     Fecha_Transaccion : fecha de registro de la transaccion
--                         (DpeFtr de CxpHDpeh)
--
--   Si alguna fecha no existe en SegFec, COALESCE devuelve
--   el tope del sistema: DATE('2039-12-31').
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Peanci            Ano del periodo de cierre  (CxpHDpeh/T1)
--   PeNuci            Numero del periodo cierre  (CxpHDpeh/T1)
--   ProCve            Clave del proveedor        (CxpHDpeh/T1)
--   ProNom            Nombre del proveedor       (CxpPro/T2)
--   MovSig            Signo del movimiento       (CxpMov/T3)
--   DpeDoc            Numero de documento        (CxpHDpeh/T1)
--   DpeRef            Referencia del documento   (CxpHDpeh/T1)
--   NcfNro            Numero de comprobante NCF  (CxpDpeh/T5)
--   Fecha_Documento   Fecha ISO del documento    (SegFec/T9)
--   Fecha_Transaccion Fecha ISO de transaccion   (SegFec/T10)
--   PerAno            Ano del periodo origen     (CxpHDpeh/T1)
--   PerNum            Numero del periodo origen  (CxpHDpeh/T1)
--   MonCve            Clave de moneda            (CxpHDpeh/T1)
--   MonSim            Simbolo de moneda          (SegMon/T4)
--   DpeTas            Tasa de cambio             (CxpHDpeh/T1)
--   DpeDr1            Descripcion linea 1        (CxpDpeh/T5)
--   DpeDr2            Descripcion linea 2        (CxpDpeh/T5)
--   DpeCon            Concepto del documento     (CxpDpeh/T5)
--   DpeVal            Valor del documento        (CxpHDpeh/T1)
--   DpeVml            Valor en moneda local      (CxpHDpeh/T1)
--   DpeBce            Balance del documento      (CxpHDpeh/T1)
--   DpeBml            Balance en moneda local    (CxpHDpeh/T1)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   CxpHDpeh T1   Historico de documentos CxP al cierre (base)
--   CxpPro   T2   Proveedores
--   CxpMov   T3   Tipos de movimiento CxP
--   SegMon   T4   Monedas
--   CxpDpeh  T5   Encabezado de documentos CxP (activo)
--   SegFec   T9   Tabla de fechas (Fecha_Documento)
--   SegFec   T10  Tabla de fechas (Fecha_Transaccion)
-- --------------------------------------------------------------
-- Logica de resolucion de fechas:
--   T9  : LEFT OUTER JOIN a SegFec por campo numerico FecYmd
--         (DpeFec = FecYmd YYYYMMDD) -> devuelve FecIso.
--   T10 : LEFT OUTER JOIN a SegFec por campo numerico FecYMd
--         (DpeFtr = FecYMd YYYYMMDD) -> devuelve FecIso.
--   COALESCE devuelve DATE('2039-12-31') si el JOIN es NULL.
--   SegFec cubre el rango 1940-01-01 a 2039-12-31.
-- --------------------------------------------------------------
-- Logica de JOIN CxpDpeh T5:
--   El historico (CxpHDpeh) no almacena campos descriptivos
--   del documento (NcfNro, DpeDr1, DpeDr2, DpeCon). Estos
--   se obtienen del documento activo en CxpDpeh usando la
--   clave compuesta: ProCve + MovCve + DpeDoc + DpeRef.
--   Si el documento activo fue eliminado o no existe, el
--   JOIN (INNER) excluira el registro historico de la vista.
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. El JOIN a CxpDpeh T5 es INNER JOIN: si un documento
--      del historico no tiene correspondencia en el activo
--      (fue eliminado o la clave cambio), el registro queda
--      excluido. Evaluar si debe ser LEFT OUTER JOIN y usar
--      COALESCE para NcfNro, DpeDr1, DpeDr2, DpeCon.
--   2. Los JOINs a CxpPro, CxpMov y SegMon son INNER JOIN;
--      un documento historico sin catalogo asociado quedara
--      excluido. Evaluar segun el requerimiento de reporte.
--   3. Peanci/PeNuci identifican el periodo de cierre y
--      PerAno/PerNum el periodo origen del documento. Si los
--      reportes necesitan filtrar por cierre, usar Peanci y
--      PeNuci en el WHERE de la consulta consumidora.
--   4. DpeVml y DpeBml (valores en moneda local) son propios
--      del historico; su presencia confirma que se aplico
--      conversion de moneda en el proceso de cierre.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  ---------------------------------
--   2026-08-02  L. Miranda  Documentacion, formato 80 cols.
--                           JOINs a SegFec (T9, T10)
--                           convertidos a LEFT OUTER JOIN
--                           con COALESCE DATE('2039-12-31').
-- ==============================================================

CREATE OR REPLACE VIEW VWCXP_Documentos_Al_Cierre AS
SELECT
    -- Periodo de cierre
    T1.Peanci,
    T1.PeNuci,

    -- Identificacion del proveedor
    T1.ProCve,
    T2.ProNom,

    -- Tipo de movimiento
    T3.MovSig,

    -- Identificacion del documento
    T1.DpeDoc,
    T1.DpeRef,
    T5.NcfNro,

    -- Fecha del documento al cierre (DpeFec en formato FecYmd):
    --   1. SegFec T9 (primaria via LEFT OUTER JOIN)
    --   2. DATE('2039-12-31') si la fecha no esta en SegFec
    COALESCE(T9.FecIso,  DATE('2039-12-31')) AS Fecha_Documento,

    -- Fecha de la transaccion (DpeFtr en formato FecYMd):
    --   1. SegFec T10 (primaria via LEFT OUTER JOIN)
    --   2. DATE('2039-12-31') si la fecha no esta en SegFec
    COALESCE(T10.FecIso, DATE('2039-12-31')) AS Fecha_Transaccion,

    -- Periodo origen del documento
    T1.PerAno,
    T1.PerNum,

    -- Moneda
    T1.MonCve,
    T4.MonSim,
    T1.DpeTas,

    -- Datos descriptivos del documento activo (CxpDpeh T5)
    T5.DpeDr1,
    T5.DpeDr2,
    T5.DpeCon,

    -- Valores del historico (moneda original y moneda local)
    T1.DpeVal,
    T1.DpeVml,
    T1.DpeBce,
    T1.DpeBml

FROM CxpHDpeh T1

-- Proveedor
JOIN CxpPro T2
    ON  T1.ProCve = T2.ProCve

-- Tipo de movimiento
JOIN CxpMov T3
    ON  T1.MovCve = T3.MovCve

-- Moneda
JOIN SegMon T4
    ON  T1.MonCve = T4.MonCve

-- Documento activo (para NcfNro, DpeDr1, DpeDr2, DpeCon)
JOIN CxpDpeh T5
    ON  T1.ProCve = T5.ProCve
    AND T1.MovCve = T5.MovCve
    AND T1.DpeDoc = T5.DpeDoc
    AND T1.DpeRef = T5.DpeRef

-- Fecha del documento al cierre (DpeFec = FecYmd YYYYMMDD)
LEFT OUTER JOIN SegFec T9
    ON  T1.DpeFec = T9.FecYmd

-- Fecha de la transaccion (DpeFtr = FecYMd YYYYMMDD)
LEFT OUTER JOIN SegFec T10
    ON  T1.DpeFtr = T10.FecYMd;
