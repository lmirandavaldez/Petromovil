-- ==============================================================
-- Modulo    : Interfaces Modulos Externos
-- Programa  : SQLIT001
-- Objeto    : VWITE_Resumen_Corte_Estaciones
-- Tipo      : Vista SQL (View)
-- Autor     : L. Miranda
-- Copyright : Miranda Valdez, S. A., 1997
-- Version   : 2`n-- Proyecto  : Petromovil
-- --------------------------------------------------------------
-- Descripcion:
--   Vista de resumen de corte de estaciones de servicio para
--   interfaz con modulos externos. Agrupa las transacciones
--   de interfaz (IteTra) por distrito, periodo de corte,
--   cliente, categoria de articulo y codigo de producto,
--   acumulando cantidad total, precio promedio e importe.
--
--   Calcula el campo Veces: numero de veces que el importe
--   acumulado supera el monto minimo de transaccion (ParMti)
--   definido en la tabla de parametros (ItePar, clave '@').
--   La formula usa division entera con redondeo hacia arriba:
--     Veces = INT((Importe + ParMti - 1) / ParMti)
--   Esta es la tecnica clasica de techo (ceiling) sin usar
--   CEILING(), garantizando entero positivo minimo de 1
--   cuando Importe > 0.
--
--   No hay campos de fecha por concatenar; FacFis, FacFfs y
--   FacPam se exponen en su tipo original de la tabla.
--   No aplica logica de resolucion via SegFec.
-- --------------------------------------------------------------
-- Campos retornados (en orden original):
--   Codigo_Del_Distrito  Clave del distrito         (IteTra/T1)
--   Fecha_Inicio_Corte   Fecha inicio del corte     (IteTra/T1)
--   Fecha_Final_Corte    Fecha final del corte      (IteTra/T1)
--   Ano_Mes_Del_Corte    Ano y mes del corte        (IteTra/T1)
--   Codigo_Cliente       RUI del cliente            (IteEst/T2)
--   Categoria            Categoria del articulo     (InvArt/T3)
--   Codigo_Del_Producto  Codigo del producto        (IteTra/T1)
--   Total_Cantidad       Suma de TraCan del grupo   (calc.)
--   Precio_Promedio      Promedio de TraPve         (calc.)
--   Importe              Suma de TraImp del grupo   (calc.)
--   Veces                Techo(Importe / ParMti)    (calc.)
-- --------------------------------------------------------------
-- Tablas referenciadas:
--   IteTra  T1   Transacciones de interfaz (tabla base)
--   IteEst  T2   Estaciones de servicio
--   InvArt  T3   Articulos de inventario
--   ItePar       Parametros de interfaz (subconsulta, clave '@')
-- --------------------------------------------------------------
-- Logica de calculo de Veces:
--   ParMti se obtiene de ItePar WHERE ParCve = '@'.
--   La subconsulta se ejecuta dos veces en la formula:
--     INT((SUM(TraImp) + ParMti - 1) / ParMti)
--   Esta es la division entera con redondeo al techo, que
--   garantiza al menos 1 cuando el importe es positivo.
--   Ejemplo: Importe=250, ParMti=100 -> INT((250+99)/100)
--            = INT(349/100) = INT(3.49) = 3
-- --------------------------------------------------------------
-- Filtros aplicados:
--   T1.TraCtd = 1       Solo transacciones tipo 1 (corte)
--   T2.CliRui <> 0      Excluye estaciones sin cliente RUI
--   T2.EstRui = 'S'     Solo estaciones activas en RUI
-- --------------------------------------------------------------
-- Agrupacion:
--   DisCve, FacFis, FacFfs, FacPam, CliRui, CatCve, FacCar
-- --------------------------------------------------------------
-- Filtro de agrupacion (HAVING):
--   SUM(TraCan) > 0     Solo grupos con cantidad positiva
-- --------------------------------------------------------------
-- Sugerencias de mejora:
--   1. La subconsulta (Select ParMti From ItePar Where
--      ParCve='@') se ejecuta dos veces dentro de la misma
--      expresion de Veces. En DB2 for i, el optimizador
--      puede manejar esto, pero para mayor claridad y
--      eficiencia garantizada, usar CROSS JOIN LATERAL:
--
--        CROSS JOIN LATERAL (
--            SELECT ParMti FROM ItePar WHERE ParCve = '@'
--        ) AS PAR
--
--      y luego en el SELECT:
--        INT((SUM(T1.TraImp) + PAR.ParMti - 1)
--            / PAR.ParMti) AS Veces
--
--   2. FacFis, FacFfs y FacPam se exponen en su tipo raw.
--      Confirmar si son tipo DATE, numerico YYYYMMDD o
--      caracter. Si son numericos, considerar exponer tambien
--      la version ISO via JOIN a SegFec para uso en reportes.
--   3. El JOIN a IteEst T2 usa solo DisCve. Si una estacion
--      puede tener multiples registros activos en IteEst para
--      el mismo DisCve, se produciran duplicados. Confirmar
--      que DisCve es clave primaria en IteEst.
--   4. Precio_Promedio usa AVG(TraPve): confirma que el precio
--      unitario almacenado es correcto para promediar, ya que
--      un promedio simple puede no reflejar el precio ponderado
--      por cantidad. Considerar SUM(TraImp)/SUM(TraCan) para
--      precio promedio ponderado si es mas apropiado.
-- --------------------------------------------------------------
-- Historial de cambios:
--   Fecha       Autor       Descripcion
--   ----------  ----------  ---------------------------------
--   2026-08-02  L. Miranda  Documentacion y formato 80 cols.
-- ==============================================================

CREATE OR REPLACE VIEW VWITE_Resumen_Corte_Estaciones AS
SELECT
    -- Identificacion del corte
    T1.DisCve                               AS Codigo_Del_Distrito,
    T1.FacFis                               AS Fecha_Inicio_Corte,
    T1.FacFfs                               AS Fecha_Final_Corte,
    T1.FacPam                               AS Ano_Mes_Del_Corte,

    -- Cliente de la estacion
    T2.CliRui                               AS Codigo_Cliente,

    -- Categoria y producto
    T3.CatCve                               AS Categoria,
    T1.FacCar                               AS Codigo_Del_Producto,

    -- Acumulados del grupo
    SUM(T1.TraCan)                          AS Total_Cantidad,
    AVG(T1.TraPve)                          AS Precio_Promedio,
    SUM(T1.TraImp)                          AS Importe,

    -- Numero de veces que el importe supera el minimo (ParMti)
    -- Formula techo: INT((Importe + ParMti - 1) / ParMti)
    -- Equivalente a CEILING(Importe / ParMti) en entero
    INT((SUM(T1.TraImp) +
        (SELECT ParMti FROM ItePar WHERE ParCve = '@') - 1) /
        (SELECT ParMti FROM ItePar WHERE ParCve = '@'))
                                            AS Veces

FROM IteTra T1

-- Estacion de servicio (aporta cliente RUI)
JOIN IteEst T2
    ON  T1.DisCve = T2.DisCve

-- Articulo de inventario (aporta categoria)
JOIN InvArt T3
    ON  T1.FacCar = T3.ArtCve

-- Solo transacciones tipo corte con cliente RUI activo
WHERE T1.TraCtd = 1
  AND T2.CliRui <> 0
  AND T2.EstRui  = 'S'

GROUP BY
    T1.DisCve,
    T1.FacFis,
    T1.FacFfs,
    T1.FacPam,
    T2.CliRui,
    T3.CatCve,
    T1.FacCar

-- Solo grupos con cantidad total positiva
HAVING SUM(T1.TraCan) > 0;
